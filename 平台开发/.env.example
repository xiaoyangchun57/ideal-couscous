# Keep the real secret only in the server-side .env file.
WX_APPSECRET=
# developer / trial / formal；生产部署默认 formal。
MINIPROGRAM_STATE=formal

# Station ingestion is disabled unless the explicit `station-ingest` Compose profile is started.
# The host mapping remains loopback-only in docker-compose.yml; do not put a real port, endpoint,
# station address, password, or credential value in this file.
SL651_BIND_PORT=5505
SL651_CREDENTIAL_PEPPER=
