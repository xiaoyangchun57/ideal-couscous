/* components/custom-navbar/custom-navbar.wxss */
.custom-nav {
  background: #ffffff;
  width: 100%;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  position: relative;
}

.nav-left {
  display: flex;
  align-items: center;
  height: 100%;
  padding-left: 32rpx;
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.nav-center {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.nav-right {
  display: flex;
  align-items: center;
  height: 100%;
  flex-shrink: 0;
}

.nav-border {
  height: 1rpx;
  background: rgba(60, 60, 67, 0.12);
}
