<view class="page">
  <view class="intro">
    <text class="intro-title">负责站点</text>
    <text class="intro-copy">以下站点由服务端授权范围提供。进入站点后可查看监测信息与站点资料。</text>
  </view>

  <view wx:if="{{error}}" class="empty"><text class="empty-tx">{{error}}</text><button class="btn-ghost" bindtap="onRetry">重试</button></view>
  <view wx:elif="{{loading}}" class="empty"><text class="empty-tx">加载中…</text></view>
  <view wx:elif="{{sites.length}}" class="site-list">
    <view class="card site-row" wx:for="{{sites}}" wx:key="id" bindtap="openSite" data-id="{{item.id}}">
      <view class="site-main">
        <text class="site-name">{{item.name}}</text>
        <text class="site-meta">{{item.code || '未录入编码'}} · {{item.type_cn || '其他站点'}} · {{item.status_label || '状态未知'}}</text>
      </view>
      <text class="site-action">查看站点 ›</text>
    </view>
  </view>

  <view wx:else class="empty">
    <view class="empty-circle"></view>
    <text class="empty-tx">暂未分配负责站点</text>
  </view>
</view>
