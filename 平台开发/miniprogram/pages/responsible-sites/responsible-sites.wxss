/* ========== 站点 Tab 页面 ========== */
.stab-page {
  min-height: 100vh;
  background: var(--color-background);
  padding-bottom: calc(88rpx + env(safe-area-inset-bottom));
}

/* 导航栏标题 */
.stab-nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

/* 主模式分段：站点 / 试剂 */
.stab-seg {
  padding: 24rpx 32rpx 16rpx;
  position: sticky;
  top: 0;
  z-index: 20;
  background: var(--color-background);
}

.stab-seg-inner {
  display: flex;
  background: var(--color-type-bg);
  border-radius: var(--radius-sm);
  padding: 4rpx;
  height: 88rpx;
  box-sizing: border-box;
}

.stab-seg-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: calc(var(--radius-sm) - 2rpx);
  transition: all 0.2s ease;
}

.stab-seg-on {
  background: var(--color-card);
  box-shadow: var(--shadow-sm);
}

.stab-seg-tx {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-secondary);
}

.stab-seg-on .stab-seg-tx {
  font-weight: 600;
  color: var(--color-text-primary);
}

.stab-bottom-spacer {
  height: 40rpx;
}

/* ============ 顶部工具栏（范围切换 + 搜索） ============ */
.mon-toolbar {
  padding: 12rpx 0 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  position: sticky;
  top: 128rpx;
  z-index: 10;
  background: var(--color-background);
}

/* 分段控件：胶囊式 */
.mon-seg-wrap {
  padding: 0 32rpx;
}

.mon-seg {
  display: flex;
  background: var(--color-type-bg);
  border-radius: var(--radius-sm);
  padding: 4rpx;
  height: 88rpx;
  box-sizing: border-box;
}

.mon-seg-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
  border-radius: calc(var(--radius-sm) - 2rpx);
  transition: all 0.2s ease;
}

.mon-seg-active {
  background: var(--color-card);
  color: var(--color-text-primary);
  font-weight: 600;
  box-shadow: var(--shadow-sm);
}

.mon-seg-count {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  font-weight: 500;
  line-height: 1;
}

.mon-seg-active .mon-seg-count {
  color: var(--color-text-secondary);
}

/* 搜索栏 */
.mon-search-wrap {
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  gap: 12rpx;
}

.mon-search-bar {
  flex: 1;
  height: 88rpx;
  background: var(--color-muted);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  padding: 0 16rpx;
  gap: 10rpx;
}

.mon-search-ico {
  width: 28rpx;
  height: 28rpx;
  display: block;
  flex-shrink: 0;
  opacity: 0.8;
}

.mon-search-input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.mon-search-placeholder {
  color: var(--color-text-tertiary);
  font-size: 28rpx;
}

.mon-search-clear {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: -16rpx;
}

.mon-search-clear-ico {
  width: 28rpx;
  height: 28rpx;
  background: var(--color-icon-tertiary);
  border-radius: 50%;
  position: relative;
}

.mon-search-clear-ico::before,
.mon-search-clear-ico::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 14rpx;
  height: 2rpx;
  background: var(--color-primary-foreground);
}

.mon-search-clear-ico::before {
  transform: translate(-50%, -50%) rotate(45deg);
}

.mon-search-clear-ico::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

.mon-search-cancel {
  flex: none;
  font-size: 28rpx;
  color: var(--color-primary);
  font-weight: 500;
  padding: 0 4rpx;
  min-width: 88rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ============ 空态 ============ */
.mon-empty {
  padding: 160rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.mon-empty-ico {
  width: 128rpx;
  height: 128rpx;
  margin-bottom: 32rpx;
  display: block;
}

.mon-empty-tx {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--color-text-secondary);
}

.mon-empty-sub {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  margin-top: 12rpx;
  line-height: 1.5;
  max-width: 500rpx;
}

.mon-empty .btn-ghost {
  margin-top: 32rpx;
}

/* ============ 列表 ============ */
.mon-list {
  padding: 8rpx 24rpx 40rpx;
}

.mon-site-card {
  background: var(--color-card);
  border-radius: var(--radius-xl);
  padding: 28rpx;
  margin-bottom: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  transition: opacity 0.15s ease;
}

.mon-site-card-active {
  opacity: 0.7;
}

/* 顶部：站点名 + 标签组 */
.mon-site-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.mon-site-name {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.4;
  word-break: break-all;
}

.mon-site-tags {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

/* 标签（我负责等辅助标签，区别于状态胶囊） */
.mon-tag {
  padding: 3rpx 12rpx;
  border-radius: var(--radius-xs);
  white-space: nowrap;
}

.mon-tag-tx {
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1.4;
}

.mon-tag-info {
  background: var(--color-info-surface);
}

.mon-tag-info .mon-tag-tx {
  color: var(--color-info);
}

/* 状态标签 */
.mon-status-chip {
  flex: none;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-full);
  background: var(--color-type-bg);
  white-space: nowrap;
}

.mon-status-tx {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--color-type-text);
  line-height: 1.4;
}

.mon-status-normal {
  background: var(--color-success-surface);
}
.mon-status-normal .mon-status-tx {
  color: var(--color-success);
}

.mon-status-attention,
.mon-status-warning,
.mon-status-stale {
  background: var(--color-warning-surface);
}
.mon-status-attention .mon-status-tx,
.mon-status-warning .mon-status-tx,
.mon-status-stale .mon-status-tx {
  color: var(--color-warning);
}

.mon-status-error,
.mon-status-offline,
.mon-status-unavailable {
  background: var(--color-error-surface);
}
.mon-status-error .mon-status-tx,
.mon-status-offline .mon-status-tx,
.mon-status-unavailable .mon-status-tx {
  color: var(--color-error);
}

.mon-status-info,
.mon-status-pending {
  background: var(--color-info-surface);
}
.mon-status-info .mon-status-tx,
.mon-status-pending .mon-status-tx {
  color: var(--color-info);
}

/* 站点编号 */
.mon-site-code {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  line-height: 1;
}

/* 原因 */
.mon-site-reason {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
  word-break: break-all;
}

/* 元信息（时间） */
.mon-site-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.mon-meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.mon-meta-ico {
  width: 24rpx;
  height: 24rpx;
  display: block;
  opacity: 0.6;
}

.mon-meta-tx {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  line-height: 1;
}

/* 底部：因子数 + 箭头 */
.mon-site-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 14rpx;
  border-top: 0.5rpx solid var(--color-divider);
}

.mon-factor-count {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.mon-factor-count--muted {
  color: var(--color-text-tertiary);
}

.mon-site-chevron {
  font-size: 36rpx;
  color: var(--color-icon-tertiary);
  line-height: 1;
  font-weight: 400;
}

/* ============ 监测未启用中性提示条 ============ */
.mon-neutral-bar {
  margin: 0 32rpx 20rpx;
  padding: 20rpx 24rpx;
  background: var(--color-type-bg);
  border-radius: var(--radius-md);
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.mon-neutral-ico {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  opacity: 0.6;
  margin-top: 2rpx;
}

.mon-neutral-content {
  flex: 1;
  min-width: 0;
}

.mon-neutral-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  margin-bottom: 4rpx;
}

.mon-neutral-sub {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  line-height: 1.5;
}

/* ============ 刷新失败提示条 ============ */
.mon-stale-bar {
  margin: 0 24rpx 24rpx;
  padding: 16rpx 20rpx;
  background: var(--color-error-surface);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.mon-stale-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-error);
  flex-shrink: 0;
}

.mon-stale-tx {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--color-error);
  line-height: 1.4;
  word-break: break-word;
}

.mon-stale-bar .btn-ghost {
  flex: none;
  font-size: 24rpx;
  color: var(--color-error);
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 20rpx;
  min-height: 0;
}

.mon-stale-bar .btn-ghost::after {
  border: none;
}

/* ============ 试剂模式 ============ */
.ro-filter-bar {
  position: sticky;
  top: 128rpx;
  z-index: 10;
  background: var(--color-background);
  padding: 12rpx 0 8rpx;
}

.ro-filter-scroll {
  white-space: nowrap;
  padding: 0 28rpx;
}

.ro-filter-chips {
  display: inline-flex;
  gap: 12rpx;
}

.ro-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 28rpx;
  background: var(--color-type-bg);
  min-height: 88rpx;
  box-sizing: border-box;
  border-radius: var(--radius-full);
  flex-shrink: 0;
  transition: all 0.15s ease;
}

.ro-chip:active {
  opacity: 0.85;
}

.ro-chip--active {
  background: var(--color-primary);
}

.ro-chip--active .ro-chip-tx {
  color: var(--color-primary-foreground);
  font-weight: 500;
}

.ro-chip-tx {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.4;
  white-space: nowrap;
}

.ro-list {
  padding: 12rpx 32rpx 0;
}

.ro-card {
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.ro-site-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.3;
  margin-bottom: 16rpx;
  word-break: break-word;
}

.ro-reagent-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.ro-reagent-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
  flex: 1;
  min-width: 0;
  white-space: normal;
  word-break: break-word;
  margin-right: 16rpx;
}

/* 多原因标签组 */
.ro-reason-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 14rpx;
}

.ro-reason-tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
  flex-shrink: 0;
}

.ro-reason-tx {
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.4;
  white-space: nowrap;
}

/* 关注原因语义色：类型本身不绑定颜色 */
.ro-reason--expired { background: var(--color-error-surface); }
.ro-reason--expired .ro-reason-tx { color: var(--color-error); }

.ro-reason--failed_qc { background: var(--color-error-surface); }
.ro-reason--failed_qc .ro-reason-tx { color: var(--color-error); }

.ro-reason--expiring { background: var(--color-warning-surface); }
.ro-reason--expiring .ro-reason-tx { color: var(--color-warning); }

.ro-reason--low_volume { background: var(--color-warning-surface); }
.ro-reason--low_volume .ro-reason-tx { color: var(--color-warning); }

.ro-reason--pending_qc { background: var(--color-warning-surface); }
.ro-reason--pending_qc .ro-reason-tx { color: var(--color-warning); }

.ro-reagent-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0 8rpx;
  margin-bottom: 16rpx;
}

.ro-meta-item {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.ro-meta-dot {
  font-size: 24rpx;
  color: var(--color-text-disabled);
  margin: 0 4rpx;
}

/* 操作按钮 */
.ro-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding-top: 8rpx;
}

.ro-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx;
  min-height: 88rpx;
  border-radius: var(--radius-lg);
  transition: opacity 0.15s ease;
}

.ro-btn:active {
  opacity: 0.85;
}

.ro-btn--secondary {
  border: 2rpx solid var(--color-border);
}

.ro-btn--secondary .ro-btn-tx {
  color: var(--color-primary);
  font-weight: 500;
}

.ro-btn--text .ro-btn-tx {
  color: var(--color-primary);
  font-weight: 500;
}

.ro-btn-tx {
  font-size: 26rpx;
  line-height: 1.4;
}

/* 骨架屏 */
.ro-skeleton {
  padding: 12rpx 32rpx 0;
}

.ro-sk-card {
  height: 180rpx;
  border-radius: var(--radius-xl);
  margin-bottom: 20rpx;
  background: var(--color-card);
  position: relative;
  overflow: hidden;
}

.ro-sk-card::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
  animation: roShimmer 1.5s infinite;
}

@keyframes roShimmer {
  100% { left: 100%; }
}

/* 空态/失败 */
.ro-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx 40rpx;
}

.ro-empty-icon {
  width: 128rpx;
  height: 128rpx;
  margin-bottom: 28rpx;
  opacity: 0.7;
}

.ro-empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.4;
  margin-bottom: 12rpx;
  text-align: center;
}

.ro-empty-sub {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
  text-align: center;
  margin-bottom: 28rpx;
}

.ro-empty-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 36rpx;
  min-height: 88rpx;
  border-radius: var(--radius-lg);
  border: 2rpx solid var(--color-border);
  transition: opacity 0.15s ease;
}

.ro-empty-btn:active {
  opacity: 0.85;
}

.ro-empty-btn-tx {
  font-size: 28rpx;
  color: var(--color-primary);
  font-weight: 500;
  line-height: 1.4;
}

/* ============ 底部 Sheet 弹窗 ============ */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 1000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.sheet-container {
  background: var(--color-card);
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  max-height: 75vh;
  display: flex;
  flex-direction: column;
  position: relative;
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--color-text-disabled);
  opacity: 0.3;
  margin: 16rpx auto 0;
  flex-shrink: 0;
}

.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx 16rpx;
  flex-shrink: 0;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.sheet-close {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: -12rpx;
}

.sheet-close-ico {
  width: 28rpx;
  height: 28rpx;
  position: relative;
}

.sheet-close-ico::before,
.sheet-close-ico::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 28rpx;
  height: 3rpx;
  background: var(--color-text-tertiary);
  border-radius: 2rpx;
}

.sheet-close-ico::before {
  transform: translate(-50%, -50%) rotate(45deg);
}

.sheet-close-ico::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

.sheet-body {
  flex: 1;
  min-height: 0;
  padding: 0 32rpx 32rpx;
}

.sheet-section {
  margin-bottom: 32rpx;
}

.sheet-section-title {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--color-text-tertiary);
  letter-spacing: 0.5rpx;
  text-transform: uppercase;
  margin-bottom: 16rpx;
}

/* 只读信息行 */
.sheet-info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}

.sheet-info-row:last-child {
  border-bottom: none;
}

.sheet-info-label {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  flex-shrink: 0;
}

.sheet-info-value {
  font-size: 28rpx;
  color: var(--color-text-primary);
  font-weight: 500;
  text-align: right;
  flex: 1;
  min-width: 0;
  white-space: normal;
  word-break: break-word;
  margin-left: 20rpx;
}

/* 表单字段 */
.sheet-field {
  margin-bottom: 24rpx;
}

.sheet-field-label {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}

.sheet-required {
  color: var(--color-error);
  margin-left: 4rpx;
}

.sheet-input-wrap {
  display: flex;
  align-items: center;
  height: 88rpx;
  background: var(--color-type-bg);
  border-radius: var(--radius-md);
  padding: 0 24rpx;
  border: 2rpx solid transparent;
  transition: border-color 0.15s ease;
}

.sheet-field--error .sheet-input-wrap {
  border-color: var(--color-error);
}

.sheet-input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.sheet-input-suffix {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  margin-left: 12rpx;
  flex-shrink: 0;
}

.sheet-field-error {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: var(--color-error);
  margin-top: 10rpx;
  line-height: 1.4;
}

.sheet-error-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: var(--color-error);
  color: var(--color-primary-foreground);
  font-size: 20rpx;
  font-weight: 600;
  font-style: normal;
  flex-shrink: 0;
}

/* Picker */
.sheet-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex: 1;
  height: 88rpx;
}

.sheet-picker-placeholder {
  color: var(--color-text-tertiary);
}

.sheet-picker-arrow {
  font-size: 32rpx;
  color: var(--color-text-disabled);
  line-height: 1;
}

/* Textarea */
.sheet-textarea-wrap {
  background: var(--color-type-bg);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  min-height: 140rpx;
}

.sheet-textarea {
  width: 100%;
  min-height: 100rpx;
  font-size: 28rpx;
  color: var(--color-text-primary);
  line-height: 1.6;
}

/* 单选组 */
.sheet-radio-group {
  display: flex;
  gap: 20rpx;
}

.sheet-radio {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 88rpx;
  background: var(--color-type-bg);
  border-radius: var(--radius-md);
  border: 2rpx solid transparent;
  transition: all 0.15s ease;
}

.sheet-radio--on {
  border-color: var(--color-primary);
  background: var(--color-primary-surface);
}

.sheet-radio-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 3rpx solid var(--color-text-tertiary);
  position: relative;
}

.sheet-radio--on .sheet-radio-dot {
  border-color: var(--color-primary);
}

.sheet-radio--on .sheet-radio-dot::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--color-primary);
}

.sheet-radio-tx {
  font-size: 28rpx;
  color: var(--color-text-primary);
  font-weight: 500;
}

/* 底部操作栏 */
.sheet-footer {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-divider);
  flex-shrink: 0;
}

.sheet-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: var(--radius-lg);
  transition: opacity 0.15s ease;
}

.sheet-btn:active {
  opacity: 0.85;
}

.sheet-btn--ghost {
  border: 2rpx solid var(--color-border);
}

.sheet-btn--ghost .sheet-btn-tx {
  color: var(--color-text-secondary);
  font-weight: 500;
}

.sheet-btn--primary {
  background: var(--color-primary);
}

.sheet-btn--primary .sheet-btn-tx {
  color: var(--color-primary-foreground);
  font-weight: 500;
}

.sheet-btn--disabled {
  opacity: 0.5;
  pointer-events: none;
}

.sheet-btn-tx {
  font-size: 30rpx;
  line-height: 1.4;
}

/* 成功态覆盖层 */
.sheet-success {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: var(--color-card);
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 48rpx;
}

.sheet-success-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--color-success-surface);
  margin-bottom: 28rpx;
  position: relative;
}

.sheet-success-icon::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 36rpx;
  height: 20rpx;
  border-left: 4rpx solid var(--color-success);
  border-bottom: 4rpx solid var(--color-success);
  transform: translate(-50%, -60%) rotate(-45deg);
}

.sheet-success-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 12rpx;
}

.sheet-success-sub {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  text-align: center;
  line-height: 1.5;
  margin-bottom: 40rpx;
}

.sheet-success-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 60rpx;
  border-radius: var(--radius-lg);
  background: var(--color-primary);
}

.sheet-success-btn-tx {
  font-size: 28rpx;
  color: var(--color-primary-foreground);
  font-weight: 500;
}

/* 提交中遮罩态：不可点击关闭（视觉无变化，行为由 JS 控制） */
.sheet-mask--submitting {
  /* 保留类名锚点，开发接线时可加 loading 指示器等扩展 */
}

/* 关闭按钮禁用态 */
.sheet-close--disabled {
  opacity: 0.4;
  pointer-events: none;
}

/* 服务端错误提示条 */
.sheet-server-error {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  background: var(--color-error-surface);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.sheet-server-error-tx {
  font-size: 26rpx;
  color: var(--color-error);
  flex: 1;
  line-height: 1.4;
  min-width: 0;
  word-break: break-word;
}

.sheet-server-error-retry {
  font-size: 26rpx;
  color: var(--color-error);
  font-weight: 500;
  flex-shrink: 0;
  margin-left: 16rpx;
  min-width: 88rpx;
  min-height: 88rpx;
  margin-top: -20rpx;
  margin-bottom: -20rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

/* 单选组错误态 */
.sheet-field--error .sheet-radio-group {
  border: 2rpx solid var(--color-error);
  border-radius: var(--radius-md);
  padding: 0;
  gap: 0;
}
