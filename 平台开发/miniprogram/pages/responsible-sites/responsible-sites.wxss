/* ========== 站点 Tab 页面 ========== */
.stab-page {
  min-height: 100vh;
  background: var(--color-background);
  padding-bottom: calc(88rpx + env(safe-area-inset-bottom));
}

/* 导航栏标题区 — 消费 nav-bar wechat-custom 规格：17px/600 */
.stab-nav-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 100%;
}

.stab-nav-title {
  font-size: var(--font-title-1);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

/* 导航栏范围选择器（与 plan 页 .scope-toggle 一致）
   嵌在导航栏内，作为页面上下文，不占内容区高度
   触控铁律：外层 88rpx，内部视觉块紧凑居中 */
.stab-nav-scope {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 0 16rpx;
  background: var(--color-muted);
  border-radius: var(--radius-sm);
  font-size: var(--font-callout);
  color: var(--color-text-secondary);
  min-height: 88rpx; /* 触控铁律：≥88rpx 点击热区 */
  transition: opacity 0.15s ease;
}

.stab-nav-scope.is-pending {
  opacity: 0.6; /* 切换中视觉反馈，不改变布局 */
}

.stab-nav-scope-text {
  font-size: var(--font-callout);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-secondary);
}

.stab-nav-scope-arrow {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  line-height: 1;
}

/* ========= 工具条层级体系 =========
   一级（主模式分段）：全宽胶囊，88rpx 高，font-callout → 页面级切换，最重
   二级（搜索/筛选）：列表级工具，归属内容区 → 中等
   三级（试剂筛选标签）：描边小标签，最轻
   导航栏→一级间距 16rpx（与计划/告警页统一）
   一级→内容间距 12rpx
   所有可点击元素触控热区 ≥ 88rpx（铁律第5条） */

/* 主模式分段外层：与计划/告警页统一 16rpx 上 / 12rpx 下
   控件本身样式消费全局 .segment-control，页面级只调间距 */
.segment-wrap {
  padding: var(--space-4) var(--space-8) var(--space-3);
  box-sizing: border-box;
}

/* 三级筛选（试剂模式下）：列表级筛选标签
   视觉降权：描边小标签（64rpx 视觉高 / 1rpx 边框 / 透明底）
   触控铁律：外层 padding 扩展至 88rpx 总高，视觉与触控分离
   左对齐 + 内容宽度 → 归属内容区，不是导航 */
.reagent-filter-wrap {
  padding: 4rpx 0 12rpx;
}
.reagent-filter-wrap .segment-control {
  background: transparent;
  border-radius: 0;
  padding: 0;
  height: auto;
  margin: 0 32rpx;
  gap: 16rpx;
  display: flex;
  justify-content: flex-start;
  flex-wrap: wrap;
}
.reagent-filter-wrap .segment-item {
  flex: 0 0 auto;
  min-width: 88rpx;       /* 铁律：触控热区 ≥ 88rpx */
  min-height: 88rpx;      /* 铁律：触控热区 ≥ 88rpx */
  padding: 12rpx 24rpx;   /* 上下 12rpx 透明扩展 + 64rpx 视觉 = 88rpx 触控 */
  background: transparent;
  position: relative;
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 视觉标签层：64rpx 高，描边样式 */
.reagent-filter-wrap .segment-item text {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--color-divider);
  border-radius: 9999rpx;
  font-size: var(--font-footnote);
  font-weight: var(--font-weight-regular);
  color: var(--color-text-secondary);
  background: transparent;
  box-sizing: border-box;
  line-height: 1;
}
.reagent-filter-wrap .segment-item.active text {
  border-color: var(--color-primary);
  background: var(--color-primary-surface);
  color: var(--color-primary);
  font-weight: var(--font-weight-medium);
}

.stab-bottom-spacer {
  height: 40rpx;
}

/* 三级搜索栏：80rpx 高（输入框规格，不适用按钮触控规则）
   清除按钮单独 88rpx 热区 */
.mon-search-wrap {
  display: flex;
  align-items: center;
  padding: 0 32rpx 12rpx;
  gap: 12rpx;
}

.mon-search-bar {
  flex: 1;
  height: 72rpx;
  background: var(--color-muted);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  padding: 0 16rpx;
  gap: 10rpx;
  overflow: visible; /* 允许清除按钮溢出以扩展触控热区 */
}

.mon-search-ico {
  width: 28rpx;
  height: 28rpx;
  display: block;
  flex-shrink: 0;
  opacity: 0.8;
}

.mon-search-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  font-size: 26rpx;
  color: var(--color-text-primary);
}

.mon-search-placeholder {
  color: var(--color-text-tertiary);
  font-size: 26rpx;
}

/* 清除按钮：88rpx 触控热区（铁律），视觉上在 72rpx 搜索栏内居中溢出 */
.mon-search-clear {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: -16rpx;
}

.mon-search-clear-ico {
  width: 28rpx;
  height: 28rpx;
  background: var(--color-icon-tertiary);
  border-radius: 50%;
  position: relative;
}

.mon-search-clear-ico::before,
.mon-search-clear-ico::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 14rpx;
  height: 2rpx;
  background: var(--color-primary-foreground);
}

.mon-search-clear-ico::before {
  transform: translate(-50%, -50%) rotate(45deg);
}

.mon-search-clear-ico::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

.mon-search-cancel {
  flex: none;
  font-size: 28rpx;
  color: var(--color-primary);
  font-weight: 500;
  padding: 0 4rpx;
  min-width: 88rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ============ 空态 ============ */
.mon-empty {
  padding: 160rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.mon-empty-ico {
  width: 128rpx;
  height: 128rpx;
  margin-bottom: 32rpx;
  display: block;
}

.mon-empty-tx {
  font-size: var(--font-title-3);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-secondary);
}

.mon-empty-sub {
  font-size: var(--font-callout);
  color: var(--color-text-tertiary);
  margin-top: 12rpx;
  line-height: 1.5;
  max-width: 500rpx;
}

.mon-empty .btn-ghost {
  margin-top: 32rpx;
}

/* ============ 列表 ============
   左右 32rpx 与搜索栏、说明条、分段控件统一对齐 */
.mon-list {
  padding: 8rpx 32rpx 40rpx;
}

.mon-site-card {
  background: var(--color-card);
  border-radius: var(--radius-xl);
  padding: 28rpx;
  margin-bottom: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  transition: opacity 0.15s ease;
}

.mon-site-card-active {
  opacity: 0.7;
}

/* 顶部：站点名 + 标签组 */
.mon-site-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.mon-site-name {
  flex: 1;
  min-width: 0;
  font-size: var(--font-title-3);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  line-height: 1.4;
  word-break: break-all;
}

.mon-site-tags {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

/* 标签（我负责等辅助标签，区别于状态胶囊） */
.mon-tag {
  padding: var(--space-1) var(--space-4);
  border-radius: var(--radius-xs);
  white-space: nowrap;
}

.mon-tag-tx {
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1.4;
}

.mon-tag-info {
  background: var(--color-info-surface);
}

.mon-tag-info .mon-tag-tx {
  color: var(--color-info);
}

/* 状态标签 */
.mon-status-chip {
  flex: none;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-full);
  background: var(--color-type-bg);
  white-space: nowrap;
}

.mon-status-tx {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--color-type-text);
  line-height: 1.4;
}

.mon-status-normal {
  background: var(--color-success-surface);
}
.mon-status-normal .mon-status-tx {
  color: var(--color-success);
}

.mon-status-attention,
.mon-status-warning,
.mon-status-stale {
  background: var(--color-warning-surface);
}
.mon-status-attention .mon-status-tx,
.mon-status-warning .mon-status-tx,
.mon-status-stale .mon-status-tx {
  color: var(--color-warning);
}

.mon-status-error,
.mon-status-offline,
.mon-status-unavailable {
  background: var(--color-error-surface);
}
.mon-status-error .mon-status-tx,
.mon-status-offline .mon-status-tx,
.mon-status-unavailable .mon-status-tx {
  color: var(--color-error);
}

.mon-status-info,
.mon-status-pending {
  background: var(--color-info-surface);
}
.mon-status-info .mon-status-tx,
.mon-status-pending .mon-status-tx {
  color: var(--color-info);
}

/* 过渡态：中性灰（等待首次数据 / 配置待完成 / 周期待设置 / 未接入） */
.mon-status-not_connected,
.mon-status-awaiting_first_frame,
.mon-status-raw_received_config_pending,
.mon-status-interval_unconfigured,
.mon-status-waiting_first_valid,
.mon-status-default,
.mon-status-unknown {
  background: var(--color-type-bg);
}
.mon-status-not_connected .mon-status-tx,
.mon-status-awaiting_first_frame .mon-status-tx,
.mon-status-raw_received_config_pending .mon-status-tx,
.mon-status-interval_unconfigured .mon-status-tx,
.mon-status-waiting_first_valid .mon-status-tx,
.mon-status-default .mon-status-tx,
.mon-status-unknown .mon-status-tx {
  color: var(--color-type-text);
}

/* 站点编号 */
.mon-site-code {
  font-size: var(--font-footnote);
  color: var(--color-text-tertiary);
  line-height: 1;
}

/* 原因 */
.mon-site-reason {
  font-size: var(--font-callout);
  color: var(--color-text-secondary);
  line-height: 1.5;
  word-break: break-all;
}

/* 元信息（时间） */
.mon-site-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.mon-meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.mon-meta-ico {
  width: 24rpx;
  height: 24rpx;
  display: block;
  opacity: 0.6;
}

.mon-meta-tx {
  font-size: var(--font-footnote);
  color: var(--color-text-tertiary);
  line-height: 1;
}

/* 底部：因子数 + 箭头 */
.mon-site-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 14rpx;
  border-top: 0.5rpx solid var(--color-divider);
}

/* 紧凑尾部（无监测/纯目录卡）：去掉分隔线和上边距，箭头融入卡片
   不制造"缺了一整行数据"的空白高度 */
.mon-site-bottom--compact {
  padding-top: 0;
  border-top: none;
  justify-content: flex-end;
  margin-top: -4rpx;
}

.mon-factor-count {
  font-size: var(--font-footnote);
  color: var(--color-text-secondary);
}

.mon-factor-count--muted {
  color: var(--color-text-tertiary);
}

.mon-site-chevron {
  font-size: 36rpx;
  color: var(--color-icon-tertiary);
  line-height: 1;
  font-weight: 400;
}

/* ============ 监测未启用中性提示条 ============ */
.mon-neutral-bar {
  margin: 0 32rpx 20rpx;
  padding: 20rpx 24rpx;
  background: var(--color-type-bg);
  border-radius: var(--radius-md);
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.mon-neutral-ico {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  opacity: 0.6;
  margin-top: 2rpx;
}

.mon-neutral-content {
  flex: 1;
  min-width: 0;
}

.mon-neutral-title {
  display: block;
  font-size: var(--font-callout);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-secondary);
  margin-bottom: 4rpx;
}

.mon-neutral-sub {
  display: block;
  font-size: var(--font-footnote);
  color: var(--color-text-tertiary);
  line-height: 1.5;
}

/* ============ 刷新失败提示条 ============ */
.mon-stale-bar {
  margin: 0 24rpx 24rpx;
  padding: 16rpx 20rpx;
  background: var(--color-error-surface);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.mon-stale-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-error);
  flex-shrink: 0;
}

.mon-stale-tx {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--color-error);
  line-height: 1.4;
  word-break: break-word;
}

.mon-stale-bar .btn-ghost {
  flex: none;
  font-size: 24rpx;
  color: var(--color-error);
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 20rpx;
  min-height: 0;
}

.mon-stale-bar .btn-ghost::after {
  border: none;
}

/* ============ 试剂模式 ============ */
/* 注：试剂筛选直接消费全局 .segment-control，见 .segment-wrap */

/* 站点分组列表 */
.ro-group-list {
  padding: 8rpx 0 0;
}

/* 站点组 */
.ro-site-group {
  margin: 0 32rpx 16rpx;
  background: var(--color-card);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

/* 站点组标题（可点击展开/收起，热区 ≥ 88rpx）
   左右 padding 32rpx（设计系统 list-row 标准边距） */
.ro-site-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  transition: opacity 0.15s ease;
}

.ro-site-header:active {
  opacity: 0.85;
}

.ro-site-header-left {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.ro-site-header-name {
  font-size: var(--font-headline);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  line-height: 1.3;
  word-break: break-word;
}

.ro-site-header-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.ro-site-header-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.ro-site-header-count {
  font-size: var(--font-footnote);
  font-weight: var(--font-weight-medium);
  color: var(--color-error);
  white-space: nowrap;
}

.ro-site-header-count--muted {
  color: var(--color-text-tertiary);
}

.ro-site-chevron {
  font-size: 32rpx;
  color: var(--color-text-tertiary);
  line-height: 1;
  transition: transform 0.2s ease;
}

.ro-site-chevron--up {
  transform: rotate(90deg);
}

/* 站内试剂行 */
.ro-reagent-rows {
  border-top: 1rpx solid var(--color-border);
}

.ro-reagent-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid var(--color-border);
  gap: 16rpx;
}

.ro-reagent-row:last-child {
  border-bottom: none;
}

.ro-row-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

/* 试剂名 + QC 状态 同一行 */
.ro-row-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.ro-row-name {
  font-size: var(--font-body);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  line-height: 1.3;
  word-break: break-word;
  flex: 0 1 auto;
  max-width: 100%;
}

/* QC 状态标签（独立权威状态，不由 attention_reasons 推断） */
.ro-row-qc {
  flex-shrink: 0;
}

.ro-row-qc--normal { background: var(--color-success-surface); color: var(--color-success); }
.ro-row-qc--pending { background: var(--color-warning-surface); color: var(--color-warning); }
.ro-row-qc--failed { background: var(--color-error-surface); color: var(--color-error); }
.ro-row-qc--unknown { background: var(--color-type-bg); color: var(--color-text-tertiary); }

.ro-row-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0 8rpx;
}

.ro-row-meta-item {
  font-size: var(--font-footnote);
  color: var(--color-text-secondary);
  line-height: 1.4;
}

.ro-row-meta-dot {
  font-size: var(--font-footnote);
  color: var(--color-text-disabled);
  margin: 0 4rpx;
}

.ro-row-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 2rpx;
}

/* 操作区：按钮真实盒模型 ≥ 88rpx（不使用负 margin 模拟触控区） */
.ro-row-actions {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}

.ro-row-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  min-height: 88rpx; /* 真实触控热区 ≥ 88rpx，盒模型本身达标 */
  min-width: 88rpx;  /* 窄按钮也保证 88rpx 方形触控区 */
  border-radius: var(--radius-md);
  background: var(--color-type-bg);
  transition: opacity 0.15s ease;
  box-sizing: border-box;
}

.ro-row-btn:active {
  opacity: 0.85;
}

.ro-row-btn--primary {
  background: var(--color-primary);
}

.ro-row-btn--primary .ro-row-btn-tx {
  color: var(--color-primary-foreground);
  font-weight: 500;
}

.ro-row-btn-tx {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
  line-height: 1;
  white-space: nowrap;
}

/* 骨架屏 */
.ro-skeleton {
  padding: 12rpx 32rpx 0;
}

.ro-sk-card {
  height: 180rpx;
  border-radius: var(--radius-xl);
  margin-bottom: 20rpx;
  background: var(--color-card);
  position: relative;
  overflow: hidden;
}

.ro-sk-card::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
  animation: roShimmer 1.5s infinite;
}

@keyframes roShimmer {
  100% { left: 100%; }
}

/* 空态/失败 */
.ro-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx 40rpx;
}

.ro-empty-icon {
  width: 128rpx;
  height: 128rpx;
  margin-bottom: 28rpx;
  opacity: 0.7;
}

.ro-empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.4;
  margin-bottom: 12rpx;
  text-align: center;
}

.ro-empty-sub {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
  text-align: center;
  margin-bottom: 28rpx;
}

.ro-empty-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 36rpx;
  min-height: 88rpx;
  border-radius: var(--radius-lg);
  border: 2rpx solid var(--color-border);
  transition: opacity 0.15s ease;
}

.ro-empty-btn:active {
  opacity: 0.85;
}

.ro-empty-btn-tx {
  font-size: 28rpx;
  color: var(--color-primary);
  font-weight: 500;
  line-height: 1.4;
}

/* ============ 底部 Sheet 弹窗 ============ */
/* 统一 box-sizing，防止 padding 导致横向溢出
   注：WXSS 不支持 * 通配选择器，此处显式列出所有 sheet 子元素类 */
.sheet-container,
.sheet-mask,
.sheet-handle,
.sheet-header,
.sheet-title,
.sheet-close,
.sheet-close-ico,
.sheet-body,
.sheet-section,
.sheet-section-title,
.sheet-info-row,
.sheet-info-label,
.sheet-info-value,
.sheet-field,
.sheet-field-label,
.sheet-required,
.sheet-input-wrap,
.sheet-input,
.sheet-input-suffix,
.sheet-field-error,
.sheet-error-icon,
.sheet-picker,
.sheet-picker-placeholder,
.sheet-picker-arrow,
.sheet-textarea-wrap,
.sheet-textarea,
.sheet-radio-group,
.sheet-radio,
.sheet-radio-dot,
.sheet-radio-tx,
.sheet-footer,
.sheet-btn,
.sheet-btn-tx,
.sheet-success,
.sheet-success-icon,
.sheet-success-title,
.sheet-success-sub,
.sheet-success-btn,
.sheet-success-btn-tx,
.sheet-server-error,
.sheet-server-error-tx,
.sheet-server-error-retry {
  box-sizing: border-box;
}

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 1000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.sheet-container {
  background: var(--color-card);
  border-top-left-radius: 32rpx; /* 设计系统 bottom-sheet: 16px 顶部圆角 */
  border-top-right-radius: 32rpx;
  max-height: 75vh; /* 设计系统 bottom-sheet 铁律：不超过屏幕 75% */
  display: flex;
  flex-direction: column;
  position: relative;
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
 border-radius: 4rpx;
  background: var(--color-divider); /* 设计系统: separator 色 */
  margin: 0 auto var(--space-5);
  flex-shrink: 0;
}

.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx 16rpx;
  flex-shrink: 0;
}

.sheet-title {
  font-size: var(--font-title-2);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.sheet-close {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: -12rpx;
}

.sheet-close-ico {
  width: 28rpx;
  height: 28rpx;
  position: relative;
}

.sheet-close-ico::before,
.sheet-close-ico::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 28rpx;
  height: 3rpx;
  background: var(--color-text-tertiary);
  border-radius: 2rpx;
}

.sheet-close-ico::before {
  transform: translate(-50%, -50%) rotate(45deg);
}

.sheet-close-ico::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

.sheet-body {
  flex: 1;
  min-height: 0;
  padding: 8rpx 32rpx 24rpx;
  width: 100%;
  box-sizing: border-box;
}

.sheet-section {
  margin-bottom: 28rpx;
}

.sheet-section:last-child {
  margin-bottom: 0;
}

.sheet-section-title {
  display: block;
  font-size: var(--font-caption-1);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-tertiary);
  letter-spacing: 0.5rpx;
  text-transform: uppercase;
  margin-bottom: 16rpx;
}

/* 只读信息行 */
.sheet-info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}

.sheet-info-row:last-child {
  border-bottom: none;
}

.sheet-info-label {
  font-size: var(--font-body);
  color: var(--color-text-secondary);
  flex-shrink: 0;
}

.sheet-info-value {
  font-size: var(--font-body);
  color: var(--color-text-primary);
  font-weight: var(--font-weight-medium);
  text-align: right;
  flex: 1;
  min-width: 0;
  white-space: normal;
  word-break: break-word;
  margin-left: 20rpx;
}

/* 表单字段 */
.sheet-field {
  margin-bottom: 24rpx;
}

.sheet-field:last-child {
  margin-bottom: 0;
}

/* 表单标签：text-secondary */
.sheet-field-label {
  display: block;
  font-size: var(--font-body);
  color: var(--color-text-secondary);
  margin-bottom: 10rpx;
}

.sheet-required {
  color: var(--color-error);
  margin-left: 4rpx;
}

/* filled 输入框：40px = 80rpx 高，圆角 10px = radius-sm，灰底无边框
   设计系统 input filled variant */
.sheet-input-wrap {
  display: flex;
  align-items: center;
  height: 80rpx;
  background: var(--color-muted);
  border-radius: var(--radius-sm);
  padding: 0 24rpx;
  border: none; /* filled 变体无边框 */
}

/* error 态：加 error 色描边 */
.sheet-field--error .sheet-input-wrap {
  box-shadow: 0 0 0 2rpx var(--color-error);
}

.sheet-input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  font-size: var(--font-callout);
  color: var(--color-text-primary);
}

.sheet-input-suffix {
  font-size: var(--font-body);
  color: var(--color-text-tertiary);
  margin-left: 12rpx;
  flex-shrink: 0;
}

.sheet-field-error {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: var(--font-caption-1);
  color: var(--color-error);
  margin-top: 8rpx;
  line-height: 1.4;
}

.sheet-error-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: var(--color-error);
  color: var(--color-primary-foreground);
  font-size: 20rpx;
  font-weight: 600;
  font-style: normal;
  flex-shrink: 0;
}

/* Picker — 与 filled input 同高同字号 */
.sheet-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex: 1;
  height: 80rpx;
  font-size: var(--font-callout);
  color: var(--color-text-primary);
}

.sheet-picker-placeholder {
  color: var(--color-text-tertiary);
}

.sheet-picker-arrow {
  font-size: 32rpx;
  color: var(--color-text-disabled);
  line-height: 1;
}

/* Textarea — filled 风格，灰底小圆角 */
.sheet-textarea-wrap {
  background: var(--color-muted);
  border-radius: var(--radius-sm);
  padding: 16rpx 24rpx;
  min-height: 140rpx;
}

.sheet-textarea {
  width: 100%;
  min-height: 108rpx;
  font-size: var(--font-callout);
  color: var(--color-text-primary);
  line-height: 1.6;
}

/* 单选组 */
.sheet-radio-group {
  display: flex;
  gap: 20rpx;
}

.sheet-radio {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 88rpx;
  background: var(--color-type-bg);
  border-radius: var(--radius-md);
  border: 2rpx solid transparent;
  transition: all 0.15s ease;
}

.sheet-radio--on {
  border-color: var(--color-primary);
  background: var(--color-primary-surface);
}

.sheet-radio-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 3rpx solid var(--color-text-tertiary);
  position: relative;
}

.sheet-radio--on .sheet-radio-dot {
  border-color: var(--color-primary);
}

.sheet-radio--on .sheet-radio-dot::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--color-primary);
}

.sheet-radio-tx {
  font-size: var(--font-body);
  color: var(--color-text-primary);
  font-weight: var(--font-weight-medium);
}

/* 底部操作栏 */
.sheet-footer {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-divider);
  flex-shrink: 0;
}

.sheet-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: var(--radius-lg);
  transition: opacity 0.15s ease;
}

.sheet-btn:active {
  opacity: 0.85;
}

.sheet-btn--ghost {
  border: 2rpx solid var(--color-border);
}

.sheet-btn--ghost .sheet-btn-tx {
  color: var(--color-text-secondary);
  font-weight: var(--font-weight-medium);
}

.sheet-btn--primary {
  background: var(--color-primary);
}

.sheet-btn--primary .sheet-btn-tx {
  color: var(--color-primary-foreground);
  font-weight: var(--font-weight-medium);
}

.sheet-btn--disabled {
  opacity: 0.5;
  pointer-events: none;
}

.sheet-btn-tx {
  font-size: var(--font-callout);
  line-height: 1.4;
}

/* 成功态覆盖层 */
.sheet-success {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 48rpx;
  background: var(--color-card);
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
}

.sheet-success-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--color-success-surface);
  margin-bottom: 28rpx;
  position: relative;
}

.sheet-success-icon::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 36rpx;
  height: 20rpx;
  border-left: 4rpx solid var(--color-success);
  border-bottom: 4rpx solid var(--color-success);
  transform: translate(-50%, -60%) rotate(-45deg);
}

.sheet-success-title {
  font-size: var(--font-title-2);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  margin-bottom: 12rpx;
}

.sheet-success-sub {
  font-size: var(--font-callout);
  color: var(--color-text-secondary);
  text-align: center;
  line-height: 1.5;
  margin-bottom: 40rpx;
}

.sheet-success-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 60rpx;
  border-radius: var(--radius-lg);
  background: var(--color-primary);
}

.sheet-success-btn-tx {
  font-size: var(--font-body);
  color: var(--color-primary-foreground);
  font-weight: var(--font-weight-medium);
}

/* 提交中遮罩态：不可点击关闭（视觉无变化，行为由 JS 控制） */
.sheet-mask--submitting {
  /* 保留类名锚点，开发接线时可加 loading 指示器等扩展 */
}

/* 关闭按钮禁用态 */
.sheet-close--disabled {
  opacity: 0.4;
  pointer-events: none;
}

/* 服务端错误提示条 */
.sheet-server-error {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  background: var(--color-error-surface);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.sheet-server-error-tx {
  font-size: var(--font-callout);
  color: var(--color-error);
  flex: 1;
  line-height: 1.4;
  min-width: 0;
  word-break: break-word;
}

.sheet-server-error-retry {
  font-size: var(--font-callout);
  color: var(--color-error);
  font-weight: var(--font-weight-medium);
  flex-shrink: 0;
  margin-left: 16rpx;
  min-width: 88rpx;
  min-height: 88rpx;
  margin-top: -20rpx;
  margin-bottom: -20rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

/* 单选组错误态 */
.sheet-field--error .sheet-radio-group {
  border: 2rpx solid var(--color-error);
  border-radius: var(--radius-md);
  padding: 0;
  gap: 0;
}
