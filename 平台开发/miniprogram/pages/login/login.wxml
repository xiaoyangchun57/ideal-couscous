<view class="login-wrap">
  <!-- 品牌区 -->
  <view class="brand-area">
    <image class="brand-logo" src="/images/home-logo.png" mode="aspectFit" />
    <text class="brand-name">{{mustChangePassword ? '设置新密码' : '水质智慧运维'}}</text>
    <text class="brand-sub">{{mustChangePassword ? '临时密码验证成功，修改后进入系统' : '专业水质监测运维管理'}}</text>
  </view>

  <view class="recovery-card" wx:if="{{restoring}}">
    <view class="recovery-spinner"></view>
    <text class="recovery-title">正在恢复登录</text>
    <text class="recovery-sub">正在向服务端确认当前登录状态</text>
  </view>

  <view class="recovery-card" wx:elif="{{recoveryFailed}}">
    <text class="recovery-title">暂时无法恢复登录</text>
    <text class="recovery-sub">{{error}}</text>
    <button class="btn-login recovery-action" bindtap="onRetryRecovery">重试</button>
    <button class="recovery-secondary" bindtap="onUseAnotherAccount">使用其他账号登录</button>
  </view>

  <!-- 表单区 -->
  <view class="form-card" wx:if="{{!restoring && !recoveryFailed && !mustChangePassword}}">
    <view class="form-field">
      <image class="field-icon" src="data:image/svg+xml;base64," mode="aspectFit" />
      <input class="field-input" placeholder="用户名" placeholder-class="ph"
             value="{{username}}" bindinput="onUser" confirm-type="next" />
    </view>
    <view class="form-field">
      <image class="field-icon" src="data:image/svg+xml;base64," mode="aspectFit" />
      <input class="field-input" placeholder="密码" placeholder-class="ph"
             password="{{!showPassword}}" value="{{password}}" bindinput="onPass"
             confirm-type="done" bindconfirm="onLogin" />
      <view class="field-toggle" bindtap="onTogglePassword">
        <image class="toggle-icon" src="data:image/svg+xml;base64," mode="aspectFit" />
      </view>
    </view>
  </view>

  <view class="form-card" wx:elif="{{mustChangePassword}}">
    <view class="form-field">
      <image class="field-icon" src="data:image/svg+xml;base64," mode="aspectFit" />
      <input class="field-input" placeholder="至少8位" placeholder-class="ph"
             password="{{!showNewPassword}}" value="{{newPassword}}" bindinput="onNewPassword" confirm-type="next" />
      <view class="field-toggle" bindtap="onToggleNewPassword">
        <image class="toggle-icon" src="data:image/svg+xml;base64," mode="aspectFit" />
      </view>
    </view>
    <view class="form-field">
      <image class="field-icon" src="data:image/svg+xml;base64," mode="aspectFit" />
      <input class="field-input" placeholder="再次输入新密码" placeholder-class="ph"
             password="{{!showConfirmPassword}}" value="{{confirmPassword}}" bindinput="onConfirmPassword"
             confirm-type="done" bindconfirm="onChangePassword" />
      <view class="field-toggle" bindtap="onToggleConfirmPassword">
        <image class="toggle-icon" src="data:image/svg+xml;base64," mode="aspectFit" />
      </view>
    </view>
  </view>

  <!-- 登录按钮 -->
  <button class="btn-login" wx:if="{{!restoring && !recoveryFailed && !mustChangePassword}}"
          loading="{{loading}}" disabled="{{loading}}" bindtap="onLogin">登 录</button>
  <button class="btn-login" wx:if="{{mustChangePassword}}"
          loading="{{loading}}" disabled="{{loading}}" bindtap="onChangePassword">保存并进入系统</button>

  <!-- 错误提示 -->
  <view class="login-error" wx:if="{{error && !recoveryFailed}}">{{error}}</view>

  <!-- 底部 -->
  <view class="login-footer">
    <text class="footer-text">请联系管理员获取账号</text>
  </view>
</view>
