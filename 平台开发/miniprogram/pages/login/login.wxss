page {
  background: var(--bg-grouped);
  height: 100%;
}

.login-wrap {
  min-height: 100vh;
  padding: 0 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* 品牌区 */
.brand-area {
  margin-top: 160rpx;
  margin-bottom: 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand-logo {
  width: 168rpx;
  height: 168rpx;
  border-radius: 40rpx;
  margin-bottom: 32rpx;
}

.brand-name {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.3;
  margin-bottom: 12rpx;
}

.brand-sub {
  font-size: 28rpx;
  color: var(--text-tertiary);
  line-height: 1.4;
}

/* 表单卡片 */
.form-card {
  background: var(--bg-card);
  border-radius: 28rpx;
  overflow: hidden;
  margin-bottom: 48rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.recovery-card {
  background: var(--bg-card);
  border-radius: 28rpx;
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.recovery-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 6rpx solid var(--separator);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: recovery-spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

.recovery-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.recovery-sub {
  margin-top: 12rpx;
  font-size: 27rpx;
  line-height: 1.5;
  color: var(--text-secondary);
}

.recovery-action {
  margin-top: 36rpx;
}

.recovery-secondary {
  margin-top: 20rpx;
  padding: 16rpx 24rpx;
  background: transparent;
  color: var(--primary);
  font-size: 28rpx;
  line-height: 1.4;
}

.recovery-secondary::after {
  border: none;
}

@keyframes recovery-spin {
  to { transform: rotate(360deg); }
}

.form-field {
  height: 104rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  position: relative;
}

.form-field + .form-field::before {
  content: '';
  position: absolute;
  left: 84rpx;
  right: 0;
  top: 0;
  height: 1rpx;
  background: var(--separator);
}

.field-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.field-input {
  flex: 1;
  font-size: 32rpx;
  color: var(--text-primary);
  height: 104rpx;
}

.field-toggle {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.toggle-icon {
  width: 40rpx;
  height: 40rpx;
}

.ph {
  color: var(--text-placeholder);
  font-size: 32rpx;
}

/* 登录按钮 */
.btn-login {
  width: 100%;
  height: 100rpx;
  background: var(--primary);
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 24rpx;
  border: none;
  line-height: 100rpx;
  padding: 0;
  margin: 0;
}

.btn-login::after {
  border: none;
}

.btn-login[disabled] {
  opacity: 0.5;
  color: #fff;
}

/* 错误提示 */
.login-error {
  margin-top: 24rpx;
  color: var(--destructive);
  font-size: 28rpx;
  text-align: center;
}

/* 底部 */
.login-footer {
  margin-top: auto;
  padding: 40rpx 0 60rpx;
  text-align: center;
}

.footer-text {
  font-size: 26rpx;
  color: var(--text-tertiary);
}
