<wxs module="ft">
  module.exports.hasSite = function(sites, id) {
    return sites && sites.indexOf(id) > -1;
  };
  module.exports.vehicleName = function(vehicles, vid) {
    if (!vid) return '选择车辆';
    for (var i = 0; i < vehicles.length; i++) {
      if (vehicles[i].id === vid) return vehicles[i].name;
    }
    return '选择车辆';
  };
  module.exports.vehicleIdx = function(vehicles, vid) {
    if (!vid) return -1;
    for (var i = 0; i < vehicles.length; i++) {
      if (vehicles[i].id === vid) return i;
    }
    return -1;
  };
  module.exports.daySiteCount = function(day) {
    return day.sites ? day.sites.length : 0;
  };
  module.exports.partSelected = function(parts, id) {
    if (!parts) return false;
    for (var i = 0; i < parts.length; i++) {
      if (parts[i].part_id == id) return true;
    }
    return false;
  };
  module.exports.pageTitle = function(isChange, editId, scheduleType) {
    if (isChange) return '计划变更';
    if (!editId) return '新建计划';
    return '编辑计划';
  };
</wxs>

<view class="pe-page" wx:if="{{detailState === 'ready' && loaded}}">

  <!-- 自定义导航栏（sticky 固定 + 返回键 + compact 标题） -->
  <view class="pe-nav-wrap">
    <custom-navbar showBorder="{{true}}">
      <view slot="left" class="pe-nav-left-group">
        <view class="pe-nav-back" data-action="back" bindtap="onNavBack">
          <view class="pe-nav-back-icon"></view>
        </view>
        <text class="pe-nav-title">{{ft.pageTitle(isChange, editId, scheduleType)}}</text>
      </view>
    </custom-navbar>
  </view>

  <!-- 原因 / 失败提示区 -->
  <view class="pe-banner-group">
    <!-- 变更原因 -->
    <view class="pe-banner pe-banner-info" wx:if="{{isChange}}">
      <text class="pe-banner-title">变更原因</text>
      <text class="pe-banner-text">{{changeReason || '—'}}</text>
      <text class="pe-banner-sub">完成修改后需提交管理员审核</text>
    </view>

    <!-- 退回原因 -->
    <view class="pe-banner pe-banner-warning" wx:if="{{rejectReason}}">
      <text class="pe-banner-title">退回原因</text>
      <text class="pe-banner-text">{{rejectReason}}</text>
    </view>

    <!-- 提交失败 -->
    <view class="pe-banner pe-banner-error" wx:if="{{submitError}}">
      <text class="pe-banner-title">提交未完成</text>
      <text class="pe-banner-text">{{submitError}}</text>
    </view>

    <!-- 草稿保存失败 -->
    <view class="pe-banner pe-banner-error" wx:if="{{draftSaveError}}">
      <text class="pe-banner-title">草稿未保存</text>
      <text class="pe-banner-text">{{draftSaveError}}</text>
    </view>
  </view>

  <!-- Section 1: 巡检频次 + 周期范围 -->
  <view class="pe-card">
    <text class="pe-section-title">巡检频次</text>
    <view class="pe-segmented">
      <view class="pe-seg-item {{scheduleType === 'weekly' ? 'active' : ''}}" data-type="weekly" bindtap="onFreqChip" wx:if="{{!editId}}">周检</view>
      <view class="pe-seg-item {{scheduleType === 'monthly' ? 'active' : ''}}" data-type="monthly" bindtap="onFreqChip" wx:if="{{!editId}}">月检</view>
      <view class="pe-seg-item {{scheduleType === 'quarterly' ? 'active' : ''}}" data-type="quarterly" bindtap="onFreqChip" wx:if="{{!editId}}">季检</view>
      <view class="pe-seg-item {{scheduleType === 'yearly' ? 'active' : ''}}" data-type="yearly" bindtap="onFreqChip" wx:if="{{!editId}}">年检</view>
      <view class="pe-seg-item active" wx:if="{{editId}}">{{scheduleType === 'weekly' ? '周检' : (scheduleType === 'monthly' ? '月检' : (scheduleType === 'quarterly' ? '季检' : '年检'))}}</view>
    </view>

    <text class="pe-section-title pe-section-title-gap">周期范围</text>
    <view class="pe-list-group">
      <picker mode="date" value="{{periodStart}}" bindchange="onPeriodStart">
        <view class="pe-list-row">
          <text class="pe-list-row-label">开始日期</text>
          <view class="pe-list-row-right">
            <text class="pe-list-row-value">{{periodStart}}</text>
            <view class="pe-chevron"></view>
          </view>
        </view>
      </picker>
      <picker mode="date" value="{{periodEnd}}" bindchange="onPeriodEnd">
        <view class="pe-list-row pe-list-row-last">
          <text class="pe-list-row-label">结束日期</text>
          <view class="pe-list-row-right">
            <text class="pe-list-row-value">{{periodEnd}}</text>
            <view class="pe-chevron"></view>
          </view>
        </view>
      </picker>
    </view>
  </view>

  <!-- 添加作业日（月/季/年检） -->
  <view class="pe-card" wx:if="{{scheduleType !== 'weekly'}}">
    <view class="pe-add-day-row">
      <picker mode="date" value="{{periodStart}}" start="{{periodStart}}" end="{{periodEnd}}" bindchange="onAddDay">
        <view class="pe-add-day-btn">
          <text class="pe-add-day-plus">＋</text>
          <text>添加作业日</text>
        </view>
      </picker>
      <text class="pe-add-day-count">已选 {{days.length}} 天</text>
    </view>
  </view>

  <!-- Section 2: 计划用车 -->
  <view class="pe-card">
    <text class="pe-section-title">计划用车</text>
    <view class="pe-list-group">
      <view class="pe-list-row" data-mode="vehicle" bindtap="onVehicleModeSelect">
        <text class="pe-list-row-label">需要用车</text>
        <view class="pe-list-row-right">
          <text class="pe-list-row-suffix" wx:if="{{planVehicleId && !noVehicleRequired}}">{{ft.vehicleName(vehicles, planVehicleId)}}</text>
          <view class="pe-checkmark" wx:if="{{!noVehicleRequired}}"></view>
        </view>
      </view>
      <view class="pe-list-row" data-mode="none" bindtap="onVehicleModeSelect">
        <text class="pe-list-row-label">无需用车</text>
        <view class="pe-list-row-right">
          <view class="pe-checkmark" wx:if="{{noVehicleRequired}}"></view>
        </view>
      </view>
    </view>

    <!-- 车辆选择 -->
    <view class="pe-expand-area" wx:if="{{!noVehicleRequired}}">
      <picker mode="selector" range="{{vehicles}}" range-key="name"
              value="{{ft.vehicleIdx(vehicles, planVehicleId)}}" bindchange="onPlanVehicleChange">
        <view class="pe-list-row pe-list-row-expand">
          <text class="pe-list-row-label pe-list-row-label-sub">选择车辆</text>
          <view class="pe-list-row-right">
            <text class="{{planVehicleId ? 'pe-list-row-value' : 'pe-placeholder'}}">{{ft.vehicleName(vehicles, planVehicleId)}}</text>
            <view class="pe-chevron"></view>
          </view>
        </view>
      </picker>
    </view>

    <!-- 无车原因 -->
    <view class="pe-expand-area" wx:if="{{noVehicleRequired}}">
      <textarea class="pe-textarea" placeholder="请说明无需车辆的具体原因，如站点位于办公区内且可步行到达"
        value="{{vehicleExceptionReason}}" bindinput="onVehicleExceptionReason" maxlength="200" />
    </view>
  </view>

  <!-- Section 3: 作业日与站点 -->
  <view class="pe-card pe-day-card" wx:for="{{days}}" wx:key="date" wx:for-item="day" wx:for-index="di">
    <view class="pe-day-header">
      <view class="pe-day-date-group">
        <text class="pe-day-date">{{day.date}}</text>
        <text class="pe-day-weekday">{{day.weekday_cn}}</text>
      </view>
      <view class="pe-day-actions">
        <view class="pe-day-count" wx:if="{{ft.daySiteCount(day)}}">{{ft.daySiteCount(day)}}站</view>
        <text class="pe-day-action" data-day-idx="{{di}}" bindtap="onToggleAll">{{day.allSitesSelected ? '全不选' : '全选'}}</text>
        <text class="pe-day-action pe-day-action-danger" wx:if="{{scheduleType !== 'weekly'}}" data-date="{{day.date}}" bindtap="onRemoveDay">移除</text>
      </view>
    </view>

    <view class="pe-day-warning" wx:if="{{day.warning_text}}">
      <text>{{day.warning_text}}</text>
    </view>

    <text class="pe-sub-title">选择站点</text>
    <view class="pe-chip-group">
      <view class="pe-chip {{ft.hasSite(day.sites, site.id) ? 'pe-chip-on' : ''}}"
            wx:for="{{mySites}}" wx:key="id" wx:for-item="site"
            data-day-idx="{{di}}" data-site-id="{{site.id}}" bindtap="onToggleSite">
        {{site.name}}
        <text class="pe-chip-suffix" wx:if="{{siteScores[site.id]}}">·{{siteScores[site.id]}}</text>
      </view>
    </view>

    <!-- 已选站点的检查项 -->
    <block wx:for="{{day.sites}}" wx:key="*this" wx:for-item="selectedSiteId">
      <text class="pe-sub-title pe-sub-title-group">{{siteNameById[selectedSiteId]}}</text>
      <view class="pe-chip-group pe-chip-group-sm" wx:if="{{inspectionItemOptions[selectedSiteId].length}}">
        <view class="pe-chip pe-chip-sm {{ft.hasSite(day.inspection_items[selectedSiteId], item.id) ? 'pe-chip-on' : ''}}"
              wx:for="{{inspectionItemOptions[selectedSiteId]}}" wx:key="id" wx:for-item="item"
              data-day-idx="{{di}}" data-site-id="{{selectedSiteId}}" data-item-id="{{item.id}}" bindtap="onToggleInspectionItem">{{item.item_name}}</view>
      </view>
      <text class="pe-empty-line" wx:elif="{{inspectionItemsState === 'loading'}}">正在读取适用检查项…</text>
      <view class="pe-retry-line" wx:elif="{{inspectionItemsState === 'unavailable'}}"
            bindtap="loadInspectionItems">{{inspectionItemsError}}，点击重试</view>
      <text class="pe-empty-line" wx:else>本站当前设备没有适用检查项</text>
    </block>

    <!-- 当日备注 -->
    <textarea class="pe-textarea pe-textarea-sm" placeholder="当日备注（选填）" value="{{day.notes}}"
      data-day-idx="{{di}}" bindinput="onDayNotes" maxlength="200" />
  </view>

  <!-- 无作业日空态 -->
  <view class="pe-card" wx:if="{{scheduleType !== 'weekly' && !days.length}}">
    <view class="pe-empty-inline">
      <view class="pe-empty-icon">
        <view class="pe-empty-calendar"></view>
      </view>
      <text class="pe-empty-title">暂无作业日</text>
      <text class="pe-empty-desc">点击上方"添加作业日"开始排程</text>
    </view>
  </view>

  <!-- 未覆盖站点提示（站点编辑完成后自然遇到） -->
  <view class="pe-card" wx:if="{{coverageWarning}}">
    <view class="pe-banner pe-banner-warning">
      <text class="pe-banner-title">未覆盖站点</text>
      <text class="pe-banner-text">{{coverageWarning}}</text>
    </view>
  </view>

  <!-- Section 4: 备件配置 -->
  <view class="pe-card">
    <view class="pe-section-header">
      <text class="pe-section-title">备件配置</text>
      <text class="pe-section-sub">按站点实际情况选择</text>
    </view>
    <view class="pe-chip-group" wx:if="{{partsInventory.length}}">
      <view class="pe-chip {{ft.partSelected(selectedParts, part.id) ? 'pe-chip-on' : ''}}"
            wx:for="{{partsInventory}}" wx:key="id" wx:for-item="part"
            data-part-id="{{part.id}}" bindtap="onTogglePart">
        {{part.name}}
        <text class="pe-chip-suffix">· 库存{{part.quantity}}{{part.unit}}</text>
      </view>
    </view>
    <text class="pe-empty-line" wx:elif="{{partsInventoryState === 'loading'}}">正在读取可用备件库存…</text>
    <view class="pe-retry-line" wx:elif="{{partsInventoryState === 'unavailable'}}" bindtap="loadPartsInventory">
      暂时无法读取备件库存，<text class="pe-retry-link">点击重试</text>
    </view>
    <view class="pe-empty-inline-sm" wx:else>
      <text class="pe-empty-line">当前没有可用备件库存</text>
      <text class="pe-empty-sub">可先保存计划，提交后按需发起备件申请</text>
    </view>
  </view>

  <!-- Section 5: 计划备注 -->
  <view class="pe-card">
    <text class="pe-section-title">备注</text>
    <textarea class="pe-textarea" placeholder="补充说明，如特殊安排、注意事项等" value="{{remarks}}" bindinput="onRemarks" maxlength="200" />
  </view>

  <!-- 漏站例外说明（仅周检） -->
  <view class="pe-card" wx:if="{{scheduleType === 'weekly'}}">
    <text class="pe-section-title">漏站例外说明</text>
    <textarea class="pe-textarea" placeholder="如遇封路、站点停运或应急调度，请说明原因" value="{{coverageExceptionReason}}" bindinput="onCoverageExceptionReason" maxlength="200" />
  </view>

  <!-- 排程参考 -->
  <view class="pe-card" wx:if="{{displaySuggestions.length}}">
    <view class="pe-section-header pe-section-header-expand" bindtap="onToggleSchedulingReference">
      <view class="pe-section-header-left">
        <text class="pe-section-title">排程参考</text>
        <text class="pe-section-sub">{{referenceSummary}}</text>
      </view>
      <view class="pe-toggle-row">
        <text class="pe-toggle-text">{{referenceExpanded ? '收起' : '展开'}} {{displaySuggestions.length}}条</text>
        <view class="pe-chevron pe-chevron-rotate-{{referenceExpanded}}"></view>
      </view>
    </view>
    <view class="pe-suggest-list" wx:if="{{referenceExpanded}}">
      <view class="pe-suggest-item" wx:for="{{displaySuggestions}}" wx:key="index">
        <view class="pe-suggest-dot pe-suggest-dot-{{item.level === 'high' ? 'error' : (item.level === 'medium' ? 'warning' : 'info')}}"></view>
        <text class="pe-suggest-text">{{item.text}}</text>
      </view>
    </view>
  </view>

  <!-- 底部安全区占位 -->
  <view class="pe-bottom-spacer"></view>

  <!-- 底部固定操作栏 -->
  <view class="pe-bottom-bar">
    <button class="pe-btn pe-btn-ghost" bindtap="onSaveDraft" disabled="{{submitting}}">存草稿</button>
    <button class="pe-btn pe-btn-primary" bindtap="onSubmit" loading="{{submitting}}" disabled="{{submitting}}">{{isChange ? '提交变更审核' : '提交审批'}}</button>
  </view>
</view>

<!-- 加载骨架屏 -->
<view class="pe-page pe-page-loading" wx:if="{{detailState === 'loading'}}">
  <view class="pe-nav-wrap">
    <custom-navbar showBorder="{{true}}">
      <view slot="left" class="pe-nav-left-group">
        <view class="pe-nav-back" data-action="back" bindtap="onNavBack">
          <view class="pe-nav-back-icon"></view>
        </view>
        <text class="pe-nav-title">{{editId ? '编辑计划' : '新建计划'}}</text>
      </view>
    </custom-navbar>
  </view>
  <view class="pe-skeleton-group">
    <view class="pe-card pe-skeleton-card">
      <view class="pe-skeleton-line pe-skeleton-line-sm"></view>
      <view class="pe-skeleton-line pe-skeleton-line-lg"></view>
      <view class="pe-skeleton-line pe-skeleton-line-md"></view>
      <view class="pe-skeleton-line pe-skeleton-line-md"></view>
    </view>
    <view class="pe-card pe-skeleton-card">
      <view class="pe-skeleton-line pe-skeleton-line-sm"></view>
      <view class="pe-skeleton-line pe-skeleton-line-lg"></view>
    </view>
    <view class="pe-card pe-skeleton-card">
      <view class="pe-skeleton-line pe-skeleton-line-sm"></view>
      <view class="pe-skeleton-line pe-skeleton-line-md"></view>
      <view class="pe-skeleton-line pe-skeleton-line-lg"></view>
    </view>
  </view>
</view>

<!-- 详情加载失败 -->
<view class="pe-page" wx:if="{{detailState === 'error'}}">
  <view class="pe-nav-wrap">
    <custom-navbar showBorder="{{true}}">
      <view slot="left" class="pe-nav-left-group">
        <view class="pe-nav-back" data-action="back" bindtap="onNavBack">
          <view class="pe-nav-back-icon"></view>
        </view>
        <text class="pe-nav-title">编辑计划</text>
      </view>
    </custom-navbar>
  </view>
  <view class="pe-card">
    <view class="pe-banner pe-banner-error">
      <text class="pe-banner-title">计划详情加载失败</text>
      <text class="pe-banner-text">{{detailLoadError}}</text>
    </view>
    <button class="pe-btn pe-btn-primary" bindtap="onRetryLoadExisting">重新加载</button>
  </view>
</view>
