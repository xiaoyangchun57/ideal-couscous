<wxs module="ft">
  module.exports.hasSite = function(sites, id) {
    return sites && sites.indexOf(id) > -1;
  };
  module.exports.vehicleName = function(vehicles, vid) {
    if (!vid) return '选择车辆';
    for (var i = 0; i < vehicles.length; i++) {
      if (vehicles[i].id === vid) return vehicles[i].name;
    }
    return '选择车辆';
  };
  module.exports.vehicleIdx = function(vehicles, vid) {
    if (!vid) return -1;
    for (var i = 0; i < vehicles.length; i++) {
      if (vehicles[i].id === vid) return i;
    }
    return -1;
  };
  module.exports.daySiteCount = function(day) {
    return day.sites ? day.sites.length : 0;
  };
  module.exports.partSelected = function(parts, id) {
    if (!parts) return false;
    for (var i = 0; i < parts.length; i++) {
      // WXS 不提供 Number() 全局构造器；此处用宽松比较兼容 dataset 的字符串 id。
      if (parts[i].part_id == id) return true;
    }
    return false;
  };
</wxs>

<view class="page" wx:if="{{loaded}}">
  <!-- 变更提示 -->
  <view class="change-banner" wx:if="{{isChange}}">
    <text class="change-banner-tx">正在变更已批准计划（原因：{{changeReason || '—'}}），提交后需重新审核</text>
  </view>

  <view class="coverage-warning" wx:if="{{coverageWarning}}">
    <text class="risk-title">需处理：未覆盖站点</text>
    <text class="risk-text">{{coverageWarning}}</text>
  </view>

  <!-- 周期信息 + 频次选择 -->
  <view class="period-bar">
    <view class="period-text">
      <picker mode="date" value="{{periodStart}}" bindchange="onPeriodStart"><text>{{periodStart}}</text></picker>
      <text> ~ </text>
      <picker mode="date" value="{{periodEnd}}" bindchange="onPeriodEnd"><text>{{periodEnd}}</text></picker>
    </view>
    <picker mode="selector" range="{{scheduleTypeOptions}}" value="0" bindchange="onTypeChange" disabled="{{!!editId}}">
      <view class="type-picker"><text class="tag tag-brand">{{scheduleType === 'weekly' ? '周检' : (scheduleType === 'monthly' ? '月检' : (scheduleType === 'quarterly' ? '季检' : '年检'))}}</text><text class="vehicle-arrow" wx:if="{{!editId}}">▾</text></view>
    </picker>
  </view>

  <!-- 月、季、年只选择实际执行日期；周检日期由周期自动生成。 -->
  <view class="add-day-bar" wx:if="{{scheduleType !== 'weekly'}}">
    <picker mode="date" value="{{periodStart}}" start="{{periodStart}}" end="{{periodEnd}}" bindchange="onAddDay">
      <view class="add-day-btn">＋ 选择执行日期</view>
    </picker>
    <text class="add-day-hint">已选择 {{days.length}} 天</text>
  </view>

  <view class="card template-card" wx:if="{{templateContext.length}}">
    <view class="suggest-head">
      <text class="suggest-title">本周期执行模板</text>
      <text class="suggest-count">审批后自动生成检查项</text>
    </view>
    <view class="template-item" wx:for="{{templateContext}}" wx:key="index">
      <text class="template-site">{{item.site_name}}</text>
      <text class="template-name">{{item.template_name}} · {{item.item_count}} 项</text>
    </view>
  </view>

  <!-- 智能建议 -->
  <view class="card suggest-card" wx:if="{{suggestions.length}}">
    <view class="suggest-head">
      <text class="suggest-title">智能建议</text>
      <text class="suggest-count">{{suggestions.length}} 条</text>
    </view>
    <view class="suggest-item" wx:for="{{suggestions}}" wx:key="index">
      <view class="dot dot-{{item.level === 'high' ? 'red' : (item.level === 'medium' ? 'orange' : 'blue')}}"></view>
      <text class="suggest-text">{{item.text}}</text>
    </view>
  </view>

  <view class="card vehicle-policy-card">
    <view class="vehicle-policy-row">
      <view class="vehicle-policy-copy">
        <text class="resource-title">计划用车</text>
        <text class="vehicle-policy-hint">有巡检站点的日期必须安排车辆</text>
      </view>
      <switch checked="{{noVehicleRequired}}" bindchange="onNoVehicleRequired" color="#1677ff" />
    </view>
    <text class="vehicle-policy-switch-label">本计划无需用车</text>
    <view class="vehicle-row" wx:if="{{!noVehicleRequired}}">
      <text class="vehicle-label">计划车辆</text>
      <picker mode="selector" range="{{vehicles}}" range-key="name"
              value="{{ft.vehicleIdx(vehicles, planVehicleId)}}" bindchange="onPlanVehicleChange">
        <view class="vehicle-picker">
          <text class="{{planVehicleId ? 'vehicle-val' : 'vehicle-ph'}}">{{ft.vehicleName(vehicles, planVehicleId)}}</text>
          <text class="vehicle-arrow">▶</text>
        </view>
      </picker>
    </view>
    <textarea wx:if="{{noVehicleRequired}}" class="ta vehicle-exception-input"
      placeholder="请说明无需车辆的具体原因，如站点位于办公区内且可步行到达"
      value="{{vehicleExceptionReason}}" bindinput="onVehicleExceptionReason" maxlength="200" />
  </view>

  <!-- 逐日排程 -->
  <view class="day-card card" wx:for="{{days}}" wx:key="date" wx:for-item="day" wx:for-index="di">
    <view class="day-head">
      <view class="day-label">
        <text class="day-weekday">{{day.weekday_cn}}</text>
        <text class="day-date">{{day.date}}</text>
      </view>
      <view class="day-ops">
        <text class="day-count" wx:if="{{ft.daySiteCount(day)}}">{{ft.daySiteCount(day)}} 站</text>
        <text class="day-all" data-day-idx="{{di}}" bindtap="onToggleAll">全选</text>
        <text class="day-del" wx:if="{{scheduleType !== 'weekly'}}" data-date="{{day.date}}" bindtap="onRemoveDay">移除</text>
      </view>
    </view>

    <view class="day-warning" wx:if="{{day.warning_text}}">
      <text class="risk-title">调整建议</text>
      <text class="risk-text">{{day.warning_text}}</text>
    </view>

    <!-- 站点选择 chips -->
    <view class="site-chips-wrap">
      <view class="chip {{ft.hasSite(day.sites, site.id) ? 'chip-on' : ''}}"
            wx:for="{{mySites}}" wx:key="id" wx:for-item="site"
            data-day-idx="{{di}}" data-site-id="{{site.id}}" bindtap="onToggleSite">
        {{site.name}}
        <text class="chip-score" wx:if="{{siteScores[site.id]}}">·{{siteScores[site.id]}}</text>
      </view>
    </view>

    <view class="inspection-items" wx:for="{{day.sites}}" wx:key="*this" wx:for-item="selectedSiteId">
      <text class="resource-title">适用检查项</text>
      <view class="site-chips-wrap" wx:if="{{inspectionItemOptions[selectedSiteId].length}}">
        <view class="chip {{ft.hasSite(day.inspection_items[selectedSiteId], item.id) ? 'chip-on' : ''}}"
              wx:for="{{inspectionItemOptions[selectedSiteId]}}" wx:key="id" wx:for-item="item"
              data-day-idx="{{di}}" data-site-id="{{selectedSiteId}}" data-item-id="{{item.id}}" bindtap="onToggleInspectionItem">{{item.item_name}}</view>
      </view>
      <text class="resource-empty" wx:elif="{{inspectionItemsState === 'loading'}}">正在读取适用检查项…</text>
      <view class="resource-empty" wx:elif="{{inspectionItemsState === 'unavailable'}}"
            bindtap="loadInspectionItems">{{inspectionItemsError}}，点击重试</view>
      <text class="resource-empty" wx:else>本站当前设备没有适用检查项</text>
    </view>

    <textarea class="ta day-notes" placeholder="当日备注（选填）" value="{{day.notes}}"
      data-day-idx="{{di}}" bindinput="onDayNotes" maxlength="200" />

  </view>

  <!-- 出车资源：车辆和备件在计划层统一确认；同站未结工单自动关联 -->
  <view class="card resource-card">
    <view class="resource-head">
      <text class="resource-title">出车备件</text>
      <text class="resource-hint">按需勾选，审批通过后预留</text>
    </view>
    <view class="site-chips-wrap" wx:if="{{partsInventory.length}}">
      <view class="chip {{ft.partSelected(selectedParts, part.id) ? 'chip-on' : ''}}"
            wx:for="{{partsInventory}}" wx:key="id" wx:for-item="part"
            data-part-id="{{part.id}}" bindtap="onTogglePart">
        {{part.name}} · 库存{{part.quantity}}{{part.unit}}
      </view>
    </view>
    <text class="resource-empty" wx:elif="{{partsInventoryState === 'loading'}}">正在读取可用备件库存…</text>
    <view class="resource-empty" wx:elif="{{partsInventoryState === 'unavailable'}}" bindtap="loadPartsInventory">
      <text>暂时无法读取备件库存</text><text class="resource-retry">点击重试</text>
    </view>
    <view class="resource-empty" wx:else>
      <text>当前没有可用备件库存</text><text class="resource-next">可先保存计划，提交后按需发起备件申请</text>
    </view>
    <text class="resource-auto">所选站点的未结工单将在提交时自动关联，无需重复填写</text>
  </view>

  <!-- 长周期尚未选择实际执行日期 -->
  <view class="empty" wx:if="{{scheduleType !== 'weekly' && !days.length}}">
    <view class="empty-circle"></view>
    <text class="empty-tx">点击上方“选择执行日期”开始排程</text>
  </view>

  <!-- 备注 -->
  <view class="card remarks-card">
    <text class="remarks-label">备注（选填）</text>
    <textarea class="ta" placeholder="补充说明，如特殊安排、注意事项等" value="{{remarks}}" bindinput="onRemarks" maxlength="200" />
  </view>

  <view class="card remarks-card" wx:if="{{scheduleType === 'weekly'}}">
    <text class="remarks-label">漏站例外说明（仅未全覆盖时必填）</text>
    <textarea class="ta" placeholder="如遇封路、站点停运或应急调度，请说明原因" value="{{coverageExceptionReason}}" bindinput="onCoverageExceptionReason" maxlength="200" />
  </view>

  <view class="coverage-warning" wx:if="{{submitError}}">
    <text class="risk-title">提交未完成</text>
    <text class="risk-text">{{submitError}}</text>
  </view>

  <!-- 底部操作 -->
  <view class="bottom-bar">
    <button class="btn-ghost bottom-btn" bindtap="onSaveDraft" disabled="{{submitting}}">存草稿</button>
    <button class="btn-primary bottom-btn" bindtap="onSubmit" loading="{{submitting}}" disabled="{{submitting}}">{{isChange ? '提交变更' : '提交审批'}}</button>
  </view>
</view>
