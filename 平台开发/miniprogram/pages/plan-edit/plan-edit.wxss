/* ===== 计划编辑页（重设计版） ===== */

.pe-page {
  min-height: 100vh;
  background: var(--color-background);
  padding-bottom: calc(env(safe-area-inset-bottom) + 200rpx);
}

/* ===== Banner 组 ===== */

.pe-banner-group {
  padding: 20rpx 32rpx 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.pe-banner {
  border-radius: var(--radius-xl);
  padding: 24rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.pe-banner-info { background: var(--color-info-surface); }
.pe-banner-warning { background: var(--color-warning-surface); }
.pe-banner-error { background: var(--color-error-surface); }

.pe-banner-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.pe-banner-icon-wrap {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.pe-banner-icon-error {
  background: var(--color-error);
}

.pe-banner-icon-dot {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-error-foreground);
  line-height: 1;
}

.pe-banner-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.pe-banner-title {
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.4;
}

.pe-banner-info .pe-banner-title { color: var(--color-info); }
.pe-banner-warning .pe-banner-title { color: var(--color-warning); }
.pe-banner-error .pe-banner-title { color: var(--color-error); }

.pe-banner-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.pe-banner-sub {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  line-height: 1.4;
  margin-top: 4rpx;
}

.pe-banner-btn {
  margin-top: 16rpx;
  align-self: flex-end;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 28rpx;
  border-radius: var(--radius-md);
  font-size: 26rpx;
  font-weight: 500;
  background: transparent;
  border: none;
  min-height: 0;
}

.pe-banner-btn::after { border: none; }

.pe-banner-btn-error {
  color: var(--color-error);
  background: var(--color-error-surface);
}

/* ===== 卡片 ===== */

.pe-card {
  background: var(--color-card);
  border-radius: var(--radius-xl);
  margin: 20rpx 32rpx 0;
  padding: 28rpx;
}

/* Section 标题（13px/400/text-tertiary） */
.pe-section-title {
  font-size: 26rpx;
  font-weight: 400;
  color: var(--color-text-tertiary);
  line-height: 1.4;
  display: block;
}

.pe-section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.pe-section-header-expand {
  margin-bottom: 0;
  cursor: pointer;
}

.pe-section-header-left {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.pe-section-sub {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  font-weight: 400;
}

/* 必填星号 */
.pe-required-mark {
  color: var(--color-error);
  font-size: 26rpx;
  margin-left: 2rpx;
}

/* ===== 区块①：周期与用车 ===== */

.pe-freq-tag {
  padding: 4rpx 16rpx;
  background: var(--color-info-surface);
  border-radius: var(--radius-xs);
  flex-shrink: 0;
}

.pe-freq-tag-tx {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--color-info);
  line-height: 1.4;
}

/* 列表组 */
.pe-list-group {
  background: var(--color-muted);
  border-radius: var(--radius-md);
  overflow: hidden;
}

.pe-list-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  border-bottom: 0.5rpx solid var(--color-divider);
}

.pe-list-row-last {
  border-bottom: none;
}

.pe-list-row-label {
  font-size: 28rpx;
  color: var(--color-text-primary);
  flex-shrink: 0;
}

.pe-list-row-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
  flex-shrink: 0;
}

.pe-list-row-value {
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.pe-chevron {
  width: 12rpx;
  height: 12rpx;
  border-right: 2.5rpx solid var(--palette-gray-400);
  border-top: 2.5rpx solid var(--palette-gray-400);
  transform: rotate(45deg);
  flex-shrink: 0;
  transition: transform 0.2s ease;
}

.pe-chevron-rotate-true {
  transform: rotate(135deg);
}

/* 用车选择区 */
.pe-vehicle-section {
  margin-top: 28rpx;
}

.pe-sub-title {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
  display: block;
}

.pe-sub-title-top {
  margin-bottom: 16rpx;
}

/* 单选按钮组 */
.pe-radio-group {
  display: flex;
  gap: 24rpx;
  margin-bottom: 20rpx;
}

.pe-radio-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  cursor: pointer;
}

.pe-radio-dot {
  width: 36rpx;
  height: 36rpx;
  border: 2.5rpx solid var(--color-icon-tertiary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.15s ease;
}

.pe-radio-dot-inner {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: transparent;
  transition: all 0.15s ease;
}

.pe-radio-active .pe-radio-dot {
  border-color: var(--color-primary);
}

.pe-radio-active .pe-radio-dot-inner {
  background: var(--color-primary);
}

.pe-radio-label {
  font-size: 28rpx;
  color: var(--color-text-primary);
  line-height: 1;
}

/* 展开区域 */
.pe-expand-area {
  margin-top: 4rpx;
}

.pe-list-row-expand {
  background: var(--color-muted);
  border-radius: var(--radius-md);
  height: 80rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  border: 2rpx solid transparent;
  transition: border-color 0.15s ease;
}

.pe-list-row-expand picker {
  width: 100%;
  display: block;
}

.pe-row-error {
  border-color: var(--color-error);
}

.pe-expand-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}

.pe-expand-value {
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.pe-expand-placeholder {
  font-size: 28rpx;
  color: var(--color-text-tertiary);
}

/* 历史只读原因（无车/漏站等历史说明，仅展示不可编辑） */
.pe-historical-reason {
  background: var(--color-muted);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.pe-historical-reason-label {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  font-weight: 500;
  line-height: 1.4;
}

.pe-historical-reason-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

/* 字段错误（原位提示） */
.pe-field-error {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 10rpx;
}

.pe-field-error--sites {
  margin-top: 8rpx;
  padding: 0 2rpx;
}

.pe-error-icon {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: var(--color-error);
  position: relative;
  flex-shrink: 0;
}

.pe-error-icon::before {
  content: '!';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -55%);
  font-size: 18rpx;
  font-weight: 700;
  color: var(--color-error-foreground);
  line-height: 1;
}

.pe-error-text {
  font-size: 24rpx;
  color: var(--color-error);
  line-height: 1.4;
}

/* ===== 添加作业日 ===== */

.pe-add-day-card {
  margin: 20rpx 32rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4rpx;
}

.pe-add-day-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  cursor: pointer;
}

.pe-add-day-plus {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--color-primary-surface);
  color: var(--color-primary);
  font-size: 32rpx;
  font-weight: 400;
  line-height: 36rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pe-add-day-tx {
  font-size: 28rpx;
  color: var(--color-primary);
  font-weight: 500;
}

.pe-add-day-count {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
}

/* ===== 区块②：作业日与站点 ===== */

.pe-sites-section {
  padding: 28rpx 32rpx 0;
}

.pe-sites-title {
  margin-bottom: 4rpx;
}

/* 作业日卡片 */
.pe-day-card {
  padding-top: 24rpx;
}

.pe-day-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.pe-day-date-group {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.pe-day-date {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.pe-day-weekday {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.pe-day-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.pe-day-count {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  background: var(--color-type-bg);
  padding: 4rpx 14rpx;
  border-radius: var(--radius-xs);
  font-weight: 500;
}

.pe-day-link {
  font-size: 26rpx;
  color: var(--color-primary);
  font-weight: 500;
  cursor: pointer;
}

.pe-day-link--danger {
  color: var(--color-error);
}

/* 当日警告 */
.pe-day-warning {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  background: var(--color-warning-surface);
  border-radius: var(--radius-md);
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
}

.pe-warning-icon {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: var(--color-warning);
  position: relative;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.pe-warning-icon::before {
  content: '!';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -55%);
  font-size: 16rpx;
  font-weight: 700;
  color: var(--color-warning-foreground);
  line-height: 1;
}

.pe-warning-tx {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
  flex: 1;
}

.pe-route-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 4rpx;
}

.pe-route-order {
  color: var(--color-text-primary);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.45;
}

.pe-route-meta {
  color: var(--color-text-tertiary);
  font-size: 22rpx;
  line-height: 1.4;
}

/* Chip 组 */
.pe-chip-group {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.pe-chip-group-sm {
  gap: 12rpx;
}

.pe-chip-group--inspect {
  margin-top: 12rpx;
}

.pe-chip {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  background: var(--color-type-bg);
  border-radius: var(--radius-md);
  font-size: 26rpx;
  color: var(--color-text-secondary);
  font-weight: 400;
  line-height: 1.4;
  transition: all 0.15s ease;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pe-chip-sm {
  padding: 10rpx 20rpx;
  font-size: 24rpx;
}

.pe-chip-on {
  background: var(--color-primary);
  color: var(--color-primary-foreground);
  font-weight: 500;
}

.pe-chip-suffix {
  font-size: 22rpx;
  color: inherit;
  opacity: 0.7;
  margin-left: 2rpx;
}

.pe-chip-on .pe-chip-suffix {
  opacity: 0.85;
}

/* 检查项站点块 */
.pe-inspect-site-block {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 0.5rpx solid var(--color-divider);
}

.pe-inspect-site-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 14rpx;
  display: block;
  line-height: 1.4;
  word-break: break-all;
}

/* 检查项分组头 */
.pe-inspect-group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  cursor: pointer;
}

.pe-inspect-group-head--optional {
  background: var(--color-type-bg);
  border-radius: var(--radius-md);
  padding: 16rpx 20rpx;
  margin-top: 12rpx;
  transition: opacity 0.15s ease;
}

.pe-inspect-group-head--optional:active {
  opacity: 0.85;
}

/* 展开态：底部圆角收平，与下方内容衔接 */
.pe-inspect-group-head--optional-expanded {
  border-bottom-left-radius: 0;
  border-bottom-right-radius: 0;
}

.pe-inspect-group-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
  flex: 1;
}

.pe-inspect-caret {
  width: 12rpx;
  height: 12rpx;
  border-right: 2.5rpx solid var(--palette-gray-400);
  border-top: 2.5rpx solid var(--palette-gray-400);
  flex-shrink: 0;
  transition: transform 0.2s ease;
}

.pe-inspect-caret-right {
  transform: rotate(45deg);
}

.pe-inspect-caret-down {
  transform: rotate(135deg);
}

.pe-inspect-group-label {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text-primary);
  flex-shrink: 0;
}

.pe-inspect-group-tag {
  padding: 2rpx 12rpx;
  border-radius: var(--radius-xs);
  flex-shrink: 0;
}

.pe-tag-default {
  background: var(--color-type-bg);
}

.pe-tag-default .pe-inspect-group-tag-tx {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  font-weight: 500;
  line-height: 1.4;
}

.pe-tag-optional {
  background: var(--color-info-surface);
}

.pe-tag-optional .pe-inspect-group-tag-tx {
  font-size: 20rpx;
  color: var(--color-info);
  font-weight: 500;
  line-height: 1.4;
}

.pe-inspect-group-right {
  flex-shrink: 0;
  margin-left: 12rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

/* 展开内容区域 */
.pe-inspect-group-body {
  padding-top: 4rpx;
}

.pe-inspect-group-body--optional {
  background: var(--color-type-bg);
  border-bottom-left-radius: var(--radius-md);
  border-bottom-right-radius: var(--radius-md);
  padding: 0 20rpx 16rpx;
  margin-bottom: 4rpx;
}

.pe-inspect-group-body--optional .pe-chip-group--inspect {
  margin-top: 0;
}

/* 分组头右侧：到期小标签 */
.pe-inspect-due-tag {
  display: inline-flex;
  align-items: center;
  padding: 3rpx 12rpx;
  background: var(--color-warning-surface);
  border-radius: var(--radius-xs);
  flex-shrink: 0;
}

.pe-inspect-due-tag-tx {
  font-size: 20rpx;
  font-weight: 500;
  color: var(--color-warning);
  line-height: 1.4;
  white-space: nowrap;
}

/* 到期提醒（默认分组展开内的样式，保留供其他场景复用） */
.pe-inspect-due {
  margin: 4rpx 0 8rpx;
  padding-left: 22rpx;
}

.pe-inspect-due-tx {
  font-size: 22rpx;
  color: var(--color-warning);
  line-height: 1.4;
}

/* 加载 / 重试 / 空态（检查项级） */
.pe-inspect-loading {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 0;
}

.pe-inspect-loading-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  border: 2.5rpx solid var(--color-icon-tertiary);
  border-top-color: transparent;
  animation: pe-spin 0.8s linear infinite;
  flex-shrink: 0;
}

@keyframes pe-spin {
  to { transform: rotate(360deg); }
}

.pe-inspect-loading-tx {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  line-height: 1.4;
}

.pe-inspect-retry {
  display: flex;
  align-items: baseline;
  padding: 14rpx 0;
  cursor: pointer;
}

.pe-inspect-retry-tx {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.4;
}

.pe-inspect-retry-link {
  font-size: 26rpx;
  color: var(--color-primary);
  font-weight: 500;
  line-height: 1.4;
}

.pe-inspect-empty {
  padding: 14rpx 0;
}

.pe-inspect-empty-tx {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  line-height: 1.4;
}

/* 当日备注 */
.pe-day-notes {
  margin-top: 20rpx;
}

/* ===== 文本域 ===== */

.pe-textarea {
  width: 100%;
  min-height: 180rpx;
  background: var(--color-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--input-radius);
  padding: 24rpx;
  font-size: 28rpx;
  color: var(--color-text-primary);
  box-sizing: border-box;
  line-height: 1.5;
  transition: border-color 0.15s ease;
}

.pe-textarea-sm {
  min-height: 120rpx;
}

.pe-textarea--error {
  border-color: var(--color-error);
}

/* ===== 无作业日空态 ===== */

.pe-empty-day-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 28rpx;
  gap: 12rpx;
}

.pe-empty-icon {
  width: 128rpx;
  height: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}

.pe-empty-calendar {
  width: 72rpx;
  height: 80rpx;
  border: 3rpx solid var(--color-icon-tertiary);
  border-radius: 10rpx;
  position: relative;
}

.pe-empty-calendar::before {
  content: '';
  position: absolute;
  top: 12rpx;
  left: 0;
  right: 0;
  height: 3rpx;
  background: var(--color-icon-tertiary);
}

.pe-empty-calendar::after {
  content: '';
  position: absolute;
  top: 28rpx;
  left: 12rpx;
  right: 12rpx;
  bottom: 12rpx;
  background-image:
    linear-gradient(var(--color-icon-tertiary) 1rpx, transparent 1rpx),
    linear-gradient(90deg, var(--color-icon-tertiary) 1rpx, transparent 1rpx);
  background-size: 14rpx 14rpx;
  opacity: 0.3;
}

.pe-empty-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--color-text-secondary);
  line-height: 1.4;
}

.pe-empty-desc {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  line-height: 1.5;
}

/* ===== 区块③：漏站例外 ===== */

.pe-coverage-card {
  /* 标准卡片样式 */
}

.pe-coverage-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.pe-coverage-badge {
  padding: 4rpx 16rpx;
  border-radius: var(--radius-xs);
  flex-shrink: 0;
}

.pe-coverage-badge--warning {
  background: var(--color-warning-surface);
}

.pe-coverage-badge--warning .pe-coverage-badge-tx {
  color: var(--color-warning);
}

.pe-coverage-badge--ok {
  background: var(--color-success-surface);
}

.pe-coverage-badge--ok .pe-coverage-badge-tx {
  color: var(--color-success);
}

.pe-coverage-badge-tx {
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.4;
}

/* 未覆盖站点列表 */
.pe-missing-sites {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.pe-missing-name {
  padding: 6rpx 18rpx;
  background: var(--color-warning-surface);
  border-radius: var(--radius-sm);
  font-size: 24rpx;
  color: var(--color-warning);
  font-weight: 500;
  line-height: 1.4;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 全覆盖：轻量行内提示 */
.pe-coverage-ok-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 12rpx 32rpx 0;
  padding: 0 4rpx;
}

.pe-coverage-check {
  width: 28rpx;
  height: 16rpx;
  border-left: 3rpx solid var(--color-success);
  border-bottom: 3rpx solid var(--color-success);
  transform: rotate(-45deg) translateY(-2rpx);
  flex-shrink: 0;
}

.pe-coverage-ok-tx {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  line-height: 1.4;
}

/* ===== 区块④⑤：可折叠卡片（备件 / 备注） ===== */

.pe-collapse-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  cursor: pointer;
}

.pe-collapse-left {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.pe-collapse-count {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  font-weight: 400;
}

.pe-collapse-right {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
}

.pe-collapse-link {
  font-size: 26rpx;
  color: var(--color-primary);
  font-weight: 500;
}

.pe-collapse-body {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 0.5rpx solid var(--color-divider);
}

/* 备件空态 */
.pe-parts-empty {
  padding: 8rpx 0;
}

.pe-parts-empty-tx {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  line-height: 1.4;
}

.pe-parts-empty-sub {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  line-height: 1.5;
  margin-top: 4rpx;
  opacity: 0.8;
}

/* ===== 排程参考 ===== */

.pe-toggle-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
}

.pe-toggle-text {
  font-size: 26rpx;
  color: var(--color-primary);
  font-weight: 500;
}

.pe-suggest-list {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 0.5rpx solid var(--color-divider);
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.pe-suggest-item {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
  gap: 16rpx;
}

.pe-suggest-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 10rpx;
}

.pe-suggest-dot-error { background: var(--color-error); }
.pe-suggest-dot-warning { background: var(--color-warning); }
.pe-suggest-dot-info { background: var(--color-info); }

.pe-suggest-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
  flex: 1;
}

/* ===== 底部操作栏 ===== */

.pe-bottom-spacer {
  height: 200rpx;
}

.pe-bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--color-card);
  border-top: 0.5rpx solid var(--color-divider);
}

.pe-btn {
  flex: 1;
  height: 96rpx;
  border-radius: var(--radius-lg);
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  line-height: 1;
}

.pe-btn::after {
  border: none;
}

.pe-btn-primary {
  flex: 1.5;
  background: var(--color-primary);
  color: var(--color-primary-foreground);
}

.pe-btn-ghost {
  background: var(--color-primary-surface);
  color: var(--color-primary-surface-foreground);
}

.pe-btn[disabled] {
  opacity: 0.4;
}

/* ===== 骨架屏 ===== */

.pe-page-loading {
  padding-bottom: 0;
}

.pe-skeleton-group {
  padding: 20rpx 0;
}

.pe-skeleton-card {
  opacity: 0.6;
}

.pe-skeleton-line {
  height: 28rpx;
  background: var(--color-type-bg);
  border-radius: var(--radius-sm);
  margin-bottom: 16rpx;
  overflow: hidden;
  position: relative;
}

.pe-skeleton-line::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
  animation: pe-skeleton-shimmer 1.5s infinite;
}

@keyframes pe-skeleton-shimmer {
  100% { left: 100%; }
}

.pe-skeleton-line-sm {
  width: 30%;
  height: 22rpx;
  margin-bottom: 20rpx;
}

.pe-skeleton-line-md {
  width: 70%;
}

.pe-skeleton-line-lg {
  width: 100%;
}
