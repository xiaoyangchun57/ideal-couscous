.site-summary { margin: 24rpx 24rpx 16rpx; padding: 28rpx; }
.site-name { font-size: 36rpx; font-weight: 600; color: var(--color-text-primary); line-height: 1.35; }
.site-tags { margin-top: 14rpx; display: flex; flex-wrap: wrap; gap: 12rpx; }
.site-tags .tag { margin-right: 14rpx; }

.task-status { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin: 0 24rpx 20rpx; padding: 20rpx 24rpx; border: 1rpx solid var(--color-primary-surface); border-radius: 16rpx; background: var(--color-primary-surface); }
.task-status-carryover { background: var(--color-warning-surface); border-color: var(--color-warning-surface); }
.task-status-blocked { background: var(--color-muted); border-color: var(--color-divider); }
.task-status-copy { flex: 1; min-width: 0; }
.task-status-title { display: block; color: var(--color-text-primary); font-size: 27rpx; font-weight: 600; }
.task-status-desc { display: block; margin-top: 6rpx; color: var(--color-text-secondary); font-size: 23rpx; line-height: 1.45; }
.task-status-count { flex: 0 0 auto; color: var(--color-warning); font-size: 25rpx; font-weight: 600; }
.rework-status { margin: 0 24rpx 20rpx; padding: 20rpx 24rpx; border: 1rpx solid rgba(250,81,81,.35); border-radius: 12rpx; background: rgba(250,81,81,.06); }
.rework-status-title, .rework-status-desc { display: block; }
.rework-status-title { color: var(--color-error); font-size: 26rpx; font-weight: 600; }
.rework-status-desc { margin-top: 8rpx; color: var(--color-text-secondary); font-size: 23rpx; line-height: 1.45; }

.ops { margin: 0 24rpx; }
.checkin-btn { width: 100%; }
.secondary-ops { display: flex; gap: 16rpx; margin-top: 16rpx; }
.op-btn { flex: 1; margin: 0; font-size: 26rpx; }
.parts-apply-btn { width: 100%; margin: 16rpx 0 0; font-size: 26rpx; }

.site-info-heading {
  margin-top: 36rpx;
  padding-top: 0;
  padding-bottom: 12rpx;
}
.info-card { margin: 24rpx; padding: 8rpx 28rpx; }
.info-row { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 0; }
.info-k { font-size: 27rpx; color: var(--color-text-secondary); }
.info-v { font-size: 27rpx; color: var(--color-text-primary); }

.info-row--action {
  cursor: pointer;
  transition: opacity 0.15s ease;
}

.info-row--hover {
  opacity: 0.6;
}

.info-action {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.info-chevron {
  font-size: 36rpx;
  color: var(--palette-gray-400);
  line-height: 1;
  font-weight: 400;
}
.parts-linked-site { margin-bottom: 16rpx; padding: 16rpx 18rpx; color: var(--color-text-secondary); background: var(--color-muted); border-radius: 10rpx; font-size: 24rpx; }
.field-picker { display: flex; align-items: center; justify-content: space-between; min-height: 76rpx; margin-top: 16rpx; padding: 0 18rpx; color: var(--color-text-primary); background: var(--color-card); border-radius: 10rpx; font-size: 25rpx; }
.parts-route-note { margin: 16rpx 0 4rpx; padding: 16rpx 18rpx; color: var(--color-text-secondary); background: var(--color-muted); border-left: 6rpx solid var(--color-primary); border-radius: 8rpx; font-size: 23rpx; line-height: 1.5; }
.field { margin-top: 18rpx; }
.field-label { display: block; margin-bottom: 10rpx; color: var(--color-text-secondary); font-size: 24rpx; }
.field-input { width: auto; min-height: 76rpx; padding: 18rpx; color: var(--color-text-primary); background: var(--color-card); border-radius: 10rpx; font-size: 26rpx; }
.textarea { min-height: 132rpx; }
.submit-btn { margin-top: 24rpx; }


/* ============================================================
   备件申请 Sheet 样式（与工单/巡检页统一）
   ============================================================ */

.sheet {
  display: flex;
  flex-direction: column;
  max-height: 80vh;
  overflow: hidden;
}

.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 40rpx 20rpx;
  flex-shrink: 0;
}

.sheet-header-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.sheet-header-close {
  min-width: 88rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: -20rpx;
}

.sheet-scroll {
  flex: 1 1 0;
  height: 0;
  min-height: 0;
  overflow: hidden;
}

.sheet-content-spacer {
  height: 40rpx;
}

.sheet-bottom-bar {
  padding: 20rpx 40rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 0.5rpx solid var(--color-divider);
  background: var(--color-card);
  flex-shrink: 0;
}

/* 备件申请 Sheet 底栏：横向双按钮 */
.parts-apply-sheet .sheet-bottom-bar {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
}

.parts-apply-sheet .btn-lg {
  flex: 1;
  width: auto;
  min-height: 88rpx;
  line-height: 88rpx;
  height: auto;
}

.parts-apply-sheet .btn-primary.btn-lg {
  flex: 2;
}

.btn-lg {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: var(--radius-lg);
  font-size: 30rpx;
  font-weight: 500;
  border: none;
}

.btn-lg::after {
  border: none;
}

/* 分组 */
.wop-group {
  padding: 0 40rpx 12rpx;
}

.wos-group-title {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--color-text-tertiary);
  padding: 20rpx 0 16rpx;
}

/* 分隔线 */
.wos-divider {
  height: 0.5rpx;
  background: var(--color-divider);
  margin: 0 40rpx;
}

/* 信息行 */
.wos-info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 20rpx 0;
  border-top: 0.5rpx solid var(--color-divider);
  gap: 24rpx;
}

.wos-info-row--last {
  padding-bottom: 0;
}

.wos-info-label {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  flex-shrink: 0;
}

.wos-info-value {
  font-size: 28rpx;
  color: var(--color-text-primary);
  text-align: right;
  flex: 1;
  min-width: 0;
  line-height: 1.5;
}

/* Picker 行 */
.wop-picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-top: 0.5rpx solid var(--color-divider);
  min-height: 88rpx;
  gap: 16rpx;
  box-sizing: border-box;
}

/* ============================================================
   站点监测模块（只读监测入口）
   ============================================================ */

/* 状态标签（与列表页 mon-status-chip 保持一致） */
.mon-status-chip {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-xs);
  background: var(--color-type-bg);
}

.mon-status-tx {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--color-type-text);
  line-height: 1.4;
}

.mon-status-normal {
  background: var(--color-success-surface);
}
.mon-status-normal .mon-status-tx {
  color: var(--color-success);
}
.mon-status-attention,
.mon-status-warning,
.mon-status-stale {
  background: var(--color-warning-surface);
}
.mon-status-attention .mon-status-tx,
.mon-status-warning .mon-status-tx,
.mon-status-stale .mon-status-tx {
  color: var(--color-warning);
}
.mon-status-error,
.mon-status-offline,
.mon-status-unavailable {
  background: var(--color-error-surface);
}
.mon-status-error .mon-status-tx,
.mon-status-offline .mon-status-tx,
.mon-status-unavailable .mon-status-tx {
  color: var(--color-error);
}
.mon-status-info,
.mon-status-pending {
  background: var(--color-info-surface);
}
.mon-status-info .mon-status-tx,
.mon-status-pending .mon-status-tx {
  color: var(--color-info);
}

/* 监测状态首屏卡片 */
.mon-hero-card {
  margin: 16rpx 24rpx 24rpx;
  padding: 32rpx 28rpx;
  background: var(--color-card);
  border-radius: var(--radius-xl);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.mon-hero-chip-wrap {
  display: flex;
  justify-content: flex-start;
}

.mon-hero-chip-wrap .mon-status-chip {
  padding: 6rpx 20rpx;
}
.mon-hero-chip-wrap .mon-status-tx {
  font-size: 24rpx;
}

.mon-hero-reason {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text-primary);
  line-height: 1.5;
  word-break: break-all;
}

.mon-hero-reason--muted {
  color: var(--color-text-tertiary);
  font-weight: 400;
}

.mon-hero-times {
  display: flex;
  align-items: stretch;
  padding-top: 20rpx;
  border-top: 0.5rpx solid var(--color-divider);
}

.mon-time-item {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.mon-time-divider {
  width: 0.5rpx;
  background: var(--color-divider);
  margin: 0 24rpx;
}

.mon-time-ico {
  width: 28rpx;
  height: 28rpx;
  display: block;
  opacity: 0.5;
  flex-shrink: 0;
}

.mon-time-copy {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.mon-time-label {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  line-height: 1;
}

.mon-time-value {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.3;
  word-break: break-all;
}

/* 区块通用 */
.mon-section {
  margin-bottom: 24rpx;
}

.mon-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx 12rpx;
}

.mon-section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-tertiary);
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.mon-section-count {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

/* 有效值卡片 */
.mon-values-card {
  margin: 0 24rpx;
  padding: 4rpx 28rpx;
}

.mon-value-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 0.5rpx solid var(--color-divider);
  gap: 16rpx;
}

.mon-value-row:last-child {
  border-bottom: none;
}

.mon-value-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mon-value-right {
  flex: none;
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.mon-value-num {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  font-variant-numeric: tabular-nums;
}

.mon-value-unit {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

/* 行内空态 */
.mon-empty-inline {
  margin: 0 24rpx;
  padding: 48rpx 28rpx;
  background: var(--color-card);
  border-radius: var(--radius-xl);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.mon-empty-inline--small {
  padding: 32rpx 28rpx;
}

.mon-empty-inline-ico {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
  display: block;
  opacity: 0.8;
}

.mon-empty-inline--small .mon-empty-inline-ico {
  display: none;
}

.mon-empty-inline-tx {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-secondary);
}

.mon-empty-inline-sub {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  margin-top: 8rpx;
  line-height: 1.5;
}

/* 分轴状态卡片 */
.mon-axes-card {
  margin: 0 24rpx;
  padding: 4rpx 28rpx;
}

.mon-axis-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  gap: 16rpx;
}

.mon-axis-row--border {
  border-top: 0.5rpx solid var(--color-divider);
}

.mon-axis-ico {
  width: 32rpx;
  height: 32rpx;
  display: block;
  opacity: 0.7;
  flex-shrink: 0;
}

.mon-axis-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.mon-axis-row .mon-status-chip {
  flex: none;
}

.wop-picker-value {
  font-size: 28rpx;
  color: var(--color-text-primary);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 处理方式说明 */
.wop-note {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
  padding: 12rpx 16rpx;
  background: var(--color-background);
  border-radius: var(--radius-sm);
  margin-top: 8rpx;
}

/* 表单字段 */
.wos-field {
  padding: 16rpx 0 4rpx;
}

.wos-field-label {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}

.wop-input {
  width: 100%;
  min-height: 88rpx;
  padding: 0 24rpx;
  background: var(--color-background);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  color: var(--color-text-primary);
  box-sizing: border-box;
}

.wos-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx 24rpx;
  background: var(--color-background);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  color: var(--color-text-primary);
  line-height: 1.6;
  box-sizing: border-box;
}