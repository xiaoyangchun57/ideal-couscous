.site-summary { margin: 24rpx 24rpx 16rpx; padding: 28rpx; }
.site-name { font-size: 36rpx; font-weight: 600; color: var(--text); line-height: 1.35; }
.site-tags { margin-top: 14rpx; display: flex; flex-wrap: wrap; gap: 12rpx; }
.site-tags .tag { margin-right: 14rpx; }

.task-status { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin: 0 24rpx 20rpx; padding: 20rpx 24rpx; border: 1rpx solid var(--brand-line); border-radius: 16rpx; background: var(--brand-weak); }
.task-status-carryover { background: var(--amber-bg); border-color: var(--amber-line); }
.task-status-blocked { background: var(--fill); border-color: var(--line); }
.task-status-copy { flex: 1; min-width: 0; }
.task-status-title { display: block; color: var(--text); font-size: 27rpx; font-weight: 600; }
.task-status-desc { display: block; margin-top: 6rpx; color: var(--text-2); font-size: 23rpx; line-height: 1.45; }
.task-status-count { flex: 0 0 auto; color: var(--amber); font-size: 25rpx; font-weight: 600; }
.rework-status { margin: 0 24rpx 20rpx; padding: 20rpx 24rpx; border: 1rpx solid rgba(250,81,81,.35); border-radius: 12rpx; background: rgba(250,81,81,.06); }
.rework-status-title, .rework-status-desc { display: block; }
.rework-status-title { color: var(--red); font-size: 26rpx; font-weight: 600; }
.rework-status-desc { margin-top: 8rpx; color: var(--text-2); font-size: 23rpx; line-height: 1.45; }

.ops { margin: 0 24rpx; }
.checkin-btn { width: 100%; }
.secondary-ops { display: flex; gap: 16rpx; margin-top: 16rpx; }
.op-btn { flex: 1; margin: 0; font-size: 26rpx; }
.parts-apply-btn { width: 100%; margin: 16rpx 0 0; font-size: 26rpx; }

.site-info-heading { margin-top: 36rpx; }
.info-card { margin: 24rpx; padding: 8rpx 28rpx; }
.info-row { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 0; }
.info-k { font-size: 27rpx; color: var(--text-2); }
.info-v { font-size: 27rpx; color: var(--text); }
.parts-linked-site { margin-bottom: 16rpx; padding: 16rpx 18rpx; color: var(--text-2); background: var(--fill); border-radius: 10rpx; font-size: 24rpx; }
.field-picker { display: flex; align-items: center; justify-content: space-between; min-height: 76rpx; margin-top: 16rpx; padding: 0 18rpx; color: var(--text); background: var(--fill-2); border-radius: 10rpx; font-size: 25rpx; }
.parts-route-note { margin: 16rpx 0 4rpx; padding: 16rpx 18rpx; color: var(--text-2); background: var(--fill); border-left: 6rpx solid var(--brand); border-radius: 8rpx; font-size: 23rpx; line-height: 1.5; }
.field { margin-top: 18rpx; }
.field-label { display: block; margin-bottom: 10rpx; color: var(--text-2); font-size: 24rpx; }
.field-input { width: auto; min-height: 76rpx; padding: 18rpx; color: var(--text); background: var(--fill-2); border-radius: 10rpx; font-size: 26rpx; }
.textarea { min-height: 132rpx; }
.submit-btn { margin-top: 24rpx; }
