.site-summary { margin: var(--space-6) var(--space-8) var(--space-4); padding: var(--space-7); }
.site-name { font-size: var(--font-title-1); font-weight: var(--font-weight-semibold); color: var(--color-text-primary); line-height: 1.35; }
.site-tags { margin-top: var(--space-3); display: flex; flex-wrap: wrap; gap: var(--space-3); }
.site-tags .tag { margin-right: var(--space-3); }

/* 触控热区：可点同步条上下各 +12rpx 透明伪元素扩至 ≥88rpx，不改视觉尺寸 */
.sync-bar--action { position: relative; }
.sync-bar--action::after { content: ''; position: absolute; top: -12rpx; bottom: -12rpx; left: 0; right: 0; }

.task-status { display: flex; align-items: center; justify-content: space-between; gap: var(--space-5); margin: 0 var(--space-6) var(--space-5); padding: var(--space-5) var(--space-6); border: 1rpx solid var(--color-primary-surface); border-radius: var(--radius-sm); background: var(--color-primary-surface); }
.task-status-carryover { background: var(--color-warning-surface); border-color: var(--color-warning-surface); }
.task-status-blocked { background: var(--color-muted); border-color: var(--color-divider); }
.task-status-copy { flex: 1; min-width: 0; }
.task-status-title { display: block; color: var(--color-text-primary); font-size: var(--font-callout); font-weight: var(--font-weight-semibold); }
.task-status-desc { display: block; margin-top: var(--space-1); color: var(--color-text-secondary); font-size: var(--font-caption-1); line-height: 1.45; }
.task-status-count { flex: 0 0 auto; color: var(--color-warning); font-size: var(--font-footnote); font-weight: var(--font-weight-semibold); }
.rework-status { margin: 0 var(--space-6) var(--space-5); padding: var(--space-5) var(--space-6); border: 1rpx solid var(--color-error-surface); border-radius: var(--radius-md); background: var(--color-error-surface); }
.rework-status-title, .rework-status-desc { display: block; }
.rework-status-title { color: var(--color-error); font-size: var(--font-callout); font-weight: var(--font-weight-semibold); }
.rework-status-desc { margin-top: var(--space-2); color: var(--color-text-secondary); font-size: var(--font-caption-1); line-height: 1.45; }

.ops { margin: 0 var(--space-6); }
.checkin-btn { width: 100%; }
.secondary-ops { display: flex; gap: var(--space-4); margin-top: var(--space-4); }
.op-btn { flex: 1; margin: 0; font-size: var(--font-callout); }
.parts-apply-btn { width: 100%; margin: var(--space-4) 0 0; font-size: var(--font-callout); }

.site-info-heading {
  margin-top: var(--space-8);
  padding-top: 0;
  padding-bottom: var(--space-3);
}
.info-card { margin: var(--space-6) var(--space-8); padding: var(--space-2) var(--space-8); }
.info-row { display: flex; align-items: center; justify-content: space-between; padding: var(--space-6) 0; }
.info-k { font-size: var(--font-callout); color: var(--color-text-secondary); }
.info-v { font-size: var(--font-callout); color: var(--color-text-primary); }

.info-row--action {
  cursor: pointer;
  transition: opacity 0.15s ease;
  min-height: 88rpx;
}

.info-row--hover {
  opacity: 0.6;
}

.info-action {
  display: flex;
  align-items: center;
  gap: var(--space-1);
}

.info-chevron {
  font-size: var(--font-title-1);
  color: var(--color-icon-tertiary);
  line-height: 1;
  font-weight: var(--font-weight-regular);
}
.parts-linked-site { margin-bottom: var(--space-4); padding: var(--space-4); color: var(--color-text-secondary); background: var(--color-muted); border-radius: var(--radius-xs); font-size: var(--font-footnote); }
.field-picker { display: flex; align-items: center; justify-content: space-between; min-height: 76rpx; margin-top: var(--space-4); padding: 0 var(--space-4); color: var(--color-text-primary); background: var(--color-card); border-radius: var(--radius-xs); font-size: var(--font-footnote); }
.parts-route-note { margin: var(--space-4) 0 var(--space-1); padding: var(--space-4); color: var(--color-text-secondary); background: var(--color-muted); border-left: 6rpx solid var(--color-primary); border-radius: var(--radius-xs); font-size: var(--font-caption-1); line-height: 1.5; }
.field { margin-top: var(--space-4); }
.field-label { display: block; margin-bottom: var(--space-2); color: var(--color-text-secondary); font-size: var(--font-footnote); }
.field-input { width: auto; min-height: 76rpx; padding: var(--space-4); color: var(--color-text-primary); background: var(--color-card); border-radius: var(--radius-xs); font-size: var(--font-callout); }
.textarea { min-height: 132rpx; }
.submit-btn { margin-top: var(--space-6); }


/* ============================================================
   备件申请 Sheet 样式（与工单/巡检页统一）
   ============================================================ */

.sheet {
  display: flex;
  flex-direction: column;
  max-height: 75vh;
  overflow: hidden;
}

.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-6) var(--space-10) var(--space-5);
  flex-shrink: 0;
}

.sheet-header-title {
  font-size: var(--font-title-2);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.sheet-header-close {
  min-width: 88rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: calc(var(--space-5) * -1);
}

.sheet-scroll {
  flex: 1 1 0;
  height: 0;
  min-height: 0;
  overflow: hidden;
}

.sheet-content-spacer {
  height: 40rpx;
}

.sheet-bottom-bar {
  padding: var(--space-5) var(--space-10);
  padding-bottom: calc(var(--space-5) + env(safe-area-inset-bottom));
  border-top: 0.5rpx solid var(--color-divider);
  background: var(--color-card);
  flex-shrink: 0;
}

/* 备件申请 Sheet 底栏：横向双按钮 */
.parts-apply-sheet .sheet-bottom-bar {
  display: flex;
  flex-direction: row;
  gap: var(--space-5);
}

.parts-apply-sheet .btn-lg {
  flex: 1;
  width: auto;
  min-height: 88rpx;
  line-height: 88rpx;
  height: auto;
}

.parts-apply-sheet .btn-primary.btn-lg {
  flex: 2;
}

.btn-lg {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: var(--radius-lg);
  font-size: var(--font-title-3);
  font-weight: var(--font-weight-medium);
  border: none;
}

.btn-lg::after {
  border: none;
}

/* 分组 */
.wop-group {
  padding: 0 var(--space-10) var(--space-3);
}

.wos-group-title {
  font-size: var(--font-footnote);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-tertiary);
  padding: var(--space-5) 0 var(--space-4);
}

/* 分隔线 */
.wos-divider {
  height: 0.5rpx;
  background: var(--color-divider);
  margin: 0 var(--space-10);
}

/* 信息行 */
.wos-info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: var(--space-5) 0;
  border-top: 0.5rpx solid var(--color-divider);
  gap: var(--space-6);
}

.wos-info-row--last {
  padding-bottom: 0;
}

.wos-info-label {
  font-size: var(--font-body);
  color: var(--color-text-secondary);
  flex-shrink: 0;
}

.wos-info-value {
  font-size: var(--font-body);
  color: var(--color-text-primary);
  text-align: right;
  flex: 1;
  min-width: 0;
  line-height: 1.5;
}

/* Picker 行 */
.wop-picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-5) 0;
  border-top: 0.5rpx solid var(--color-divider);
  min-height: 88rpx;
  gap: var(--space-4);
  box-sizing: border-box;
}

/* ============================================================
   站点监测模块（只读监测入口）
   ============================================================ */

/* 状态标签（与列表页 mon-status-chip 保持一致） */
.mon-status-chip {
  display: inline-flex;
  align-items: center;
  padding: var(--space-1) var(--space-4);
  border-radius: var(--radius-full);
  background: var(--color-type-bg);
}

.mon-status-tx {
  font-size: var(--font-caption-1);
  font-weight: var(--font-weight-medium);
  color: var(--color-type-text);
  line-height: 1.4;
}

/* ── 结果态：正常（绿） ── */
.mon-status-normal {
  background: var(--color-success-surface);
}
.mon-status-normal .mon-status-tx {
  color: var(--color-success);
}

/* ── 结果态：需关注（橙） ── */
.mon-status-attention,
.mon-status-warning,
.mon-status-stale {
  background: var(--color-warning-surface);
}
.mon-status-attention .mon-status-tx,
.mon-status-warning .mon-status-tx,
.mon-status-stale .mon-status-tx {
  color: var(--color-warning);
}

/* ── 结果态：异常（红） ── */
.mon-status-error,
.mon-status-offline,
.mon-status-unavailable {
  background: var(--color-error-surface);
}
.mon-status-error .mon-status-tx,
.mon-status-offline .mon-status-tx,
.mon-status-unavailable .mon-status-tx {
  color: var(--color-error);
}

/* ── 过程态：进行中（蓝） ── */
.mon-status-info,
.mon-status-pending {
  background: var(--color-info-surface);
}
.mon-status-info .mon-status-tx,
.mon-status-pending .mon-status-tx {
  color: var(--color-info);
}

/* ── 过渡态：中性灰（等待首次数据 / 配置待完成 / 周期待设置） ── */
.mon-status-not_connected,
.mon-status-awaiting_first_frame,
.mon-status-raw_received_config_pending,
.mon-status-interval_unconfigured,
.mon-status-waiting_first_valid,
.mon-status-default,
.mon-status-unknown {
  background: var(--color-type-bg);
}
.mon-status-not_connected .mon-status-tx,
.mon-status-awaiting_first_frame .mon-status-tx,
.mon-status-raw_received_config_pending .mon-status-tx,
.mon-status-interval_unconfigured .mon-status-tx,
.mon-status-waiting_first_valid .mon-status-tx,
.mon-status-default .mon-status-tx,
.mon-status-unknown .mon-status-tx {
  color: var(--color-type-text);
}

/* 监测状态首屏卡片 */
.mon-hero-card {
  margin: var(--space-4) var(--space-8);
  padding: var(--space-7) var(--space-8);
  background: var(--color-card);
  border-radius: var(--radius-lg);
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
}

/* 门禁关闭 / 监测未启用 — 中性提示卡 */
.mon-gate-closed-card {
  margin: var(--space-4) var(--space-8);
  padding: var(--space-12) var(--space-8);
  background: var(--color-card);
  border-radius: var(--radius-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: var(--space-3);
}

.mon-gate-closed-ico {
  width: 72rpx;
  height: 72rpx;
  margin-bottom: var(--space-2);
  display: block;
  opacity: 0.6;
}

.mon-gate-closed-title {
  font-size: var(--font-title-3);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  line-height: 1.4;
}

.mon-gate-closed-desc {
  font-size: var(--font-callout);
  color: var(--color-text-tertiary);
  line-height: 1.5;
  max-width: 520rpx;
}

/* 监测区加载态 */
.mon-loading-card {
  margin: var(--space-4) var(--space-8);
  padding: var(--space-12) var(--space-8);
  background: var(--color-card);
  border-radius: var(--radius-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-4);
}

.mon-loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid var(--color-divider);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: mon-spin 0.8s linear infinite;
}

@keyframes mon-spin {
  to { transform: rotate(360deg); }
}

.mon-loading-text {
  font-size: var(--font-callout);
  color: var(--color-text-tertiary);
}

/* 监测区失败态 */
.mon-error-card {
  margin: var(--space-4) var(--space-8);
  padding: var(--space-7) var(--space-8);
  background: var(--color-card);
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
}

.mon-error-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}

.mon-error-title {
  font-size: var(--font-body);
  font-weight: var(--font-weight-medium);
  color: var(--color-error);
}

.mon-error-desc {
  font-size: var(--font-footnote);
  color: var(--color-text-secondary);
  line-height: 1.4;
}

.mon-error-retry {
  flex: none;
  font-size: var(--font-callout);
  color: var(--color-primary);
  font-weight: var(--font-weight-medium);
  padding: var(--space-3) var(--space-6);
  background: var(--color-primary-surface);
  border-radius: var(--radius-md);
  position: relative;
}

/* 触控热区：重试按钮上下各 +14rpx 透明伪元素扩至 ≥88rpx，不改视觉尺寸 */
.mon-error-retry::after {
  content: '';
  position: absolute;
  top: -14rpx;
  bottom: -14rpx;
  left: 0;
  right: 0;
}

.mon-hero-chip-wrap {
  display: flex;
  justify-content: flex-start;
}

.mon-hero-chip-wrap .mon-status-chip {
  padding: var(--space-1) var(--space-5);
}
.mon-hero-chip-wrap .mon-status-tx {
  font-size: var(--font-footnote);
}

.mon-hero-reason {
  font-size: var(--font-title-3);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  line-height: 1.5;
  word-break: break-all;
}

.mon-hero-reason--muted {
  color: var(--color-text-tertiary);
  font-weight: var(--font-weight-regular);
}

.mon-hero-times {
  display: flex;
  align-items: stretch;
  padding-top: var(--space-5);
  border-top: 0.5rpx solid var(--color-divider);
}

.mon-time-item {
  flex: 1;
  display: flex;
  align-items: center;
  gap: var(--space-3);
}

.mon-time-divider {
  width: 0.5rpx;
  background: var(--color-divider);
  margin: 0 var(--space-6);
}

.mon-time-ico {
  width: 28rpx;
  height: 28rpx;
  display: block;
  opacity: 0.5;
  flex-shrink: 0;
}

.mon-time-copy {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  min-width: 0;
}

.mon-time-label {
  font-size: var(--font-caption-1);
  color: var(--color-text-tertiary);
  line-height: 1;
}

.mon-time-value {
  font-size: var(--font-footnote);
  color: var(--color-text-secondary);
  line-height: 1.3;
  word-break: break-all;
}

/* 区块通用 */
.mon-section {
  margin-bottom: var(--space-6);
}

.mon-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 var(--space-8) var(--space-3);
}

.mon-section-title {
  font-size: var(--font-callout);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-tertiary);
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.mon-section-count {
  font-size: var(--font-footnote);
  color: var(--color-text-tertiary);
}

/* 有效值卡片 */
.mon-values-card {
  margin: 0 var(--space-8);
  padding: var(--space-1) var(--space-8);
}

.mon-value-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-6) 0;
  border-bottom: 0.5rpx solid var(--color-divider);
  gap: var(--space-4);
}

.mon-value-row:last-child {
  border-bottom: none;
}

.mon-value-name {
  flex: 1;
  min-width: 0;
  font-size: var(--font-body);
  color: var(--color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mon-value-right {
  flex: none;
  display: flex;
  align-items: baseline;
  gap: var(--space-1);
}

.mon-value-num {
  font-size: var(--font-title-3);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  font-variant-numeric: tabular-nums;
}

.mon-value-unit {
  font-size: var(--font-caption-1);
  color: var(--color-text-tertiary);
}

/* 行内空态 */
.mon-empty-inline {
  margin: 0 var(--space-8);
  padding: var(--space-12) var(--space-8);
  background: var(--color-card);
  border-radius: var(--radius-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.mon-empty-inline--small {
  padding: var(--space-8) var(--space-7);
}

.mon-empty-inline-ico {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: var(--space-5);
  display: block;
  opacity: 0.8;
}

.mon-empty-inline--small .mon-empty-inline-ico {
  display: none;
}

.mon-empty-inline-tx {
  font-size: var(--font-body);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-secondary);
}

.mon-empty-inline-sub {
  font-size: var(--font-footnote);
  color: var(--color-text-tertiary);
  margin-top: var(--space-2);
  line-height: 1.5;
}

/* 分轴状态卡片 */
.mon-axes-card {
  margin: 0 var(--space-8);
  padding: var(--space-1) var(--space-8);
}

.mon-axis-row {
  display: flex;
  align-items: center;
  padding: var(--space-6) 0;
  gap: var(--space-4);
}

.mon-axis-row--border {
  border-top: 0.5rpx solid var(--color-divider);
}

.mon-axis-ico {
  width: 32rpx;
  height: 32rpx;
  display: block;
  opacity: 0.7;
  flex-shrink: 0;
}

.mon-axis-name {
  flex: 1;
  min-width: 0;
  font-size: var(--font-body);
  color: var(--color-text-primary);
}

.mon-axis-row .mon-status-chip {
  flex: none;
}

.wop-picker-value {
  font-size: var(--font-body);
  color: var(--color-text-primary);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 处理方式说明 */
.wop-note {
  font-size: var(--font-footnote);
  color: var(--color-text-secondary);
  line-height: 1.5;
  padding: var(--space-3) var(--space-4);
  background: var(--color-background);
  border-radius: var(--radius-sm);
  margin-top: var(--space-2);
}

/* 触控热区：库存重试提示可点，上下各 +14rpx 透明伪元素扩至 ≥88rpx，不改视觉尺寸 */
.wop-note--retry {
  position: relative;
  display: inline-block;
}
.wop-note--retry::after {
  content: '';
  position: absolute;
  top: -14rpx;
  bottom: -14rpx;
  left: 0;
  right: 0;
}

/* 表单字段 */
.wos-field {
  padding: var(--space-4) 0 var(--space-1);
}

.wos-field-label {
  display: block;
  font-size: var(--font-callout);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-3);
}

.wop-input {
  width: 100%;
  min-height: 88rpx;
  padding: 0 var(--space-6);
  background: var(--color-background);
  border-radius: var(--radius-md);
  font-size: var(--font-body);
  color: var(--color-text-primary);
  box-sizing: border-box;
}

.wos-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: var(--space-5) var(--space-6);
  background: var(--color-background);
  border-radius: var(--radius-md);
  font-size: var(--font-body);
  color: var(--color-text-primary);
  line-height: 1.6;
  box-sizing: border-box;
}
