.page { padding: 24rpx; background: var(--bg); min-height: 100vh; box-sizing: border-box; }
.hd { margin-bottom: 20rpx; }
.hd-title { font-size: 36rpx; font-weight: 700; color: var(--text); }
.hd-sub { font-size: 24rpx; color: var(--text-3); margin-top: 6rpx; }

.empty { text-align: center; color: var(--text-3); padding: 120rpx 0; font-size: 26rpx; }
.empty-ico { font-size: 80rpx; margin-bottom: 16rpx; }

.group { margin-bottom: 28rpx; }
.group-hd { font-size: 26rpx; font-weight: 600; color: var(--brand); margin: 8rpx 4rpx 14rpx; }

.review-list { margin: 0; }
.review-row { padding: 24rpx 0; border-bottom: 1rpx solid var(--line); }
.review-row:last-child { border-bottom: none; }
.review-note { display: block; margin-top: 12rpx; padding: 14rpx 16rpx; background: var(--fill-2); border-radius: 12rpx; color: var(--text-2); font-size: 23rpx; line-height: 1.5; }
.card-actions { display: flex; gap: 20rpx; margin-top: 20rpx; }
.card-actions .btn-sm, .sheet-actions .btn-sm { flex: 1; margin: 0; }
.reason { width: 100%; height: 200rpx; background: var(--fill-2); border-radius: 16rpx; padding: 20rpx; font-size: 26rpx; box-sizing: border-box; }
.sheet-actions { display: flex; gap: 20rpx; margin-top: 28rpx; }
