.page { padding: 24rpx; background: var(--bg); min-height: 100vh; box-sizing: border-box; }
.hd { margin-bottom: 20rpx; }
.hd-title { font-size: 36rpx; font-weight: 700; color: var(--text); }
.hd-sub { font-size: 24rpx; color: var(--text-3); margin-top: 6rpx; }

.empty { text-align: center; color: var(--text-3); padding: 120rpx 0; font-size: 26rpx; }
.empty-ico { font-size: 80rpx; margin-bottom: 16rpx; }

.group { margin-bottom: 28rpx; }
.group-hd { font-size: 26rpx; font-weight: 600; color: var(--brand); margin: 8rpx 4rpx 14rpx; }

.review-list { margin: 0; }
.review-row { padding: 24rpx 0; border-bottom: 1rpx solid var(--line); }
.review-row:last-child { border-bottom: none; }
.review-note { display: block; margin-top: 12rpx; padding: 14rpx 16rpx; background: var(--fill-2); border-radius: 12rpx; color: var(--text-2); font-size: 23rpx; line-height: 1.5; }
.approval-summary { display: block; margin-top: 12rpx; color: var(--text-2); font-size: 23rpx; line-height: 1.45; }
.detail-toggle { display: inline-block; margin-top: 14rpx; color: var(--brand); font-size: 23rpx; }
.review-detail { margin-top: 14rpx; padding: 16rpx; background: var(--fill-2); border-radius: 10rpx; }
.detail-label, .detail-text { display: block; }
.detail-label { margin-top: 8rpx; color: var(--text-3); font-size: 21rpx; }
.detail-text { margin-top: 4rpx; color: var(--text-2); font-size: 23rpx; line-height: 1.45; }
.detail-line { margin-top: 4rpx; }
.detail-muted { display: block; margin-top: 4rpx; color: var(--text-3); font-size: 21rpx; line-height: 1.4; }
.detail-risk { color: var(--red); }
.inspection-item { padding: 12rpx 0; border-bottom: 1rpx solid var(--line); }
.inspection-item:last-child { border-bottom: none; }
.inspection-item-head { display: flex; justify-content: space-between; gap: 16rpx; color: var(--text-2); font-size: 23rpx; line-height: 1.4; }
.item-result { color: var(--brand); flex-shrink: 0; }
.review-photos { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 14rpx; }
.review-photo { width: 100%; height: 220rpx; border-radius: 8rpx; background: var(--fill); }
.photo-select-hint { display: block; margin-top: 14rpx; color: var(--text-2); font-size: 22rpx; }
.review-photo-wrap { width: calc(50% - 8rpx); min-width: 0; padding: 8rpx; border: 2rpx solid transparent; border-radius: 8rpx; box-sizing: border-box; }
.review-photo-reject { border-color: var(--red); background: var(--fill-2); }
.photo-select { margin-top: 6rpx; padding: 8rpx 0; text-align: center; color: var(--brand); font-size: 21rpx; }
.review-photo-reject .photo-select { color: var(--red); font-weight: 600; }
.photo-risk { display: block; margin-top: 4rpx; color: var(--red); font-size: 19rpx; line-height: 1.35; }
.photo-meta { display: block; margin-top: 5rpx; color: var(--text-2); font-size: 20rpx; line-height: 1.4; overflow-wrap: anywhere; }
.photo-item-name { color: var(--text); font-weight: 600; }
.photo-watermark { display: block; margin-top: 5rpx; color: var(--text-3); font-size: 19rpx; line-height: 1.4; white-space: pre-wrap; overflow-wrap: anywhere; }
.detail-empty { display: block; margin-top: 14rpx; color: var(--text-3); font-size: 22rpx; }
.card-actions { display: flex; gap: 20rpx; margin-top: 20rpx; }
.card-actions .btn-sm, .sheet-actions .btn-sm { flex: 1; margin: 0; }
.reason { width: 100%; height: 200rpx; background: var(--fill-2); border-radius: 16rpx; padding: 20rpx; font-size: 26rpx; box-sizing: border-box; }
.sheet-actions { display: flex; gap: 20rpx; margin-top: 28rpx; }
