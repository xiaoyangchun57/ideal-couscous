<view class="page">
  <view class="hd">
    <view class="hd-title">待办审核</view>
    <view class="hd-sub">{{total}} 项待处理 · 管理者/审批者</view>
  </view>

  <view wx:if="{{loading}}" class="empty">加载中…</view>

  <view wx:elif="{{total === 0}}" class="empty">
    <view class="empty-ico">✓</view>
    <view>暂无待审核事项</view>
  </view>

  <block wx:else>
    <view wx:for="{{groups}}" wx:key="label" class="group">
      <view class="group-hd">{{item.label}}（{{item.items.length}}）</view>
      <view class="list-card review-list">
        <view wx:for="{{item.items}}" wx:for-item="it" wx:key="id" class="review-row {{it.targeted ? 'review-target' : ''}}">
          <text class="row-title">{{it.title}}</text>
          <text class="row-sub" wx:if="{{it.site_name}}">站点：{{it.site_name}}</text>
          <text class="row-sub" wx:if="{{it.source_name}}">单号：{{it.source_name}}</text>
          <text class="row-sub" wx:if="{{it.source_type === 'plan_schedule' && it.executor_name}}">执行人：{{it.executor_name}}</text>
          <text class="row-sub" wx:if="{{it.source_type === 'plan_schedule' && it.requester_name}}">申报人：{{it.requester_name}}</text>
          <text class="row-sub" wx:elif="{{it.requester_name}}">申报人：{{it.requester_name}}</text>
          <text class="row-sub" wx:if="{{it.submit_time}}">提交：{{it.submit_time}}</text>
          <text class="review-note" wx:if="{{it.remark}}">{{it.remark}}</text>
          <view class="approval-summary" wx:if="{{it.source_type === 'plan_schedule'}}">
            <text>审批重点：站点、路线、车辆与备件安排{{it.is_change ? '（计划变更）' : ''}}</text>
          </view>
          <view class="approval-summary" wx:elif="{{it.source_type === 'inspection_batch'}}">
            <text>审批重点：{{it.pending_item_count}} 个检查项的结果与现场证据</text>
          </view>
          <view class="approval-summary" wx:elif="{{it.source_type === 'parts_request' || it.source_type === 'spare_part_request'}}">
            <text>审批重点：备件清单、数量、履约方式与申请事由</text>
          </view>
          <view class="approval-summary" wx:elif="{{it.source_type === 'vehicle_application'}}">
            <text>审批重点：车辆、使用时段、目的地与用车事由</text>
          </view>
          <view class="approval-summary" wx:elif="{{it.source_type === 'data_review'}}">
            <text>审批重点：原始数值、采集时间与自动审核结论</text>
          </view>
          <view class="detail-toggle" data-id="{{it.id}}" bindtap="onToggleDetails">{{it.detailOpen ? '收起审批详情' : it.detailHint}}</view>
          <view class="review-detail" wx:if="{{it.detailOpen}}">
            <block wx:if="{{it.source_type === 'plan_schedule'}}">
              <text class="detail-label">计划周期</text>
              <text class="detail-text">{{it.title}}</text>
              <text class="detail-label">执行人</text>
              <text class="detail-text">{{it.executor_name || '未记录'}}</text>
              <text class="detail-label" wx:if="{{it.requester_name}}">申报人</text>
              <text class="detail-text" wx:if="{{it.requester_name}}">{{it.requester_name}}</text>
              <text class="detail-label">站点与路线</text>
              <view wx:for="{{it.plan_days}}" wx:for-item="day" wx:key="date" class="detail-line">
                <text class="detail-text">{{day.date}}：<text wx:for="{{day.sites}}" wx:for-item="routeSite" wx:key="id">{{routeSite.name}}{{index < day.sites.length - 1 ? ' → ' : ''}}</text></text>
                <text class="detail-muted" wx:if="{{day.notes}}">备注：{{day.notes}}</text>
              </view>
              <text class="detail-empty" wx:if="{{!it.plan_days.length}}">未配置站点路线</text>
              <block wx:if="{{it.is_change && it.previous_plan_days.length}}">
                <text class="detail-label">变更前路线</text>
                <text class="detail-text" wx:for="{{it.previous_plan_days}}" wx:for-item="oldDay" wx:key="date">{{oldDay.date}}：<text wx:for="{{oldDay.sites}}" wx:for-item="oldSite" wx:key="id">{{oldSite.name}}{{index < oldDay.sites.length - 1 ? ' → ' : ''}}</text></text>
              </block>
              <text class="detail-label" wx:if="{{it.vehicle_days_detail.length}}">用车安排</text>
              <text class="detail-text" wx:for="{{it.vehicle_days_detail}}" wx:for-item="vehicleDay" wx:key="date">{{vehicleDay.date}}：{{vehicleDay.plate_no || '未指定车辆'}}{{vehicleDay.model ? ' · ' + vehicleDay.model : ''}}</text>
              <text class="detail-label" wx:if="{{it.spare_parts.length}}">备件计划</text>
              <text class="detail-text" wx:for="{{it.spare_parts}}" wx:for-item="part" wx:key="index">{{part.part_name || part.name || part.part_sku || '备件'}} × {{part.quantity || part.planned_quantity || 0}}</text>
              <text class="detail-label" wx:if="{{it.is_change && it.change_reason}}">变更原因</text>
              <text class="detail-text detail-risk" wx:if="{{it.is_change && it.change_reason}}">{{it.change_reason}}</text>
            </block>
            <block wx:elif="{{it.source_type === 'inspection_batch'}}">
              <text class="detail-label">待审检查项</text>
              <view wx:for="{{it.itemDetails}}" wx:for-item="checkItem" wx:key="id" class="inspection-item">
                <view class="inspection-item-head"><text>{{checkItem.item_name}}</text><text class="item-result">{{checkItem.result || '已提交'}}</text></view>
                <text class="detail-muted" wx:if="{{checkItem.remark}}">备注：{{checkItem.remark}}</text>
              </view>
            </block>
            <block wx:elif="{{it.source_type === 'parts_request' || it.source_type === 'spare_part_request'}}">
              <text class="detail-label">备件清单</text>
              <text class="detail-text" wx:for="{{it.parts_detail}}" wx:for-item="part" wx:key="part_sku">{{part.part_name || part.part_sku}} × {{part.quantity || 0}}{{part.model ? ' · ' + part.model : ''}}</text>
              <text class="detail-label" wx:if="{{it.fulfillment_label}}">履约方式</text>
              <text class="detail-text" wx:if="{{it.fulfillment_label}}">{{it.fulfillment_label}}</text>
              <text class="detail-label" wx:if="{{it.reason}}">申请事由</text>
              <text class="detail-text" wx:if="{{it.reason}}">{{it.reason}}</text>
              <text class="detail-label" wx:if="{{it.estimated_amount}}">预计金额</text>
              <text class="detail-text" wx:if="{{it.estimated_amount}}">¥{{it.estimated_amount}}</text>
            </block>
            <block wx:elif="{{it.source_type === 'vehicle_application'}}">
              <text class="detail-label">车辆</text><text class="detail-text">{{it.plate_no || '未指定'}}{{it.model ? ' · ' + it.model : ''}}</text>
              <text class="detail-label">使用时段</text><text class="detail-text">{{it.start_at}} 至 {{it.end_at}}</text>
              <text class="detail-label" wx:if="{{it.destination}}">目的地</text><text class="detail-text" wx:if="{{it.destination}}">{{it.destination}}</text>
              <text class="detail-label" wx:if="{{it.reason}}">用车事由</text><text class="detail-text" wx:if="{{it.reason}}">{{it.reason}}</text>
            </block>
            <block wx:elif="{{it.source_type === 'data_review'}}">
              <text class="detail-label">指标与数值</text><text class="detail-text">{{it.metric}}：{{it.value}}</text>
              <text class="detail-label">采集时间</text><text class="detail-text">{{it.recorded_at || '未记录'}}</text>
              <text class="detail-label">当前审核状态</text><text class="detail-text">{{it.review_status_label}}</text>
              <text class="detail-label">自动审核结论</text><text class="detail-text">{{it.auto_reason || '未记录'}}</text>
              <text class="detail-label">智能审核结论</text><text class="detail-text">{{it.smart_result || '未记录'}}</text>
            </block>
            <block wx:else>
              <text class="detail-label" wx:if="{{it.original_description}}">现场描述</text>
              <text class="detail-text" wx:if="{{it.original_description}}">{{it.original_description}}</text>
              <text class="detail-label" wx:if="{{it.resolution_note}}">办结说明</text>
              <text class="detail-text" wx:if="{{it.resolution_note}}">{{it.resolution_note}}</text>
              <text class="detail-label" wx:if="{{it.flag_reason}}">风险提示</text>
              <text class="detail-text detail-risk" wx:if="{{it.flag_reason}}">{{it.flag_reason}}</text>
            </block>
            <block wx:if="{{(it.source_type === 'photo_review' || it.source_type === 'inspection_batch') && it.reviewPhotos.length}}">
              <text class="photo-select-hint">勾选需驳回的照片，未勾选照片将一次通过</text>
              <view class="review-photos">
                <view wx:for="{{it.reviewPhotos}}" wx:key="id" wx:for-item="photo" class="review-photo-wrap {{photo.selectedForReject ? 'review-photo-reject' : ''}}">
                  <image class="review-photo" src="{{photo.url}}" mode="aspectFill" bindtap="onPreviewPhoto" data-id="{{it.id}}" data-url="{{photo.url}}" />
                  <view class="photo-select" bindtap="onTogglePhotoReject" data-id="{{it.id}}" data-photo-id="{{photo.id}}">{{photo.selectedForReject ? '已选驳回' : '选择驳回'}}</view>
                  <text class="photo-meta photo-item-name">检查项：{{photo.itemLabel}}</text>
                  <text class="photo-meta" wx:if="{{photo.archiveName}}">档案名称：{{photo.archiveName}}</text>
                  <text class="photo-meta" wx:if="{{photo.originalFilename}}">原始文件名：{{photo.originalFilename}}</text>
                  <text class="photo-meta">主状态：{{photo.primaryStatusLabel}}</text>
                  <text class="photo-meta">自动归类：{{photo.categoryLabel}}（{{photo.classificationLabel}}）</text>
                  <text class="photo-meta">水印核验：{{photo.watermarkStatusLabel}}</text>
                  <text class="photo-watermark" wx:if="{{photo.watermark_text}}">识别文字：{{photo.watermark_text}}</text>
                  <text class="photo-risk" wx:if="{{photo.riskLabel || photo.flag_reason}}">{{photo.riskLabel || photo.flag_reason}}</text>
                </view>
              </view>
            </block>
            <view class="review-photos" wx:elif="{{it.photoUrls.length && (it.source_type === 'inspection_batch' || it.source_type === 'workorder_review' || it.source_type === 'workorder_photo')}}">
              <image wx:for="{{it.photoUrls}}" wx:key="*this" wx:for-item="photo" class="review-photo" src="{{photo}}" mode="aspectFill" bindtap="onPreviewPhoto" data-id="{{it.id}}" data-url="{{photo}}" />
            </view>
            <text class="detail-empty" wx:if="{{!it.photoUrls.length && (it.source_type === 'inspection_batch' || it.source_type === 'workorder_review' || it.source_type === 'photo_review' || it.source_type === 'workorder_photo')}}">暂无可查看的影像</text>
          </view>
          <view class="card-actions" wx:if="{{(it.source_type === 'photo_review' || it.source_type === 'inspection_batch') && it.reviewPhotos.length}}">
            <button class="btn-primary btn-sm" size="mini" data-id="{{it.id}}" loading="{{submittingId === it.id}}" disabled="{{submittingId === it.id}}" bindtap="onSubmitPhotoReview">{{it.selectedRejectCount ? '驳回' + it.selectedRejectCount + '张，其余通过' : '全部通过'}}</button>
          </view>
          <view class="card-actions" wx:else>
            <button class="btn-primary btn-sm" size="mini" data-id="{{it.id}}" data-type="{{it.source_type}}" loading="{{submittingId === it.id}}" disabled="{{submittingId === it.id}}" bindtap="onApprove">{{it.approveLabel}}</button>
            <button class="btn-danger btn-sm" size="mini" data-id="{{it.id}}" data-type="{{it.source_type}}" loading="{{submittingId === it.id}}" disabled="{{submittingId === it.id}}" bindtap="onReject">{{it.rejectLabel}}</button>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- 驳回原因弹窗 -->
  <view wx:if="{{rejectShow}}" class="sheet-mask" bindtap="closeReject">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">驳回原因</view>
      <textarea class="reason" placeholder="请填写驳回原因（必填）" value="{{rejectReason}}" bindinput="onReasonInput" maxlength="200" />
      <view class="sheet-actions">
        <button class="btn-ghost btn-sm" size="mini" bindtap="closeReject">取消</button>
        <button class="btn-danger btn-sm" size="mini" bindtap="rejectConfirm" disabled="{{!!submittingId && curAction !== 'selective'}}">确认驳回</button>
      </view>
    </view>
  </view>
</view>
