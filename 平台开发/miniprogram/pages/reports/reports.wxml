<view class="page">
  <!-- 页头 -->
  <view class="page-hd">
    <view class="page-hd-text">
      <text class="page-title">我的异常上报</text>
      <text class="page-subtitle">上报后由管理端核实并跟随工单闭环</text>
    </view>
    <button class="btn btn-primary btn-sm" loading="{{reportSiteLoading}}" disabled="{{reportSiteLoading}}" bindtap="onGoReport">现场上报</button>
  </view>

  <view wx:if="{{reportSiteLoadError}}" class="empty-state">
    <text class="empty-state-text">{{reportSiteLoadError}}</text>
    <button class="btn btn-primary btn-sm" bindtap="onRetryReportSites">重试</button>
  </view>

  <!-- 筛选分段控件 -->
  <view class="seg-wrap">
    <scroll-view class="seg-scroll" scroll-x="true" enhanced show-scrollbar="false">
      <view class="seg-list">
        <view wx:for="{{filters}}" wx:key="*this" data-index="{{index}}" bindtap="onFilter"
              class="seg-item {{(index === 0 && !filter) || (index === 1 && filter === 'dispatched') || (index === 2 && filter === 'verified') || (index === 3 && filter === 'resolved') || (index === 4 && filter === 'archived') ? 'seg-item--active' : ''}}">
          {{item}}
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="empty-state">
    <text class="empty-state-text">加载中…</text>
  </view>

  <!-- 列表 -->
  <block wx:else>
    <view wx:for="{{reports}}" wx:key="id" wx:if="{{!filter || item.status === filter}}"
          class="report-card" bindtap="onOpenDetail" data-id="{{item.id}}">
      <view class="report-card-hd">
        <text class="report-type">{{item.type_cn}}</text>
        <text class="status-chip status-{{item.status}}">{{item.status_cn}}</text>
      </view>
      <text class="report-site">{{item.site_name || '未关联站点'}}</text>
      <text class="report-desc">{{item.description}}</text>
      <view class="report-meta">
        <text class="report-meta-item">{{item.reported_at}}</text>
        <text class="report-meta-item" wx:if="{{item.photo_count}}">现场照片 {{item.photo_count}} 张</text>
      </view>
      <view wx:if="{{item.order_no}}" class="report-order" catchtap="goOrder" data-order="{{item.order_no}}">
        <text class="report-order-text">关联工单：{{item.order_no}}</text>
        <text class="report-order-arrow">›</text>
      </view>
    </view>

    <view wx:if="{{!reports.length}}" class="empty-state">
      <view class="empty-state-icon">
        <view class="empty-state-icon-shape"></view>
      </view>
      <text class="empty-state-title">暂无异常上报记录</text>
      <text class="empty-state-desc">发现问题时可现场拍照上报</text>
    </view>
  </block>

  <!-- 详情 Sheet -->
  <view wx:if="{{detail}}" class="sheet-mask" bindtap="onCloseDetail"></view>
  <view wx:if="{{detail}}" class="sheet report-detail-sheet">
    <view class="sheet-handle"></view>
    <view class="sheet-head">
      <text class="sheet-title">异常上报详情</text>
      <view class="sheet-close" bindtap="onCloseDetail">
        <view class="ico ico-close"></view>
      </view>
    </view>
    <view class="sheet-body">
      <view class="detail-row">
        <text class="detail-key">状态</text>
        <text class="status-chip status-{{detail.status}}">{{detail.status_cn}}</text>
      </view>
      <view class="detail-row">
        <text class="detail-key">异常类型</text>
        <text class="detail-value">{{detail.type_cn}}</text>
      </view>
      <view class="detail-row">
        <text class="detail-key">站点</text>
        <text class="detail-value">{{detail.site_name || '未关联站点'}}</text>
      </view>
      <view class="detail-row">
        <text class="detail-key">上报时间</text>
        <text class="detail-value">{{detail.reported_at}}</text>
      </view>
      <view class="detail-block">
        <text class="detail-block-label">现场说明</text>
        <text class="detail-block-text">{{detail.description || '未填写说明'}}</text>
      </view>
      <view class="detail-block" wx:if="{{detail.photos.length}}">
        <text class="detail-block-label">现场照片</text>
        <view wx:if="{{detail.mediaRefreshing}}" class="detail-media-state">正在刷新照片</view>
        <view wx:elif="{{detail.mediaError}}" class="detail-media-state detail-media-retry" bindtap="onRetryDetailMedia">{{detail.mediaError}}</view>
        <scroll-view class="detail-photos" scroll-x="true">
          <block wx:for="{{detail.photos}}" wx:key="storedPath">
            <image wx:if="{{item.url}}" class="detail-photo" src="{{item.url}}" mode="aspectFill" binderror="onDetailPhotoMediaError" bindtap="onPreviewPhoto" data-stored-path="{{item.storedPath}}" />
            <text wx:else class="detail-block-text">照片地址无效，请联系管理员核对档案</text>
          </block>
        </scroll-view>
      </view>
      <view wx:if="{{detail.order_no}}" class="detail-order" bindtap="goOrder" data-order="{{detail.order_no}}">
        <text class="detail-order-text">查看关联工单：{{detail.order_no}}</text>
        <text class="detail-order-arrow">›</text>
      </view>
    </view>
  </view>

  <view wx:if="{{reportSheet.open}}" class="om-sheet-mask" bindtap="onCloseReport"></view>
  <view wx:if="{{reportSheet.open}}" class="om-sheet report-compose-sheet">
    <view class="om-sheet-dismiss report-compose-close" bindtap="onCloseReport">
      <view class="ico ico-close"></view>
    </view>
    <scroll-view class="om-sheet-scroll sheet-body report-compose-body" scroll-y="true">
      <view class="report-compose-heading">
        <text class="sheet-title">现场上报</text>
      </view>
      <view class="detail-row">
        <text class="detail-key">站点</text>
        <picker wx:if="{{reportSheet.sites.length > 1}}" range="{{reportSheet.sites}}" range-key="name" value="{{reportSheet.siteIndex}}" bindchange="onReportSite">
          <text class="detail-value">{{reportSheet.siteName || '请选择站点'}}</text>
        </picker>
        <text wx:else class="detail-value">{{reportSheet.siteName || '站点不可用'}}</text>
      </view>
      <view class="detail-row">
        <text class="detail-key">异常类型</text>
        <picker range="{{reportTypes}}" range-key="label" value="{{reportSheet.typeIndex}}" bindchange="onReportType">
          <text class="detail-value">{{reportTypes[reportSheet.typeIndex].label}}</text>
        </picker>
      </view>
      <view class="detail-block">
        <text class="detail-block-label">现场说明</text>
        <textarea class="detail-block-text" value="{{reportSheet.description}}" placeholder="请说明现场异常" maxlength="500" auto-height="true" bindinput="onReportDescription" />
      </view>
      <view class="detail-block">
        <text class="detail-block-label">现场照片（1 至 6 张）</text>
        <scroll-view wx:if="{{reportSheet.photoItems.length}}" class="detail-photos" scroll-x="true">
          <view wx:for="{{reportSheet.photoItems}}" wx:key="key" class="report-photo-entry">
            <view class="detail-photo">
              <image class="detail-photo" src="{{item.displayUrl || item.localPath}}" mode="aspectFill" binderror="onReportPhotoMediaError" bindtap="onPreviewReportPhoto" data-key="{{item.key}}" />
              <text wx:if="{{item.status === 'uploading'}}" class="report-photo-status">上传中</text>
              <text wx:elif="{{item.status === 'failed'}}" class="report-photo-status report-photo-retry" bindtap="onRetryReportPhoto" data-key="{{item.key}}">{{item.requiresNewCapture ? '授权失效，重新拍摄' : '上传失败，重试'}}</text>
              <text wx:elif="{{item.mediaRefreshing}}" class="report-photo-status">正在刷新</text>
              <text wx:elif="{{item.mediaError}}" class="report-photo-status report-photo-retry" bindtap="onRetryReportPhotoMedia" data-key="{{item.key}}">照片加载失败，点击重试</text>
              <text class="report-photo-remove-text" bindtap="onRemoveReportPhoto" data-key="{{item.key}}">移除</text>
            </view>
            <text wx:if="{{item.status === 'failed' && item.error}}" class="report-photo-message report-photo-error">{{item.error}}</text>
            <text wx:if="{{item.status === 'failed' && item.nextAction}}" class="report-photo-message">{{item.nextAction}}</text>
          </view>
        </scroll-view>
        <view class="report-photo-actions">
          <button class="btn btn-primary btn-sm" disabled="{{reportSheet.uploading || reportSheet.submitting}}" loading="{{reportSheet.uploading}}" bindtap="onTakeReportPhoto">现场拍照</button>
          <button class="btn btn-secondary btn-sm" disabled="{{reportSheet.uploading || reportSheet.submitting}}" bindtap="onAddReportPhoto">从相册选择</button>
        </view>
      </view>
    </scroll-view>
    <view class="sheet-bottom-bar">
      <button class="btn-primary btn-lg" disabled="{{reportSheet.uploading || reportSheet.submitting}}" loading="{{reportSheet.submitting}}" bindtap="onSubmitReport">提交上报</button>
    </view>
  </view>
</view>
