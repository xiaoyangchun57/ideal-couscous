<view class="page">
  <view class="topbar">
    <view class="tb-btn" wx:if="{{view === 'current'}}" bindtap="onReadAll">全部已读</view>
    <view class="tb-btn tb-brand" bindtap="onSubscribe">订阅消息</view>
  </view>

  <view class="message-tabs">
    <view class="message-tab {{view === 'current' ? 'message-tab-active' : ''}}" data-view="current" bindtap="onSwitchView">当前消息</view>
    <view class="message-tab {{view === 'history' ? 'message-tab-active' : ''}}" data-view="history" bindtap="onSwitchView">历史消息</view>
  </view>

  <view class="list-card" wx:if="{{list.length}}">
    <view class="msg-row {{item.is_read ? '' : 'msg-unread'}}" wx:for="{{list}}" wx:key="id" bindtap="onTap" data-id="{{item.id}}">
      <view class="msg-dot" wx:if="{{!item.is_read}}"></view>
      <view class="msg-main">
        <text class="msg-title">{{item.title}}</text>
        <text class="msg-sub">{{item.content}}</text>
        <text class="msg-time">{{item.time}}</text>
      </view>
    </view>
  </view>
  <view class="empty" wx:elif="{{loaded}}">
    <view class="empty-circle"></view>
    <text class="empty-tx">{{view === 'history' ? '暂无历史消息' : '暂无未读消息'}}</text>
  </view>

  <view class="list-foot" wx:if="{{list.length && !noMore}}">上拉加载更多</view>
  <view class="list-foot" wx:if="{{noMore}}">没有更多了</view>
</view>
