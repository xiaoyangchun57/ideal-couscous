.topbar { display: flex; justify-content: flex-end; padding: 20rpx 24rpx 0; }
.tb-btn { font-size: 26rpx; color: var(--text-2); padding: 10rpx 28rpx; border-radius: 999rpx; border: 1rpx solid var(--line); margin-left: 16rpx; }
.tb-brand { color: var(--brand); border-color: var(--brand-line); }

/* 消息行（多行展开语义，独立于全局 .row 单行省略范式，故用 .msg-* 族） */
.msg-row { display: flex; align-items: flex-start; padding: 26rpx 0; border-bottom: 1rpx solid var(--line); }
.msg-row:last-child { border-bottom: none; }
.msg-unread { background: var(--brand-weak); }
.msg-dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: var(--brand); margin-top: 14rpx; margin-right: 16rpx; flex-shrink: 0; }
.msg-main { flex: 1; min-width: 0; }
.msg-title { font-size: 28rpx; color: var(--text); display: block; }
.msg-sub { font-size: 24rpx; color: var(--text-2); margin-top: 8rpx; display: block; line-height: 1.5; }
.msg-time { font-size: 22rpx; color: var(--text-3); margin-top: 10rpx; display: block; }
