/* ============================================================
 *  消息中心 · iOS 风格
 *  设计系统：水质运维-Apple v1.1.0
 * ============================================================ */

.msg-page {
  min-height: 100vh;
  background: var(--color-background);
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ---------- 分段控件 ---------- */

.msg-seg-wrap {
  padding: 20rpx 32rpx 16rpx;
}

.msg-seg {
  display: flex;
  background: var(--color-type-bg);
  border-radius: var(--radius-sm);
  padding: 4rpx;
  height: 64rpx;
  box-sizing: border-box;
}

.msg-seg-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
  border-radius: calc(var(--radius-sm) - 2rpx);
  transition: all 0.2s ease;
}

.msg-seg-active {
  background: var(--color-card);
  color: var(--color-text-primary);
  font-weight: 600;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
}

/* ---------- 列表操作区 ---------- */

.msg-list-actions {
  display: flex;
  justify-content: flex-end;
  padding: 4rpx 4rpx 16rpx;
}

.msg-readall {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 400;
  padding: 4rpx 0;
}

.msg-readall:active {
  opacity: 0.6;
}

/* ---------- 空态 / 加载 / 失败 ---------- */

.msg-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 48rpx;
  text-align: center;
}

.msg-empty-ico {
  width: 128rpx;
  height: 128rpx;
  margin-bottom: 32rpx;
  display: block;
}

.msg-empty-tx {
  font-size: 30rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
}

.msg-empty-sub {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  margin-top: 12rpx;
  line-height: 1.5;
}

.msg-retry-btn {
  margin-top: 32rpx;
  min-width: 240rpx;
  height: 96rpx;
  padding: 0 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-primary);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: var(--radius-lg);
  box-sizing: border-box;
}

.msg-retry-btn:active {
  opacity: 0.85;
}

/* ---------- 列表区 ---------- */

.msg-list-wrap {
  padding: 0 32rpx;
}

/* 旧内容刷新失败提示 */
.msg-stale {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: var(--color-warning-surface);
  border-radius: var(--radius-md);
  margin-bottom: 20rpx;
}

.msg-stale-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-warning);
  margin-top: 8rpx;
  flex-shrink: 0;
}

.msg-stale-body {
  flex: 1;
  min-width: 0;
}

.msg-stale-title {
  display: block;
  font-size: 24rpx;
  color: var(--color-warning);
  font-weight: 600;
  line-height: 1.4;
}

.msg-stale-detail {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
  word-break: break-all;
}

.msg-stale-action {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--color-warning);
  font-weight: 500;
  padding: 4rpx 0;
}

.msg-stale-action:active {
  opacity: 0.6;
}

/* 消息卡片 */
.msg-card {
  background: var(--color-card);
  border-radius: var(--radius-xl);
  overflow: hidden;
}

.msg-row {
  display: flex;
  align-items: flex-start;
  padding: 28rpx 28rpx 28rpx 32rpx;
  border-bottom: 0.5rpx solid var(--color-divider);
  position: relative;
  transition: background 0.15s ease;
}

.msg-row:last-child {
  border-bottom: none;
}

.msg-row:active {
  background: var(--color-muted);
}

.msg-row-unread {
  background: var(--color-primary-surface);
}

.msg-row-unread:active {
  opacity: 0.85;
}

.msg-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--color-primary);
  margin-top: 10rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.msg-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.msg-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.msg-title {
  font-size: 30rpx;
  color: var(--color-text-primary);
  font-weight: 600;
  line-height: 1.35;
  flex: 1;
  min-width: 0;
  word-break: break-all;
}

.msg-row-unread .msg-title {
  /* 未读保持 600，不加粗更多 */
}

.msg-time {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  white-space: nowrap;
}

.msg-content {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.msg-arrow {
  width: 14rpx;
  height: 14rpx;
  border-right: 2rpx solid var(--color-icon-tertiary);
  border-bottom: 2rpx solid var(--color-icon-tertiary);
  transform: rotate(-45deg);
  flex-shrink: 0;
  margin-left: 16rpx;
  margin-top: 14rpx;
}

.msg-arrow-unread {
  border-right-color: var(--color-primary);
  border-bottom-color: var(--color-primary);
  opacity: 0.5;
}

/* ---------- 分页底部 ---------- */

.msg-foot {
  text-align: center;
  padding: 24rpx 0 8rpx;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

/* ---------- 订阅消息（直接动作） ---------- */

.msg-sub-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 32rpx 32rpx 24rpx;
}

.msg-sub-btn {
  min-width: 320rpx;
  height: 80rpx;
  padding: 0 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-card);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  transition: opacity 0.15s ease;
  box-sizing: border-box;
}

.msg-sub-btn:active {
  opacity: 0.85;
}

.msg-sub-tx {
  font-size: 30rpx;
  color: var(--color-primary);
  font-weight: 500;
}

.msg-sub-hint {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  text-align: center;
  line-height: 1.5;
}
