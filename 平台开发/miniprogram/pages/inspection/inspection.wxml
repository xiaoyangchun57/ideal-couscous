<view class="page">
  <!-- 弱网待同步条 -->
  <view class="sync-bar" wx:if="{{!online}}">
    <text>当前离线 · 现场记录已本地保存</text>
  </view>
  <view class="sync-bar" wx:elif="{{syncCount > 0}}" bindtap="onSyncNow">
    <text>{{syncCount}} 项待同步 · 弱网记录已保存</text>
    <text class="sync-action">立即同步</text>
  </view>

  <!-- 展示今日已批准执行包，以及此前仍有未完成项的结转执行包 -->
  <view class="package-switch" wx:if="{{packages.length}}">
    <view class="package-chip {{selectedPlanId === item.plan_id ? 'package-chip-on' : ''}}"
      wx:for="{{packages}}" wx:key="plan_id" bindtap="onSelectPackage" data-id="{{item.plan_id}}">
      {{item.is_carryover ? '补做' : ''}}{{item.schedule_type === 'weekly' ? '周检' : (item.schedule_type === 'monthly' ? '月检' : (item.schedule_type === 'quarterly' ? '季检' : '年检'))}} · {{item.sites.length}}站
    </view>
  </view>

  <view class="journey" wx:if="{{currentPackage}}">
    <view class="journey-summary" bindtap="onToggleTrip">
      <view class="journey-copy">
        <view class="journey-title-row">
          <text class="journey-title">{{currentPackage.is_carryover ? '结转任务' : '今日行程'}}</text>
          <text class="journey-ready {{currentPackage.is_carryover ? 'journey-ready-carryover' : (tripReady ? 'journey-ready-ok' : 'journey-ready-wait')}}">{{currentPackage.is_carryover ? ('原日期 ' + currentPackage.work_date) : (tripReady ? '已就绪' : '待准备')}}</text>
        </view>
        <text class="journey-meta">{{currentPackage.sites.length}} 个站点 · 第 {{currentPackage.version}} 版{{currentPackage.is_carryover ? (' · 逾期 ' + currentPackage.overdue_days + ' 天') : (currentPackage.vehicle ? ' · ' + currentPackage.vehicle.plate_no : '')}}</text>
      </view>
      <text class="journey-toggle">{{tripExpanded || !tripReady ? '收起' : '展开'}} {{tripExpanded || !tripReady ? '⌃' : '⌄'}}</text>
    </view>

    <view class="journey-details" wx:if="{{tripExpanded || !tripReady}}">
      <view class="carryover-note" wx:if="{{currentPackage.is_carryover}}">
        此任务来自 {{currentPackage.work_date}} 未完成检查项，仅补做现场记录；车辆、备件和出发确认不再重复办理。
      </view>
      <view class="departure-confirmation" wx:else>
        <view class="departure-copy">
          <text class="departure-label">出发资源</text>
          <text class="departure-hint">仅留痕，不锁车、不扣库</text>
        </view>
        <view class="departure-action">
          <text class="departure-status {{currentPackage.departure_confirmation && currentPackage.departure_confirmation.vehicle_confirmed && currentPackage.departure_confirmation.parts_confirmed ? 'departure-confirmed' : 'departure-pending'}}">
            {{currentPackage.departure_confirmation && currentPackage.departure_confirmation.vehicle_confirmed && currentPackage.departure_confirmation.parts_confirmed ? '已确认' : '待确认'}}
          </text>
          <view class="departure-button" wx:if="{{!(currentPackage.departure_confirmation && currentPackage.departure_confirmation.vehicle_confirmed && currentPackage.departure_confirmation.parts_confirmed)}}" bindtap="onConfirmDeparture">
            {{confirmingDeparture ? '提交中…' : '一键确认'}}
          </view>
        </view>
      </view>
      <view class="parts-issue-card" wx:if="{{!currentPackage.is_carryover && currentPackage.resource_parts && currentPackage.resource_parts.length}}">
        <view class="parts-issue-copy">
          <text class="parts-issue-title">备件现场领用</text>
          <text class="parts-issue-meta">{{currentPackage.resource_summary.totalKinds}} 种 · {{currentPackage.resource_summary.remainingKinds}} 种待领 · 领用即扣库</text>
        </view>
        <view class="parts-issue-button {{currentPackage.resource_summary.remaining === 0 ? 'parts-issue-done' : ''}}" bindtap="onOpenPartsIssue">
          {{currentPackage.resource_summary.remaining === 0 ? '已领用' : (currentPackage.departure_confirmation && currentPackage.departure_confirmation.parts_confirmed ? '确认领用' : '待确认')}}
        </view>
      </view>
      <view class="vehicle-dispatch" wx:if="{{!currentPackage.is_carryover && currentPackage.vehicle}}">
        <view class="vehicle-dispatch-copy"><text class="vehicle-dispatch-title">{{currentPackage.vehicle.plate_no}}</text><text class="vehicle-dispatch-meta {{currentPackage.vehicle.document_warning ? 'vehicle-doc-warning' : ''}}">{{currentPackage.vehicle.document_warning || (currentPackage.vehicle_use ? (currentPackage.vehicle_use.returned_at ? '已还车，行程已归档' : (currentPackage.vehicle_can_return ? '计划末日，完成还车验车后归档' : '行程中，到站打卡自动记录节点')) : '出发前完成车况和里程登记')}}</text></view>
        <view class="vehicle-dispatch-btn {{currentPackage.vehicle_use && currentPackage.vehicle_use.returned_at ? 'vehicle-dispatch-returned' : (currentPackage.vehicle_use ? 'vehicle-dispatch-done' : '')}}" bindtap="onOpenVehicleCheckout">{{currentPackage.vehicle_use ? (currentPackage.vehicle_use.returned_at ? '已还车' : (currentPackage.vehicle_can_return ? '还车登记' : '行程中')) : '出车登记'}}</view>
      </view>
      <view class="vehicle-live-actions" wx:if="{{!currentPackage.is_carryover && currentPackage.vehicle_use && !currentPackage.vehicle_use.returned_at}}">
        <view class="vehicle-live-action" bindtap="onOpenRefuel">{{currentPackage.vehicle.fuel_type === 'electric' ? '充电记录' : '加油记录'}}</view>
        <view class="vehicle-live-action vehicle-live-danger" bindtap="onOpenVehicleFault">车辆故障</view>
      </view>
    </view>
  </view>

  <!-- 站点选择 -->
  <scroll-view wx:if="{{sites.length}}" scroll-x class="site-chips" enhanced show-scrollbar="{{false}}">
    <view class="chip {{selSiteId === item.id ? 'chip-on' : ''}}" wx:for="{{sites}}" wx:key="id"
          bindtap="onSelectSite" data-id="{{item.id}}">{{item.name}}</view>
  </scroll-view>

  <view wx:if="{{selSite && stationStage}}" class="site-focus">
    <view class="site-head">
      <view class="site-head-info">
        <text class="site-head-name">{{selSite.name}}</text>
        <text class="site-head-type">{{selSite.type_cn}}</text>
      </view>
      <text class="station-stage {{stationStage.cls}}">{{stationStage.label}}</text>
    </view>
    <view class="checkin-primary" wx:if="{{stationStage.code === 'unvisited'}}" bindtap="onCheckIn">
      <text class="checkin-primary-title">到站打卡</text>
      <text class="checkin-primary-hint">获取当前位置后开始本站巡检</text>
    </view>
    <view class="checked-in-summary" wx:else>
      <text class="checked-in-mark">✓</text>
      <text>{{stationStage.code === 'local_pending' ? '到站记录已保存，等待联网同步' : '已完成到站打卡，可以开始巡检'}}</text>
    </view>
    <view class="site-secondary-actions">
      <view class="site-secondary-action site-secondary-danger" bindtap="onOpenReport">异常上报</view>
      <view class="site-secondary-action" bindtap="onOpenPartsApply">备件申请</view>
      <view class="site-secondary-action" bindtap="goSite">站点信息</view>
    </view>
  </view>
  <view wx:if="{{selSite && selSite.linked_workorders && selSite.linked_workorders.length}}" class="linked-orders">
    <view class="linked-orders-head"><text>关联工单</text><text>{{selSite.linked_workorders.length}} 条待处理</text></view>
    <view class="linked-order" wx:for="{{selSite.linked_workorders}}" wx:key="order_no" data-order-no="{{item.order_no}}" bindtap="onLinkedWorkorder"><text class="linked-order-title">{{item.display_title}}</text><text class="linked-order-status">{{item.status_cn}} ›</text></view>
  </view>

  <view class="sheet-mask" wx:if="{{reportSheet.open}}" bindtap="onCloseReport"></view>
  <view class="sheet" wx:if="{{reportSheet.open}}">
    <view class="sheet-head"><text class="sheet-title">现场异常上报</text><text class="sheet-close" bindtap="onCloseReport">×</text></view>
    <picker range="{{['感官异常','设备异常','环境异常','违规操作','污染事件']}}" value="{{reportSheet.typeIndex}}" bindchange="onReportType"><view class="reagent-picker">异常类别 ›</view></picker>
    <picker range="{{anomalyCodes}}" range-key="code" value="{{reportSheet.codeIndex}}" bindchange="onReportCode"><view class="reagent-picker">异常编码（可选） ›</view></picker>
    <textarea class="ta" placeholder="说明现场异常及已采取措施" value="{{reportSheet.description}}" bindinput="onReportDescription"/>
    <view class="report-photo" bindtap="onAddReportPhoto">{{reportSheet.photos.length ? '继续添加现场照片' : '拍摄现场照片（至少 1 张）'}}</view>
    <view class="report-photo-count" wx:if="{{reportSheet.photos.length}}">已添加 {{reportSheet.photos.length}}/6 张</view>
    <view class="report-photo-grid" wx:if="{{reportSheet.photos.length}}">
      <view class="report-photo-item" wx:for="{{reportSheet.photos}}" wx:key="*this">
        <image class="report-photo-image" src="{{item}}" mode="aspectFill" bindtap="onPreviewReportPhoto" data-url="{{item}}"/>
        <text class="report-photo-remove" bindtap="onRemoveReportPhoto" data-url="{{item}}">×</text>
      </view>
    </view>
    <button class="btn-primary submit-btn" loading="{{reportSheet.submitting}}" bindtap="onSubmitReport">上报并生成工单</button>
  </view>

  <view class="work-summary" wx:if="{{selSite}}">
    <view class="work-summary-head">
      <text class="work-summary-title">现场进度</text>
      <text class="work-summary-percent">{{completionPercent}}%</text>
    </view>
    <view class="work-metrics">
      <view class="work-metric"><text class="work-metric-value">{{completed}}/{{total}}</text><text class="work-metric-label">检查项</text></view>
      <view class="work-metric"><text class="work-metric-value {{photoProgress.missing > 0 ? 'metric-danger' : ''}}">{{photoProgress.taken}}/{{photoProgress.req}}</text><text class="work-metric-label">照片</text></view>
      <view class="work-metric"><text class="work-metric-value {{abnormalCount > 0 ? 'metric-danger' : ''}}">{{abnormalCount}}</text><text class="work-metric-label">异常</text></view>
    </view>
    <view class="progress-bar"><view class="progress-fill" style="width:{{total? completed/total*100 : 0}}%"></view></view>
  </view>
  <view wx:if="{{selSite}}" class="reagent-entry" bindtap="onOpenReagentSheet">
    <view><text class="reagent-title">现场试剂</text><text class="reagent-meta">更换后需完成标定</text></view>
    <text class="reagent-action">{{reagentAction}}</text>
  </view>
  <view class="work-locked" wx:if="{{selSite && stationStage.code === 'unvisited'}}">
    完成到站打卡后即可填写检查项
  </view>

  <!-- 分类与检查项 -->
  <block wx:if="{{categories.length}}">
    <view class="cat {{stationStage.code === 'unvisited' ? 'cat-locked' : ''}}" wx:for="{{categories}}" wx:key="category" wx:for-item="cat">
      <view class="cat-head">
        <text class="cat-name">{{cat.category_cn}}</text>
        <text class="cat-count">{{cat.completed}}/{{cat.total}}</text>
      </view>
      <view class="card item" wx:for="{{cat.items}}" wx:key="item_id" wx:for-item="it"
            bindtap="onOpenItem" data-id="{{it.item_id}}">
        <view class="item-strip {{it.result === 'normal' ? 'strip-ok' : (it.result === 'abnormal' ? 'strip-bad' : 'strip-wait')}}"></view>
        <view class="item-left">
          <view class="item-name">{{it.item_name}}</view>
          <view class="item-meta">
            <text class="tag">{{it.frequency_cn || '未设频次'}}</text>
            <text class="item-time" wx:if="{{it.check_time}}">{{it.check_time}}</text>
          </view>
          <view class="item-review-reject" wx:if="{{it.review_status === 3 && it.review_comment}}">退回：{{it.review_comment}}</view>
        </view>
        <view class="item-right">
          <view class="item-status {{it.review_status === 3 ? 'st-bad' : (it.result === 'normal' ? 'st-ok' : (it.result === 'abnormal' ? 'st-bad' : 'st-wait'))}}">
            {{it.review_status === 3 ? '待整改' : it.result_cn}}
          </view>
        </view>
      </view>
    </view>
  </block>
  <view class="empty" wx:elif="{{loaded}}">
    <view class="empty-circle"></view>
    <text class="empty-tx">今日暂无已批准的巡检任务</text>
  </view>

  <view class="sheet-mask" wx:if="{{vehicleSheet.open}}" bindtap="onCloseVehicleCheckout"></view>
  <view class="sheet" wx:if="{{vehicleSheet.open}}">
    <view class="sheet-head"><text class="sheet-title">{{vehicleSheet.mode === 'return' ? '还车检查' : '出车前检查'}}</text><text class="sheet-close" bindtap="onCloseVehicleCheckout">×</text></view>
    <text class="vehicle-check-hint">请逐项核对车况。选择“禁用”会将车辆转为受限，无法继续调度。</text>
    <view class="vehicle-check-row" wx:for="{{vehicleSheet.items}}" wx:key="key" wx:for-item="item">
      <text class="vehicle-check-label">{{item.label || item.key}}</text>
      <view class="vehicle-check-options">
        <text class="vehicle-check-option {{item.status === 'normal' ? 'vehicle-check-ok' : ''}}" data-index="{{index}}" data-status="normal" bindtap="onVehicleItemStatus">正常</text>
        <text class="vehicle-check-option {{item.status === 'attention' ? 'vehicle-check-attention' : ''}}" data-index="{{index}}" data-status="attention" bindtap="onVehicleItemStatus">关注</text>
        <text class="vehicle-check-option {{item.status === 'blocked' ? 'vehicle-check-blocked' : ''}}" data-index="{{index}}" data-status="blocked" bindtap="onVehicleItemStatus">禁用</text>
      </view>
    </view>
    <view class="field-label">{{vehicleSheet.mode === 'return' ? '还车时里程' : '出车时里程'}}</view>
    <input class="inline-input" type="digit" placeholder="填写仪表盘公里数" value="{{vehicleSheet.mileage}}" bindinput="onVehicleMileage"/>
    <view class="field-label">现场说明{{vehicleSheet.mode === 'return' ? '（异常必填）' : '（异常必填）'}}</view>
    <textarea class="ta" placeholder="如：左前轮胎压不足、补气后可继续使用" value="{{vehicleSheet.remarks}}" bindinput="onVehicleRemark"/>
    <button class="btn-primary submit-btn" loading="{{vehicleSheet.submitting}}" disabled="{{vehicleSheet.submitting}}" bindtap="onSubmitVehicleCheckout">{{vehicleSheet.mode === 'return' ? '确认检查并还车' : '确认检查并出车'}}</button>
  </view>

  <view class="sheet-mask" wx:if="{{partsIssueSheet.open}}" bindtap="onClosePartsIssue"></view>
  <view class="sheet" wx:if="{{partsIssueSheet.open}}">
    <view class="sheet-head"><text class="sheet-title">备件现场领用</text><text class="sheet-close" bindtap="onClosePartsIssue">×</text></view>
    <text class="parts-sheet-hint">按实际交付数量确认，可分批领用。提交后立即扣减库存。</text>
    <view class="parts-sheet-row" wx:for="{{partsIssueSheet.items}}" wx:key="part_id" wx:for-item="part">
      <view class="parts-sheet-copy">
        <text class="parts-sheet-name">{{part.part_name || ('备件#' + part.part_id)}}</text>
        <text class="parts-sheet-meta">剩余可领 {{part.remaining_quantity}}{{part.unit || '件'}} · 已领 {{part.issued_quantity}}{{part.unit || '件'}}</text>
      </view>
      <input class="parts-sheet-input" type="number" value="{{part.issue_quantity}}" data-index="{{index}}" bindinput="onPartsIssueQuantity" />
      <text class="parts-sheet-unit">{{part.unit || '件'}}</text>
    </view>
    <button class="btn-primary submit-btn" loading="{{partsIssueSheet.submitting}}" disabled="{{partsIssueSheet.submitting}}" bindtap="onSubmitPartsIssue">确认领用并扣库</button>
  </view>

  <view class="sheet-mask" wx:if="{{partsApply.open}}" bindtap="onClosePartsApply"></view>
  <view class="sheet" wx:if="{{partsApply.open}}">
    <view class="sheet-head"><text class="sheet-title">备品备件需求</text><text class="sheet-close" bindtap="onClosePartsApply">×</text></view>
    <view class="parts-linked-site">关联站点：{{selSite.name}}</view>
    <picker mode="selector" range="{{partsFulfillmentOptions}}" range-key="label" value="{{partsApply.fulfillmentIndex}}" bindchange="onPartsFulfillmentPick"><view class="field-picker"><text>处理方式</text><text>{{partsFulfillmentOptions[partsApply.fulfillmentIndex].label}} ›</text></view></picker>
    <view class="parts-route-note" wx:if="{{partsApply.fulfillment_type === 'stock'}}">库存领用批准后不锁库，现场实际拿到时再扣库。</view>
    <view class="parts-route-note" wx:elif="{{partsApply.fulfillment_type === 'local_purchase'}}">附近可以买到时，先电话确认，回来补票据、金额和领用记录。</view>
    <view class="parts-route-note" wx:else>无法本地采购时走厂家订购，到货后再确认入库或现场直用。</view>
    <picker wx:if="{{partsApply.fulfillment_type === 'stock'}}" mode="selector" range="{{partsOptions}}" range-key="label" value="{{partsApply.index}}" bindchange="onPartsPick"><view class="field-picker"><text>库存备件</text><text>{{partsOptions[partsApply.index].label}}</text></view></picker>
    <view class="parts-form-field"><text class="parts-form-label">备件名称</text><input class="parts-form-input" placeholder="如：pH 电极" value="{{partsApply.part_name}}" bindinput="onPartsName" maxlength="50"/></view>
    <view class="parts-form-field" wx:if="{{partsApply.fulfillment_type !== 'stock'}}"><text class="parts-form-label">规格型号</text><input class="parts-form-input" placeholder="厂家、型号或可识别规格" value="{{partsApply.specification}}" bindinput="onPartsSpecification" maxlength="100"/></view>
    <view class="parts-form-field"><text class="parts-form-label">数量</text><input class="parts-form-input" type="number" value="{{partsApply.quantity}}" bindinput="onPartsQty" maxlength="5"/></view>
    <view class="parts-form-field" wx:if="{{partsApply.fulfillment_type !== 'stock'}}"><text class="parts-form-label">预计金额（可不填）</text><input class="parts-form-input" type="digit" placeholder="元" value="{{partsApply.estimated_amount}}" bindinput="onPartsEstimatedAmount"/></view>
    <view class="parts-form-field"><text class="parts-form-label">申请事由</text><textarea class="parts-form-input parts-form-textarea" placeholder="说明现场发现的问题、是否影响运行" value="{{partsApply.reason}}" bindinput="onPartsReason" maxlength="200"></textarea></view>
    <button class="btn-primary submit-btn" loading="{{partsApply.submitting}}" disabled="{{partsApply.submitting}}" bindtap="onSubmitPartsApply">提交备件需求</button>
  </view>

  <view class="sheet-mask" wx:if="{{refuelSheet.open}}" bindtap="onCloseRefuel"></view>
  <view class="sheet" wx:if="{{refuelSheet.open}}">
    <view class="sheet-head"><text class="sheet-title">{{refuelSheet.label}}记录</text><text class="sheet-close" bindtap="onCloseRefuel">×</text></view>
    <view class="field-label">{{refuelSheet.label}}量（{{refuelSheet.unit}}）</view><input class="inline-input" type="digit" value="{{refuelSheet.quantity}}" data-field="quantity" bindinput="onRefuelField" placeholder="填写补给量"/>
    <view class="field-label">金额（元，可选）</view><input class="inline-input" type="digit" value="{{refuelSheet.amount}}" data-field="amount" bindinput="onRefuelField" placeholder="填写实付金额"/>
    <view class="field-label">当前里程</view><input class="inline-input" type="digit" value="{{refuelSheet.mileage}}" data-field="mileage" bindinput="onRefuelField" placeholder="填写仪表盘公里数"/>
    <view class="field-label">备注（可选）</view><textarea class="ta" value="{{refuelSheet.remark}}" data-field="remark" bindinput="onRefuelField" placeholder="如：92号汽油、加油站名称"/>
    <button class="btn-primary submit-btn" loading="{{refuelSheet.submitting}}" disabled="{{refuelSheet.submitting}}" bindtap="onSubmitRefuel">保存{{refuelSheet.label}}记录</button>
  </view>

  <view class="sheet-mask" wx:if="{{vehicleFaultSheet.open}}" bindtap="onCloseVehicleFault"></view>
  <view class="sheet" wx:if="{{vehicleFaultSheet.open}}">
    <view class="sheet-head"><text class="sheet-title">车辆故障上报</text><text class="sheet-close" bindtap="onCloseVehicleFault">×</text></view>
    <view class="field-label">故障类型</view><input class="inline-input" value="{{vehicleFaultSheet.faultType}}" data-field="faultType" bindinput="onVehicleFaultField" placeholder="如：轮胎、灯光、制动"/>
    <view class="field-label">故障时里程（可选）</view><input class="inline-input" type="digit" value="{{vehicleFaultSheet.mileage}}" data-field="mileage" bindinput="onVehicleFaultField" placeholder="填写仪表盘公里数"/>
    <view class="field-label">故障现象</view><textarea class="ta" value="{{vehicleFaultSheet.description}}" data-field="description" bindinput="onVehicleFaultField" placeholder="说明故障现象及是否影响安全行驶"/>
    <view class="field-label">补充说明（可选）</view><textarea class="ta" value="{{vehicleFaultSheet.remark}}" data-field="remark" bindinput="onVehicleFaultField" placeholder="已采取的临时措施"/>
    <button class="btn-danger submit-btn" loading="{{vehicleFaultSheet.submitting}}" disabled="{{vehicleFaultSheet.submitting}}" bindtap="onSubmitVehicleFault">上报并限制使用</button>
  </view>

  <view class="sheet-mask" wx:if="{{reagentSheet.open}}" bindtap="onCloseReagentSheet"></view>
  <view class="sheet" wx:if="{{reagentSheet.open}}">
    <view class="sheet-head"><text class="sheet-title">现场试剂</text><text class="sheet-close" bindtap="onCloseReagentSheet">×</text></view>
    <picker mode="selector" range="{{reagents}}" range-key="reagent_name" value="{{reagentSheet.index}}" bindchange="onReagentPick"><view class="reagent-picker">{{reagents[reagentSheet.index].reagent_name}} · {{reagents[reagentSheet.index].qc_status === 'pending' ? '待标定' : '已标定'}} ›</view></picker>
    <view class="seg"><view class="seg-item {{reagentSheet.mode === 'replacement' ? 'seg-on-ok' : ''}}" data-mode="replacement" bindtap="onReagentMode">更换</view><view class="seg-item {{reagentSheet.mode === 'qc' ? 'seg-on-ok' : ''}}" data-mode="qc" bindtap="onReagentMode">标定</view></view>
    <block wx:if="{{reagentSheet.mode === 'replacement'}}"><view class="field-label">更换后余量</view><input class="inline-input" type="digit" value="{{reagentSheet.newQty}}" data-field="newQty" bindinput="onReagentField" placeholder="填写当前余量" /><view class="field-label">预计使用天数</view><input class="inline-input" type="number" value="{{reagentSheet.duration}}" data-field="duration" bindinput="onReagentField" placeholder="按现场经验填写" /></block>
    <block wx:else><view class="field-label">标样值 / 实测值</view><input class="inline-input" type="digit" value="{{reagentSheet.standardValue}}" data-field="standardValue" bindinput="onReagentField" placeholder="标样值" /><input class="inline-input" type="digit" value="{{reagentSheet.measuredValue}}" data-field="measuredValue" bindinput="onReagentField" placeholder="实测值" /><view class="seg"><view class="seg-item {{reagentSheet.passed ? 'seg-on-ok' : ''}}" data-passed="true" bindtap="onReagentPass">通过</view><view class="seg-item {{!reagentSheet.passed ? 'seg-on-bad' : ''}}" data-passed="false" bindtap="onReagentPass">不通过</view></view><view wx:if="{{!reagentSheet.passed}}" class="seg fail-action"><view class="seg-item {{reagentSheet.failAction === 'calibrate' ? 'seg-on-bad' : ''}}" data-action="calibrate" bindtap="onReagentFailAction">校准</view><view class="seg-item {{reagentSheet.failAction === 'repair' ? 'seg-on-bad' : ''}}" data-action="repair" bindtap="onReagentFailAction">报修</view></view></block>
    <button class="btn-primary submit-btn" loading="{{reagentSheet.submitting}}" disabled="{{reagentSheet.submitting}}" bindtap="onSubmitReagent">{{reagentSheet.mode === 'replacement' ? '确认更换' : '提交标定结果'}}</button>
  </view>

  <!-- 检查项操作底栏 -->
  <view class="sheet-mask" wx:if="{{sheet.open}}" bindtap="onCloseSheet"></view>
  <view class="sheet" wx:if="{{sheet.open}}">
    <view class="sheet-head">
      <text class="sheet-title">{{sheet.item.item_name}}</text>
      <text class="sheet-close" bindtap="onCloseSheet">×</text>
    </view>
    <text class="sheet-freq" wx:if="{{sheet.item.frequency_cn}}">{{sheet.item.frequency_cn}}</text>

    <view class="field-label">判定结果</view>
    <view class="seg">
      <view class="seg-item {{sheet.result === 'normal' ? 'seg-on-ok' : ''}}" bindtap="onSetResult" data-r="normal">正常</view>
      <view class="seg-item {{sheet.result === 'abnormal' ? 'seg-on-bad' : ''}}" bindtap="onSetResult" data-r="abnormal">异常</view>
    </view>

    <view class="field-label">备注</view>
    <textarea class="ta" placeholder="填写说明（异常时必填原因）" value="{{sheet.remark}}" bindinput="onRemark" maxlength="200" />

    <view class="field-label">校准信息（选填）</view>
    <input class="inline-input" placeholder="校准人" value="{{sheet.calibrator}}" bindinput="onCalibrator" />
    <input class="inline-input" placeholder="校准值" value="{{sheet.calValues}}" bindinput="onCalValues" />

    <view class="field-label">现场照片<text class="photo-req-hint" wx:if="{{sheet.requiredPhotos > 0}}">（需拍 {{sheet.requiredPhotos}} 张，已拍 {{sheet.photos.length}} 张）</text></view>
    <view class="photo-summary" wx:if="{{sheet.requiredPhotos > 0}}">已拍 {{sheet.photoInfo.captured}} / 需拍 {{sheet.photoInfo.required}}</view>
    <view class="photos">
      <view class="photo" wx:for="{{sheet.photos}}" wx:key="*this" wx:for-item="p">
        <image class="photo-img" src="{{p}}" mode="aspectFill" bindtap="onPreview" data-src="{{p}}" />
        <text class="photo-del" catchtap="onDelPhoto" data-idx="{{index}}">×</text>
      </view>
      <view class="photo" wx:for="{{sheet.localPhotos}}" wx:key="*this" wx:for-item="p">
        <image class="photo-img" src="{{p}}" mode="aspectFill" bindtap="onPreview" data-src="{{p}}" />
        <text class="photo-del" catchtap="onDelLocalPhoto" data-idx="{{index}}">×</text>
      </view>
      <!-- 未拍虚线占位（应拍清单可视化） -->
      <view class="photo-slot" wx:if="{{sheet.photoInfo.missing > 0}}" wx:for="{{sheet.photoInfo.missing}}" wx:key="*this">
        <text class="photo-slot-text">待拍</text>
      </view>
      <view class="photo-add" bindtap="onAddPhoto">＋</view>
    </view>

    <button class="btn-primary submit-btn" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onSubmitItem">提 交</button>
  </view>
</view>
