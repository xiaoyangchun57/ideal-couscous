/* pages/index/index.wxss */

/* ===== 导航栏 ===== */
.nav-home-left {
  display: flex;
  align-items: center;
  height: 100%;
}

.nav-home-title {
  font-size: var(--font-title-1);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.nav-bell-wrap {
  height: 100%;
  display: flex;
  align-items: center;
  position: relative;
  padding-left: 16rpx;
}

/* ===== 问候区 =====
   设计原则：问候是页面装饰性信息，不能压过任务内容。
   问候语：--font-headline 30rpx/600
   日期：--font-callout 26rpx/400 tertiary色 */
.greeting-area {
  padding: 8rpx 32rpx 20rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.greeting-logo {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  display: block;
  margin-right: 16rpx;
}

.greeting-main {
  flex: 1;
  min-width: 0;
  padding-top: 2rpx;
}

.greeting-name {
  font-size: var(--font-headline);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  line-height: 1.3;
  display: block;
}

.greeting-date {
  font-size: var(--font-callout);
  color: var(--color-text-tertiary);
  margin-top: 4rpx;
  display: block;
}

.greeting-bell {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.bell-icon {
  width: 44rpx;
  height: 44rpx;
  display: block;
  opacity: 0.85;
}

.bell-badge {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  min-width: 32rpx;
  height: 32rpx;
  background: var(--color-error);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 600;
  border-radius: 9999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  line-height: 1;
  border: 3rpx solid var(--color-card);
  z-index: 3;
}

/* ===== 骨架屏 ===== */
.loading-skeleton {
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.skeleton-action {
  height: 160rpx;
  background: var(--color-card);
  border-radius: 24rpx;
  animation: shimmer 1.5s ease-in-out infinite;
}

.skeleton-plan {
  height: 360rpx;
  background: var(--color-card);
  border-radius: 24rpx;
  animation: shimmer 1.5s ease-in-out infinite;
  animation-delay: 0.2s;
}

@keyframes shimmer {
  0% { opacity: 0.6; }
  50% { opacity: 1; }
  100% { opacity: 0.6; }
}

/* ===== 首次加载失败（对齐 empty-state error 变体） ===== */
.error-card {
  margin: 24rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 32rpx;
  text-align: center;
}

.error-icon-shape {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 59, 48, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  margin-bottom: 20rpx;
}
.error-icon-shape::before {
  content: '!';
  font-size: 44rpx;
  font-weight: 600;
  color: var(--color-error);
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.error-title {
  font-size: var(--font-title-3);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  margin-bottom: 8rpx;
}

.error-subtitle {
  font-size: var(--font-callout);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.error-retry-btn {
  margin-top: 20rpx;
  font-size: var(--font-body);
  font-weight: var(--font-weight-medium);
  color: var(--color-primary);
}

/* ===== 刷新失败提示条 ===== */
.refresh-error-bar {
  margin: 0 32rpx 16rpx;
  background: var(--color-error-surface);
  color: var(--color-error);
  border-radius: var(--radius-lg);
  padding: 16rpx 20rpx;
  font-size: var(--font-footnote);
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.re-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-error);
  flex-shrink: 0;
}

.re-retry {
  margin-left: auto;
  font-weight: 600;
}

/* ===== 今日行动卡片 =====
   卡片标题：--font-headline 30rpx/600
   副标题：--font-footnote 24rpx/400 secondary */
.action-card {
  display: flex;
  align-items: center;
  padding: 28rpx;
  margin: 0 32rpx 16rpx;
}

.action-content {
  flex: 1;
  min-width: 0;
}

.action-tags {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.action-title {
  font-size: var(--font-headline);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  margin-top: 12rpx;
  display: block;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-subtitle {
  font-size: var(--font-footnote);
  color: var(--color-text-secondary);
  margin-top: 6rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-chevron {
  font-size: 40rpx;
  color: var(--color-text-disabled);
  font-weight: 300;
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* ===== 巡检作业包（单一待办区域内的主任务卡片）===== */
.plan-card {
  margin: 0 var(--space-8) var(--space-4);
  padding: 28rpx;
}

/* 巡检标识标签（卡片顶部，明确标示这是巡检任务） */
.plan-inspection-label {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 16rpx;
}
.pil-icon {
  width: 28rpx;
  height: 28rpx;
  border-radius: 8rpx;
  background: var(--color-primary-surface);
  position: relative;
  flex-shrink: 0;
}
.pil-icon::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 14rpx;
  height: 8rpx;
  border-left: 3rpx solid var(--color-primary);
  border-bottom: 3rpx solid var(--color-primary);
  transform: translate(-50%, -60%) rotate(-45deg);
}
.pil-text {
  font-size: var(--font-callout);
  font-weight: var(--font-weight-semibold);
  color: var(--color-primary);
}

.plan-sites {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.site-chip {
  font-size: var(--font-caption-1);
  color: var(--color-text-tertiary);
  background: var(--color-muted);
  padding: 4rpx 16rpx;
  border-radius: var(--radius-xs);
  line-height: 1.4;
  font-weight: var(--font-weight-medium);
}

/* 进度 */
.plan-progress {
  margin-bottom: 24rpx;
}

.progress-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.progress-label {
  font-size: var(--font-callout);
  color: var(--color-text-secondary);
}

.progress-percent {
  font-size: var(--font-callout);
  font-weight: var(--font-weight-semibold);
  color: var(--color-primary);
}

.progress-track {
  height: 12rpx;
  background: var(--color-muted);
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: var(--color-primary);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

/* 资源行 */
.plan-resources {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx 28rpx;
  margin-bottom: 28rpx;
}

.res-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.res-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.dot-green { background: var(--color-success); }
.dot-orange { background: var(--color-warning); }
.dot-blue { background: var(--color-primary); }
.dot-gray { background: var(--color-text-tertiary); }

.res-text {
  font-size: var(--font-footnote);
  color: var(--color-text-secondary);
}

.plan-action-btn {
  width: 100%;
  height: 96rpx;
  border-radius: var(--radius-xl);
  font-size: var(--font-body);
  font-weight: var(--font-weight-medium);
}

/* ===== 无作业包空态（对齐 empty-state 组件） ===== */
.plan-empty-card {
  margin: 0 var(--space-8) var(--space-4);
  padding: 56rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-icon-shape {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f2f2f7;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  position: relative;
}
.empty-icon-shape::before {
  content: '';
  width: 44rpx;
  height: 52rpx;
  border: 3rpx solid #c7c7cc;
  border-radius: 6rpx;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}
.empty-icon-shape::after {
  content: '';
  width: 22rpx;
  height: 3rpx;
  background: #c7c7cc;
  position: absolute;
  top: calc(50% - 12rpx);
  left: 50%;
  transform: translateX(-50%);
  box-shadow: 0 10rpx 0 #c7c7cc, 0 20rpx 0 #c7c7cc;
}

.empty-title-sm {
  font-size: var(--font-body);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  margin-bottom: 8rpx;
}

.plan-empty-card .link-btn {
  margin-top: 8rpx;
}

/* ===== 运维概览（list-group）=====
   标题：--font-body 28rpx/600
   数值：--font-body 28rpx/500（与标题同字号，靠字重区分）
   原因分项：--font-caption-1 22rpx/500
   分隔线：左缩进 52rpx（对齐内容起始位置） */
.ov-group {
  margin: 0 32rpx 16rpx;
  padding: 0 28rpx;
  overflow: hidden;
}

.ov-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  transition: opacity 0.15s ease;
  min-height: 88rpx;
  box-sizing: border-box;
}

.ov-row:active {
  opacity: 0.85;
}

.ov-row-left {
  display: flex;
  align-items: center;
  min-width: 0;
}

.ov-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.ov-title {
  font-size: var(--font-body);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  flex-shrink: 0;
}

.ov-row-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  max-width: 60%;
}

.ov-value {
  font-size: var(--font-body);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  white-space: nowrap;
}

.ov-value--warning {
  color: var(--color-warning);
}

.ov-value--success {
  color: var(--color-success);
}

.ov-value--muted {
  color: var(--color-text-tertiary);
  font-weight: 500;
}

.ov-loading {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
}

.ov-fail {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.ov-fail-tx {
  font-size: 24rpx;
  color: var(--color-error);
}

.ov-fail-retry {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 500;
}

.ov-chevron {
  font-size: 32rpx;
  color: var(--color-text-disabled);
  flex-shrink: 0;
  line-height: 1;
}

.ov-sub {
  padding: 0 0 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 24rpx;
}

.ov-sub-item {
  font-size: var(--font-caption-1);
  color: var(--color-text-secondary);
  line-height: 1.5;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.ov-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

/* 语义色点：严格遵循铁律第2条
   成功/正常=绿  等待用户动作=橙  异常/失败=红  信息/进行中=蓝  中性=灰 */
.ov-dot--success { background: var(--color-success); }
.ov-dot--warning { background: var(--color-warning); }
.ov-dot--error { background: var(--color-error); }
.ov-dot--gray { background: var(--color-text-disabled); }
.ov-dot--yellow { background: #ffcc00; }
.ov-dot--blue { background: var(--color-primary); }

.ov-sub--success {
}

.ov-sub-success-tx {
  font-size: var(--font-caption-1);
  color: var(--color-success);
  line-height: 1.5;
}

.ov-sub--muted {
}

.ov-sub-muted-tx {
  font-size: var(--font-caption-1);
  color: var(--color-text-tertiary);
  line-height: 1.5;
}

.ov-refresh-fail {
  padding: 0 0 20rpx;
}

.ov-refresh-fail-tx {
  font-size: var(--font-caption-1);
  color: var(--color-error);
  line-height: 1.4;
}

.ov-divider {
  height: 1rpx;
  background: var(--color-divider);
  margin-left: 0;
}

/* ===== 全部工单入口（低强调导航行，对齐 list-row 规格） ===== */
.workorder-entry {
  margin: 0 32rpx 20rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--color-card);
  border-radius: var(--radius-xl);
}

.wo-entry-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: var(--color-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.wo-entry-ico-img {
  width: 30rpx;
  height: 30rpx;
  display: block;
  opacity: 0.85;
}

.wo-entry-text {
  flex: 1;
  min-width: 0;
}

.wo-entry-title {
  font-size: var(--font-body);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  display: block;
  line-height: 1.3;
}

.wo-entry-subtitle {
  font-size: var(--font-footnote);
  color: var(--color-text-tertiary);
  margin-top: 4rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wo-entry-chevron {
  font-size: 36rpx;
  color: var(--color-text-disabled);
  font-weight: 300;
  flex-shrink: 0;
}

/* ===== 待我审核 ===== */
.review-card {
  margin: 0 32rpx 24rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.review-icon-circle {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: var(--color-primary-surface);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
}

.review-checkmark {
  width: 32rpx;
  height: 18rpx;
  border-left: 5rpx solid var(--color-primary);
  border-bottom: 5rpx solid var(--color-primary);
  transform: rotate(-45deg);
  margin-top: -6rpx;
}

.review-content {
  flex: 1;
  min-width: 0;
}

.review-title {
  font-size: var(--font-headline);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  display: block;
}

.review-subtitle {
  font-size: var(--font-footnote);
  color: var(--color-text-tertiary);
  margin-top: 6rpx;
  display: block;
}

.review-chevron {
  font-size: 40rpx;
  color: var(--color-text-disabled);
  font-weight: 300;
  flex-shrink: 0;
}

/* ============================================================
   角色化布局样式
   设计原则：promoted/secondary 是业务优先级，不是字号升级。
   靠位置、卡片尺寸、间距体现权重，同级内容共用同一套 Token。
   ============================================================ */

/* ===== Section 板块标题（基础态）=====
   语义：板块分组标题，消费 --font-footnote
   所有 section title 字号一致；promoted/secondary 只调间距，不改字号
   角色权重靠排序、卡片尺寸、间距体现，不靠换字号 */
.section-header {
  padding: 16rpx 32rpx 12rpx;
  display: flex;
  align-items: center;
}
.section-title {
  font-size: var(--font-footnote);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-tertiary);
  letter-spacing: 0;
  line-height: 1.4;
}

/* Section 标题 — 提升态（角色主任务区标题）
   只调上边距和字重微调，字号与标准态完全一致 */
.section-header--promoted {
  padding-top: 8rpx;
  padding-bottom: 12rpx;
}
.section-header--promoted .section-title {
  font-size: var(--font-footnote);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-secondary);
}

/* Section 标题 — 次级态（非主任务模块标题）
   字号/字重与基础态一致，只调上边距增加分隔感 */
.section-header--secondary {
  padding-top: 20rpx;
}
.section-header--secondary .section-title {
  font-size: var(--font-footnote);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-tertiary);
}

/* 审核卡片 — 提升态（reviewer 主任务）
   只加 padding 和图标尺寸，标题字号不变 */
.review-card--promoted {
  padding: 32rpx 28rpx;
  margin: 0 32rpx 20rpx;
  gap: 20rpx;
}
.review-icon-circle--promoted {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
}
.review-icon-circle--promoted .review-checkmark {
  width: 36rpx;
  height: 20rpx;
  border-left-width: 5rpx;
  border-bottom-width: 5rpx;
  margin-top: -6rpx;
}
.review-title--promoted {
  font-size: var(--font-headline);
  font-weight: var(--font-weight-semibold);
}

/* 运维概览 — 提升态（admin 主任务）
   只加 padding 和间距，标题/数值字号与基础态完全一致 */
.ov-group--promoted {
  margin: 0 32rpx 20rpx;
  padding: 4rpx 28rpx;
}
.ov-title--promoted {
  font-size: var(--font-body);
  font-weight: var(--font-weight-semibold);
}
.ov-value--promoted {
  font-size: var(--font-body);
  font-weight: var(--font-weight-medium);
}

/* 其他待办分隔标签（仅在巡检作业包和其他待办同时存在时显示）
   视觉层级：轻分隔，比 section title 更弱，不抢巡检主任务的注意力 */
.other-tasks-label {
  padding: 12rpx 32rpx 8rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.other-tasks-text {
  font-size: var(--font-caption-1);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-tertiary);
}
.other-tasks-label::before,
.other-tasks-label::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: var(--color-divider);
  opacity: 0.5;
}
.other-tasks-label::before {
  display: none; /* 只保留右侧分隔线，左侧对齐 section 标题节奏 */
}

/* 行动卡片 — 次级态（reviewer/admin 下弱化）
   只减 padding 和间距，标题/副标题字号与基础态完全一致
   角色权重靠卡片尺寸和位置体现，不靠文字降级 */
.action-card--secondary {
  margin: 0 32rpx 12rpx;
  padding: 20rpx 24rpx;
}
.action-card--secondary .action-title {
  font-size: var(--font-headline);
  font-weight: var(--font-weight-semibold);
  margin-top: 8rpx;
}
.action-card--secondary .action-subtitle {
  font-size: var(--font-footnote);
  margin-top: 4rpx;
}
.action-card--secondary .action-tags .tag {
  font-size: var(--font-caption-2);
  padding: 2rpx 12rpx;
}

/* 作业包卡片 — 次级态（reviewer/admin 下弱化）
   只调间距/padding，进度/资源文本字号与基础态一致 */
.plan-card--secondary {
  margin: 0 32rpx 16rpx;
  padding: 24rpx;
}
.plan-card--secondary .plan-sites .site-chip {
  font-size: var(--font-caption-1);
  padding: 4rpx 14rpx;
}
.plan-card--secondary .plan-progress {
  margin: 12rpx 0 20rpx;
}
.plan-card--secondary .progress-label {
  font-size: var(--font-callout);
}
.plan-card--secondary .progress-percent {
  font-size: var(--font-callout);
}
.plan-card--secondary .plan-resources {
  margin-bottom: 20rpx;
}
.plan-card--secondary .res-text {
  font-size: var(--font-footnote);
}

/* ===== 底部 tabBar 占位 ===== */
.tabbar-spacer {
  height: calc(120rpx + env(safe-area-inset-bottom));
}
