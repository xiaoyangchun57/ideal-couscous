/* pages/index/index.wxss */

/* ===== 导航栏 ===== */
.nav-home-left {
  display: flex;
  align-items: center;
  height: 100%;
}

.nav-home-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.nav-bell-wrap {
  height: 100%;
  display: flex;
  align-items: center;
  position: relative;
  padding-left: 16rpx;
}

/* ===== 问候区 ===== */
.greeting-area {
  padding: 12rpx 32rpx 24rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.greeting-logo {
  width: 104rpx;
  height: 104rpx;
  flex-shrink: 0;
  display: block;
  margin-right: 20rpx;
}

.greeting-main {
  flex: 1;
  min-width: 0;
  padding-top: 4rpx;
}

.greeting-name {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: -1rpx;
  line-height: 1.2;
  display: block;
}

.greeting-date {
  font-size: 26rpx;
  color: var(--text-tertiary);
  margin-top: 8rpx;
  display: block;
}

.greeting-bell {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: -8rpx;
  flex-shrink: 0;
}

.bell-icon {
  width: 48rpx;
  height: 48rpx;
  display: block;
  opacity: 0.9;
}

.bell-badge {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  min-width: 32rpx;
  height: 32rpx;
  background: var(--destructive);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 600;
  border-radius: 9999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  line-height: 1;
  border: 3rpx solid #ffffff;
  z-index: 3;
}

/* ===== 骨架屏 ===== */
.loading-skeleton {
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.skeleton-action {
  height: 160rpx;
  background: var(--card);
  border-radius: 24rpx;
  animation: shimmer 1.5s ease-in-out infinite;
}

.skeleton-plan {
  height: 360rpx;
  background: var(--card);
  border-radius: 24rpx;
  animation: shimmer 1.5s ease-in-out infinite;
  animation-delay: 0.2s;
}

@keyframes shimmer {
  0% { opacity: 0.6; }
  50% { opacity: 1; }
  100% { opacity: 0.6; }
}

/* ===== 首次加载失败（对齐 empty-state error 变体） ===== */
.error-card {
  margin: 24rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 32rpx;
  text-align: center;
}

.error-icon-shape {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 59, 48, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  margin-bottom: 20rpx;
}
.error-icon-shape::before {
  content: '!';
  font-size: 44rpx;
  font-weight: 600;
  color: var(--destructive);
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.error-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.error-subtitle {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.error-retry-btn {
  margin-top: 20rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--primary);
}

/* ===== 刷新失败提示条 ===== */
.refresh-error-bar {
  margin: 0 32rpx 16rpx;
  background: rgba(255, 59, 48, 0.06);
  color: var(--destructive);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.re-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--destructive);
  flex-shrink: 0;
}

.re-retry {
  margin-left: auto;
  font-weight: 600;
}

/* ===== 今日行动卡片 ===== */
.action-card {
  display: flex;
  align-items: center;
  padding: 28rpx;
  margin: 0 32rpx 20rpx;
}

.action-content {
  flex: 1;
  min-width: 0;
}

.action-tags {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.action-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-top: 14rpx;
  display: block;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-chevron {
  font-size: 40rpx;
  color: var(--text-quaternary);
  font-weight: 300;
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* ===== 今日作业包 ===== */
.plan-card {
  margin: 0 32rpx 20rpx;
  padding: 28rpx;
}

.plan-sites {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.site-chip {
  font-size: 22rpx;
  color: #8e8e93;
  background: #f2f2f7;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  line-height: 1.4;
  font-weight: 500;
}

/* 进度 */
.plan-progress {
  margin-bottom: 24rpx;
}

.progress-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.progress-label {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.progress-percent {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary);
}

.progress-track {
  height: 12rpx;
  background: #e5e5ea;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: var(--primary);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

/* 资源行 */
.plan-resources {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx 28rpx;
  margin-bottom: 28rpx;
}

.res-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.res-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.dot-green { background: var(--success); }
.dot-orange { background: var(--warning); }
.dot-blue { background: var(--primary); }
.dot-gray { background: var(--text-tertiary); }

.res-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.plan-action-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 500;
}

/* ===== 无作业包空态（对齐 empty-state 组件） ===== */
.plan-empty-card {
  margin: 0 32rpx 20rpx;
  padding: 56rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-icon-shape {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f2f2f7;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  position: relative;
}
.empty-icon-shape::before {
  content: '';
  width: 44rpx;
  height: 52rpx;
  border: 3rpx solid #c7c7cc;
  border-radius: 6rpx;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}
.empty-icon-shape::after {
  content: '';
  width: 22rpx;
  height: 3rpx;
  background: #c7c7cc;
  position: absolute;
  top: calc(50% - 12rpx);
  left: 50%;
  transform: translateX(-50%);
  box-shadow: 0 10rpx 0 #c7c7cc, 0 20rpx 0 #c7c7cc;
}

.empty-title-sm {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.plan-empty-card .link-btn {
  margin-top: 8rpx;
}

/* ===== 运维概览（list-group） ===== */
.ov-group {
  margin: 0 32rpx 20rpx;
  padding: 0 28rpx;
  overflow: hidden;
}

.ov-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  transition: opacity 0.15s ease;
}

.ov-row:active {
  opacity: 0.85;
}

.ov-row-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}

.ov-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.ov-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  flex-shrink: 0;
}

.ov-row-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  max-width: 60%;
}

.ov-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  white-space: nowrap;
}

.ov-value--warning {
  color: var(--color-warning);
}

.ov-value--success {
  color: var(--color-success);
}

.ov-value--muted {
  color: var(--color-text-tertiary);
  font-weight: 500;
}

.ov-loading {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
}

.ov-fail {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.ov-fail-tx {
  font-size: 24rpx;
  color: var(--color-error);
}

.ov-fail-retry {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 500;
}

.ov-chevron {
  font-size: 32rpx;
  color: var(--color-text-disabled);
  flex-shrink: 0;
  line-height: 1;
}

.ov-sub {
  padding: 0 0 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 24rpx;
  padding-left: 52rpx;
}

.ov-sub-item {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.ov-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.ov-dot--success { background: var(--color-success); }
.ov-dot--warning { background: var(--color-warning); }
.ov-dot--error { background: var(--color-error); }
.ov-dot--gray { background: var(--color-text-disabled); }
.ov-dot--yellow { background: #ffcc00; }

.ov-sub--success {
  padding-left: 52rpx;
}

.ov-sub-success-tx {
  font-size: 22rpx;
  color: var(--color-success);
  line-height: 1.5;
}

.ov-sub--muted {
  padding-left: 52rpx;
}

.ov-sub-muted-tx {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  line-height: 1.5;
}

.ov-refresh-fail {
  padding: 0 0 20rpx;
  padding-left: 52rpx;
}

.ov-refresh-fail-tx {
  font-size: 22rpx;
  color: var(--color-error);
  line-height: 1.4;
}

.ov-divider {
  height: 1rpx;
  background: var(--color-divider);
  margin-left: 52rpx;
}

/* ===== 全部工单入口（低强调导航行） ===== */
.workorder-entry {
  margin: 0 32rpx 20rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--card);
  border-radius: 16rpx;
}

.wo-entry-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: var(--muted);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.wo-entry-ico-img {
  width: 30rpx;
  height: 30rpx;
  display: block;
  opacity: 0.85;
}

.wo-entry-text {
  flex: 1;
  min-width: 0;
}

.wo-entry-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
  line-height: 1.3;
}

.wo-entry-subtitle {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 4rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wo-entry-chevron {
  font-size: 36rpx;
  color: var(--text-quaternary);
  font-weight: 300;
  flex-shrink: 0;
}

/* ===== 待我审核 ===== */
.review-card {
  margin: 0 32rpx 24rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.review-icon-circle {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: var(--accent);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
}

.review-checkmark {
  width: 32rpx;
  height: 18rpx;
  border-left: 5rpx solid var(--primary);
  border-bottom: 5rpx solid var(--primary);
  transform: rotate(-45deg);
  margin-top: -6rpx;
}

.review-content {
  flex: 1;
  min-width: 0;
}

.review-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
}

.review-subtitle {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-top: 6rpx;
  display: block;
}

.review-chevron {
  font-size: 40rpx;
  color: var(--text-quaternary);
  font-weight: 300;
  flex-shrink: 0;
}

/* ===== 底部 tabBar 占位 ===== */
.tabbar-spacer {
  height: calc(120rpx + env(safe-area-inset-bottom));
}
