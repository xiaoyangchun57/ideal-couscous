}

.adt-value-block {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-bottom: 10rpx;
}

.adt-value-num {
  font-size: 64rpx;
  font-weight: 700;
  color: var(--color-error);
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.adt-value-unit {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
