.adt-value-na {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-tertiary);
  line-height: 1.2;
}

.adt-threshold {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  line-height: 1.4;
}

