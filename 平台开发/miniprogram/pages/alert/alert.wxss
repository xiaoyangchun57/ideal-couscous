/* ===== 告警页 ===== */

.alert-page {
  min-height: 100vh;
  background: var(--color-background);
  padding-bottom: calc(env(safe-area-inset-bottom) + 120rpx);
}

/* 导航栏标题（compact 规范：17px / 600，微信平台左对齐） */
.alert-nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

/* ===== 同步提示条 ===== */
.sync-bar {
  margin: 16rpx 32rpx 0;
  background: var(--color-info-surface);
  color: var(--color-info);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-weight: 500;
}

.sync-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  position: relative;
}

.sync-icon::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid var(--color-info);
  border-top-color: transparent;
  border-radius: 50%;
  transform: translate(-50%, -50%) rotate(0deg);
}

.sync-text {
  flex: 1;
  color: var(--color-info);
}

.sync-action {
  font-weight: 600;
  color: var(--color-info);
  flex-shrink: 0;
}

/* ===== 分段控件（iOS segmented-control 规范） ===== */
.segment-wrap {
  padding: 24rpx 32rpx 16rpx;
}

.segment-control {
  display: flex;
  background: var(--color-type-bg);
  border-radius: var(--radius-sm);
  padding: 4rpx;
}

.segment-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  padding: 18rpx 0;
  color: var(--color-text-secondary);
  border-radius: calc(var(--radius-sm) - 2rpx);
  transition: all 0.2s ease;
  font-weight: 500;
}

.segment-item.active {
  background: var(--color-card);
  color: var(--color-text-primary);
  font-weight: 600;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
}

/* ===== 告警卡片列表 ===== */
.alert-list {
  padding: 8rpx 32rpx 0;
}

.alert-card {
  background: var(--color-card);
  border-radius: var(--radius-xl);
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.alert-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.alert-station {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.3;
  flex: 1;
  min-width: 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  word-break: break-all;
}

/* 级别标签（surface 样式，对齐 status-chip 规范） */
.alert-level-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 500;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-xs);
  line-height: 1.4;
  flex-shrink: 0;
  white-space: nowrap;
}

.chip-red { background: var(--color-error-surface); color: var(--color-error); }
.chip-orange { background: var(--color-warning-surface); color: var(--color-warning); }
.chip-yellow {
  background: var(--color-notice-surface);
  color: var(--color-notice);
}
.chip-blue { background: var(--color-info-surface); color: var(--color-info); }
.chip-gray { background: var(--color-type-bg); color: var(--color-type-text); }

/* 指标名（卡片核心语义，第二行） */
.alert-metric {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  line-height: 1.4;
  display: block;
  margin-top: 6rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  word-break: break-all;
}

/* 事实行：标签 + 数值 + 阈值 */
.alert-fact-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 14rpx;
}

.alert-fact-label {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  flex-shrink: 0;
}

.alert-fact-value {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  min-width: 0;
  flex: 1;
}

.alert-value-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.2;
  word-break: break-all;
  text-align: right;
}

.alert-value-unit {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  margin-left: 4rpx;
  font-weight: 400;
}

.alert-threshold-text {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  line-height: 1.3;
  text-align: right;
  word-break: break-all;
}

.alert-value-na {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  font-style: italic;
  text-align: right;
}

.alert-card-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--color-divider);
}

.alert-time {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.alert-phase {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.alert-phase-text {
  font-size: 26rpx;
  font-weight: 500;
}

/* 状态文字色 */
.phase-pending { color: var(--color-warning); }
.phase-acknowledged { color: var(--color-primary); }
.phase-processing { color: var(--color-primary); }
.phase-resolved { color: var(--color-success); }
.phase-reviewing { color: var(--color-warning); }
.phase-cleared { color: var(--color-success); }
.phase-closed { color: var(--color-success); }
.phase-management_review { color: var(--color-text-tertiary); }

/* 右侧箭头 */
.alert-arrow {
  border-right-color: var(--color-icon-primary);
  border-bottom-color: var(--color-icon-primary);
}

/* ===== 空态（对齐 empty-state 组件规范） ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx;
}

.empty-icon {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--color-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  position: relative;
}

.empty-icon-success {
  background: var(--color-muted);
}

/* 对勾 */
.empty-check {
  width: 48rpx;
  height: 28rpx;
  border-left: 5rpx solid var(--color-icon-tertiary);
  border-bottom: 5rpx solid var(--color-icon-tertiary);
  transform: rotate(-45deg);
  margin-top: -8rpx;
}

/* 铃铛 */
.empty-bell {
  width: 44rpx;
  height: 48rpx;
  position: relative;
  background: var(--color-icon-tertiary);
  border-radius: 50% 50% 0 0;
  margin-top: -6rpx;
}

.empty-bell::before {
  content: '';
  position: absolute;
  bottom: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 52rpx;
  height: 10rpx;
  background: var(--color-icon-tertiary);
  border-radius: 5rpx;
}

.empty-bell::after {
  content: '';
  position: absolute;
  top: -12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 20rpx;
  height: 12rpx;
  background: var(--color-icon-tertiary);
  border-radius: 10rpx 10rpx 0 0;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  text-align: center;
  line-height: 1.5;
}

/* ===== 骨架屏 ===== */
.skeleton-list .skeleton-card {
  background: var(--color-card);
}

.skeleton-line {
  height: 24rpx;
  background: var(--color-muted);
  border-radius: var(--radius-sm);
}

.skeleton-line-sm {
  width: 30%;
  margin-bottom: 16rpx;
}

.skeleton-line-md {
  width: 60%;
  margin-bottom: 12rpx;
}

.skeleton-line-lg {
  width: 90%;
  margin-top: 8rpx;
}

.skeleton-card {
  animation: skeletonPulse 1.5s ease-in-out infinite;
}

@keyframes skeletonPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.6; }
}

.bottom-spacer {
  height: 32rpx;
}

/* ===== Sheet 弹层 ===== */
.sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
}


/* ===== Bottom Sheet 容器 ===== */
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--color-card);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  z-index: 101;
  max-height: 75vh;
  display: flex;
  flex-direction: column;
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  background: var(--color-divider);
  border-radius: 4rpx;
  margin: 16rpx auto;
  flex-shrink: 0;
}

.sheet-scroll {
  flex: 1 1 0;
  height: 0;
  overflow-y: auto;
  min-height: 0;
}

.sheet-content-spacer {
  height: 32rpx;
}

/* ===== Sheet 头部 ===== */
.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 40rpx 20rpx;
  flex-shrink: 0;
}

.sheet-header-close {
  min-width: 88rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: -20rpx;
}

/* ===== Status Chip（页面级补充状态类） ===== */
.status-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-xs);
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.4;
  white-space: nowrap;
}

.chip-red { background: var(--color-error-surface); color: var(--color-error); }
.chip-orange { background: var(--color-warning-surface); color: var(--color-warning); }
.chip-yellow { background: var(--color-notice-surface); color: var(--color-notice); }
.chip-blue { background: var(--color-info-surface); color: var(--color-info); }
.chip-info { background: var(--color-info-surface); color: var(--color-info); }
.chip-gray { background: var(--color-type-bg); color: var(--color-type-text); }
.chip-green { background: var(--color-success-surface); color: var(--color-success); }

/* 状态对应的 chip 语义色 */
.chip-pending { background: var(--color-warning-surface); color: var(--color-warning); }
.chip-acknowledged { background: var(--color-info-surface); color: var(--color-info); }
.chip-processing { background: var(--color-info-surface); color: var(--color-info); }
.chip-resolved { background: var(--color-success-surface); color: var(--color-success); }
.chip-reviewing { background: var(--color-warning-surface); color: var(--color-warning); }
.chip-cleared { background: var(--color-success-surface); color: var(--color-success); }
.chip-closed { background: var(--color-success-surface); color: var(--color-success); }
.chip-management_review { background: var(--color-type-bg); color: var(--color-type-text); }

/* ===== 异常主事实区 ===== */
.adt-main-fact {
  padding: 8rpx 40rpx 28rpx;
}

.adt-station {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.3;
  word-break: break-all;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.adt-metric {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-secondary);
  line-height: 1.4;
  margin-bottom: 20rpx;
  word-break: break-all;
}

.adt-value-block {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.adt-value-num {
  font-size: 48rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.1;
}

.adt-value-unit {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  font-weight: 400;
}

.adt-value-na {
  font-size: 30rpx;
  color: var(--color-text-tertiary);
  font-style: italic;
}

.adt-threshold {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  line-height: 1.3;
}

/* ===== 当前状态行 ===== */
.adt-status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 40rpx 20rpx;
  gap: 20rpx;
}

.adt-status-label {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
}

/* ===== 分隔线 ===== */
.adt-divider {
  height: 0.5rpx;
  background: var(--color-divider);
  margin: 0 40rpx;
}

/* ===== 关联工单行（只读信息） ===== */
.adt-related {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 40rpx;
  gap: 20rpx;
}

.adt-related-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
  min-width: 0;
}

.adt-related-no {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
  word-break: break-all;
}

.adt-related-handler {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

/* ===== 信息分组 ===== */
.adt-group {
  padding: 0 40rpx 12rpx;
}

.adt-group-title {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--color-text-tertiary);
  padding: 28rpx 0 16rpx;
}

.adt-info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 20rpx 0;
  border-top: 0.5rpx solid var(--color-divider);
  gap: 24rpx;
}

.adt-info-row--last {
  padding-bottom: 0;
}

.adt-info-label {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  flex-shrink: 0;
}

.adt-info-value {
  font-size: 28rpx;
  color: var(--color-text-primary);
  text-align: right;
  flex: 1;
  min-width: 0;
  line-height: 1.5;
}

.adt-info-value--multi {
  text-align: right;
  word-break: break-all;
}

/* ===== Sheet 底部操作栏 ===== */
.sheet-bottom-bar {
  padding: 20rpx 40rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 0.5rpx solid var(--color-divider);
  background: var(--color-card);
  flex-shrink: 0;
}

/* 按钮 lg 尺寸（页面级补充） */
.btn-lg {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: var(--radius-lg);
  font-size: 30rpx;
  font-weight: 500;
  border: none;
}

.btn-lg::after {
  border: none;
}

/* ============================================================
 *  Sheet 布局修复 + 告警详情视觉收口
 *  说明：统一 flex 滚动布局，确保正文非零高度，加强信息层级
 * ============================================================ */

/* --- Sheet 容器：与工单详情保持一致的布局规范 --- */
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--color-card);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  z-index: 101;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  background: var(--color-divider);
  border-radius: 4rpx;
  margin: 16rpx auto;
  flex-shrink: 0;
}

.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 40rpx 12rpx;
  flex-shrink: 0;
  min-height: 68rpx;
  box-sizing: border-box;
}

.sheet-header-close {
  min-width: 88rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: -24rpx;
  flex-shrink: 0;
}

.sheet-header-close .ico-close::before,
.sheet-header-close .ico-close::after {
  background: var(--color-text-tertiary);
}

/* 正文滚动区：flex: 0 1 auto + min-height: 0
   内容少时紧凑收束，内容多时 Sheet 达 max-height 后 flex-shrink 压缩并滚动 */
.sheet-scroll {
  flex: 0 1 auto;
  min-height: 0;
  overflow-y: auto;
}

.sheet-content-spacer {
  height: 32rpx;
  flex-shrink: 0;
}

.sheet-bottom-bar {
  padding: 12rpx 40rpx;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  border-top: 0.5rpx solid var(--color-divider);
  background: var(--color-card);
  flex-shrink: 0;
}

/* PM-15 alert detail: isolate the new shell from the historical .sheet stack. */
.alert-detail-sheet {
  background: var(--color-card);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
}
.alert-detail-scroll {
  overflow-y: hidden;
}
.alert-detail-sheet .adt-main-fact {
  padding-right: 128rpx;
}
.alert-detail-close .ico-close::before,
.alert-detail-close .ico-close::after {
  background: var(--color-text-tertiary);
}

/* --- 告警详情内容视觉优化 --- */

/* 主事实区：监测值大字突出 */
.adt-main-fact {
  padding: 8rpx 40rpx 28rpx;
}

.adt-station {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.4;
  margin-bottom: 8rpx;
}

