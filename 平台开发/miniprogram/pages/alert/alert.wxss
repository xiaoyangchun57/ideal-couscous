/* 信息行（流转阶段 / 告警详情） */
.adt-info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 16rpx 40rpx;
  gap: 20rpx;
}

.adt-info-row--last {
