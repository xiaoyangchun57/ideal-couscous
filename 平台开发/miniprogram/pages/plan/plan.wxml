<view class="page">
  <!-- 自定义导航栏：标题 + 范围切换 -->
  <custom-navbar showBorder="{{true}}">
    <view slot="left" class="nav-plan-left">
      <text class="nav-plan-title">巡检计划</text>
      <view class="scope-toggle" bindtap="onToggleScope" wx:if="{{canSwitchTeam}}">
        <text>{{scope === 'team' ? '团队计划' : '我的计划'}}</text>
        <text class="scope-arrow">▾</text>
      </view>
    </view>
  </custom-navbar>

  <!-- 范围切换中提示 -->
  <view class="scope-pending-bar" wx:if="{{pendingScope}}">
    <view class="spinner-mini"></view>
    <text>切换至{{pendingScope === 'team' ? '团队计划' : '我的计划'}}...</text>
  </view>

  <!-- iOS 分段筛选控件 -->
  <view class="segment-wrap">
    <view class="segment-control">
      <view class="segment-item {{filter === 'all' ? 'active' : ''}}" data-f="all" bindtap="onFilterTap">全部</view>
      <view class="segment-item {{filter === 'draft' ? 'active' : ''}}" data-f="draft" bindtap="onFilterTap">草稿箱</view>
      <view class="segment-item {{filter === 'active' ? 'active' : ''}}" data-f="active" bindtap="onFilterTap">进行中</view>
      <view class="segment-item {{filter === 'done' ? 'active' : ''}}" data-f="done" bindtap="onFilterTap">已完成</view>
    </view>
  </view>

  <!-- 工具行：常用计划 + 新建计划 -->
  <view class="tools-row">
    <view class="tool-btn" bindtap="onOpenFavorites" wx:if="{{favoritesVisible}}">
      <view class="tool-icon-star"></view>
      <text class="tool-text">常用计划</text>
      <text class="tool-chevron">›</text>
    </view>
    <view class="tool-btn tool-btn-primary" bindtap="onNewPlan">
      <view class="tool-icon-plus"></view>
      <text class="tool-text">新建计划</text>
      <text class="tool-chevron">›</text>
    </view>
  </view>

  <!-- 刷新失败提示（保留旧数据） -->
  <view class="refresh-error-bar" wx:if="{{mainState === 'refresh_error'}}" bindtap="onRetryMain">
    <text class="re-dot"></text>
    <text>刷新失败，{{mainError}}</text>
    <text class="re-retry">点击重试</text>
  </view>

  <!-- 首次加载失败 -->
  <view class="error-card card" wx:if="{{mainState === 'blocking_error'}}" bindtap="onRetryMain">
    <view class="error-icon-shape"></view>
    <text class="error-title">计划加载失败</text>
    <text class="error-subtitle">{{mainError}}</text>
    <text class="error-retry-btn">点击重试</text>
  </view>

  <!-- 计划卡片列表 -->
  <block wx:if="{{mainState === 'ready' || mainState === 'refreshing' || mainState === 'refresh_error'}}">

    <!-- 列表 -->
    <view class="plan-list">
      <view class="plan-card-item card" wx:for="{{visiblePlans}}" wx:key="id" data-id="{{item.id}}" bindtap="onItemTap">
        <!-- 标签行 -->
        <view class="card-tags">
          <text class="tag tag-neutral">{{item.typeLabel}}</text>
          <text class="tag tag-{{item.statusCls}}">{{item.statusLabel}}</text>
        </view>

        <!-- 标题 -->
        <text class="card-title">{{item.title}}</text>

        <!-- 元信息行 -->
        <view class="card-meta">
          <text class="meta-item">{{item.periodLabel}}</text>
          <text class="meta-dot" wx:if="{{item.siteCount != null}}">·</text>
          <text class="meta-item" wx:if="{{item.siteCount != null}}">{{item.siteCount}}个站点</text>
          <text class="meta-dot" wx:if="{{scope === 'team' && item.ownerName}}">·</text>
          <text class="meta-item" wx:if="{{scope === 'team' && item.ownerName}}">{{item.ownerName}}</text>
        </view>

        <!-- 状态说明 -->
        <text class="card-status-note note-{{item.statusNoteTone}}" wx:if="{{item.statusNote}}">{{item.statusNote}}</text>

        <!-- 操作行 -->
        <view class="card-actions">
          <view class="action-link action-link-primary" data-id="{{item.id}}" catchtap="onItemTap" wx:if="{{item.primaryTarget.kind === 'detail'}}">
            <text>查看详情</text>
            <text class="link-chevron">›</text>
          </view>
          <view class="action-link action-link-primary" data-id="{{item.id}}" catchtap="onItemTap" wx:elif="{{item.primaryTarget.kind === 'edit'}}">
            <text>编辑计划</text>
            <text class="link-chevron">›</text>
          </view>
          <view class="action-link" data-id="{{item.id}}" catchtap="onSecondaryAction" data-action="continue_change" wx:if="{{item.secondaryAction === 'continue_change'}}">
            <text>继续变更</text>
          </view>
          <text class="action-delete" data-id="{{item.id}}" catchtap="onSecondaryAction" data-action="delete_draft" wx:if="{{item.secondaryAction === 'delete_draft'}}">删除</text>
        </view>
      </view>

      <!-- 空态 -->
      <view class="list-empty" wx:if="{{!visiblePlans.length}}">
        <!-- 全部 + 空：无计划空态 -->
        <block wx:if="{{filter === 'all'}}">
          <view class="empty-icon empty-icon-doc"></view>
          <text class="empty-title">暂无计划</text>
          <text class="empty-desc">在工具栏点击「新建计划」创建第一个巡检计划</text>
        </block>
        <!-- 筛选 + 空：筛选为空空态 -->
        <block wx:else>
          <view class="empty-icon empty-icon-filter"></view>
          <text class="empty-title">该筛选条件下无计划</text>
          <text class="empty-desc">试试切换其他筛选条件</text>
        </block>
      </view>
    </view>

  </block>

  <!-- 首次加载骨架屏 -->
  <view class="loading-skeleton" wx:if="{{mainState === 'initial_loading'}}">
    <view class="skeleton-card"></view>
    <view class="skeleton-card"></view>
    <view class="skeleton-card"></view>
  </view>

  <!-- 常用计划选择弹层 -->
  <view class="om-sheet-mask" wx:if="{{favoriteSheet.open}}" bindtap="onCloseFavorites"></view>
  <view class="om-sheet plan-favorite-sheet" wx:if="{{favoriteSheet.open}}">
    <view class="om-sheet-dismiss plan-favorite-close" bindtap="onCloseFavorites">
      <view class="ico ico-close"></view>
    </view>
    <scroll-view class="om-sheet-scroll plan-favorite-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="plan-favorite-heading">
      <text class="sheet-title">从常用计划创建</text>
      </view>

    <picker mode="selector" range="{{favorites}}" range-key="name" bindchange="onFavoritePick">
      <view class="picker-field">
        <text class="field-label">选择常用计划</text>
        <view class="input-field">
          <text>{{favorites[favoriteSheet.selectedIndex].name || '请选择'}}</text>
          <text class="picker-arrow">▾</text>
        </view>
      </view>
    </picker>

    <view class="form-row">
      <text class="field-label">作业起始日期</text>
      <picker mode="date" value="{{favoriteSheet.periodStart}}" bindchange="onFavoriteDate">
        <view class="input-field">
          <text>{{favoriteSheet.periodStart || '请选择日期'}}</text>
          <text class="picker-arrow">▾</text>
        </view>
      </picker>
    </view>

    <!-- 提交失败提示 -->
    <view class="sheet-error" wx:if="{{favoriteSheet.sheetState === 'error'}}">
      <text class="error-text">{{favoriteSheet.errorMessage}}</text>
      <text class="error-retry" catchtap="onCreateFavoriteDraft">重试</text>
    </view>

    </scroll-view>
    <view class="sheet-actions om-sheet-actions">
      <button class="btn-ghost btn-danger" bindtap="onDeleteFavorite" wx:if="{{favoriteSheet.selectedId}}">删除收藏</button>
      <button class="btn-primary" bindtap="onCreateFavoriteDraft" loading="{{favoriteSheet.sheetState === 'submitting'}}">创建草稿</button>
    </view>
  </view>

  <!-- tabBar 占位 -->
  <view class="tabbar-spacer"></view>
</view>
