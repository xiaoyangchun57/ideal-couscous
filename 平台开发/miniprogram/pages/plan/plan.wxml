<wxs module="ft">
  module.exports.filter = function(list, f) {
    if (f === 'active') {
      return list.filter(function(i) { return i.filter_group === 'active'; });
    }
    if (f === 'done') {
      return list.filter(function(i) { return i.filter_group === 'done'; });
    }
    return list;
  };
  module.exports.canEdit = function(status) {
    return status === 'draft' || status === 'rejected';
  };
</wxs>

<view class="page">
  <!-- 筛选 -->
  <view class="seg-strip">
    <view class="seg-item {{filter === 'all' ? 'seg-on' : ''}}" data-f="all" bindtap="onFilterTap">全部</view>
    <view class="seg-item {{filter === 'active' ? 'seg-on' : ''}}" data-f="active" bindtap="onFilterTap">进行中</view>
    <view class="seg-item {{filter === 'done' ? 'seg-on' : ''}}" data-f="done" bindtap="onFilterTap">已完成</view>
  </view>

  <view class="favorite-entry" wx:if="{{canUseFavorites}}" bindtap="onOpenFavorites">
    <view>
      <text class="favorite-entry-title">常用计划</text>
      <text class="favorite-entry-hint">复用固定站点、车辆和备件，直接生成草稿</text>
    </view>
    <text class="favorite-entry-action">{{favorites.length ? (favorites.length + ' 个 ›') : '暂无 ›'}}</text>
  </view>

  <view class="new-plan-entry" bindtap="onNewPlan">+ 新建排程</view>

  <view class="favorite-entry" wx:if="{{canTeamView}}" bindtap="onToggleRecommendationScope">
    <view>
      <text class="favorite-entry-title">{{isTeamView ? '团队异常复查建议' : '我的异常复查建议'}}</text>
      <text class="favorite-entry-hint">{{isTeamView ? '查看团队异常复查并通知负责人' : '查看本人异常复查建议'}}</text>
    </view>
    <text class="favorite-entry-action">{{isTeamView ? '返回我的复查 ›' : '查看团队复查 ›'}}</text>
  </view>

  <!-- 系统性异常只给出复查草稿建议，由人确认后进入同一排程审批链 -->
  <view class="card recommendation-card follow-up-card" wx:if="{{followUpRecommendations.length}}">
    <view class="recommendation-head" bindtap="onToggleFollowUpRecommendations">
      <view>
        <text class="recommendation-title">系统性异常复查</text>
        <text class="recommendation-hint">同站同类异常 30 天内出现 2 次，建议安排复查</text>
      </view>
      <view class="recommendation-summary-action">
        <text class="recommendation-count follow-up-count">{{followUpRecommendations.length}} 条</text>
        <text class="recommendation-toggle follow-up-count">{{followUpRecommendationsExpanded ? '收起' : '展开'}} ›</text>
      </view>
    </view>
    <block wx:if="{{followUpRecommendationsExpanded}}">
      <view class="recommendation-item" wx:for="{{followUpRecommendations}}" wx:key="follow_up_key">
        <view class="recommendation-main">
          <text class="recommendation-type follow-up-type">{{item.site_name}}</text>
          <text class="recommendation-text">{{item.anomaly_type}} · {{item.window_days}}天{{item.occurrence_count}}次</text>
          <text class="recommendation-period">最近一次：{{item.latest_at}}</text>
        </view>
        <button class="recommendation-btn follow-up-btn" size="mini" wx:if="{{!isTeamView}}" loading="{{creatingFollowUpKey === item.follow_up_key}}"
          data-user-id="{{item.user_id}}" data-site-id="{{item.site_id}}" data-anomaly-type="{{item.anomaly_type}}"
          bindtap="onCreateFollowUpDraft">建复查草稿</button>
        <button class="recommendation-btn follow-up-btn" size="mini" wx:else loading="{{creatingFollowUpKey === item.follow_up_key}}"
          data-user-id="{{item.user_id}}" data-site-id="{{item.site_id}}" data-anomaly-type="{{item.anomaly_type}}"
          bindtap="onNotifyFollowUpOwner">通知负责人</button>
      </view>
    </block>
  </view>

  <!-- 列表 -->
  <block wx:if="{{ft.filter(list, filter).length}}">
    <view class="card plan-card" wx:for="{{ft.filter(list, filter)}}" wx:key="id" bindtap="onItemTap" data-id="{{item.id}}">
      <view class="plan-top">
        <view class="plan-type-row">
          <text class="tag tag-brand">{{item.type_cn}}</text>
          <text class="tag tag-{{item.status_cls}}">{{item.status_cn}}</text>
        </view>
        <text class="plan-period">{{item.period_text}}</text>
      </view>
      <view class="plan-info">
        <text class="plan-stat">覆盖 {{item.site_count || 0}} 站 · {{item.day_count || 0}} 天</text>
        <text class="plan-time" wx:if="{{item.submitted_at}}">提交于 {{item.submitted_at}}</text>
      </view>
      <!-- 退回原因 -->
      <view class="plan-reject" wx:if="{{item.status === 'rejected' && item.reject_reason}}">
        退回原因：{{item.reject_reason}}
      </view>
      <!-- 操作 -->
      <view class="plan-actions" wx:if="{{ft.canEdit(item.status)}}">
        <view class="btn-sm btn-ghost" catchtap="onEdit" data-id="{{item.id}}">编辑</view>
        <view class="btn-sm btn-danger" catchtap="onDelete" data-id="{{item.id}}">删除</view>
      </view>
    </view>
  </block>

  <view class="empty" wx:elif="{{loaded}}">
    <view class="empty-circle"></view>
    <text class="empty-tx">暂无排程计划</text>
  </view>

  <view class="sheet-mask" wx:if="{{canUseFavorites && favoriteSheet.open}}" bindtap="onCloseFavorites"></view>
  <view class="sheet" wx:if="{{canUseFavorites && favoriteSheet.open}}">
    <view class="sheet-head"><text class="sheet-title">从常用计划生成草稿</text><text class="sheet-close" bindtap="onCloseFavorites">×</text></view>
    <view class="favorite-field-label">常用计划</view>
    <picker mode="selector" range="{{favorites}}" range-key="name" value="{{favoriteSheet.index}}" bindchange="onFavoritePick">
      <view class="favorite-picker">{{favorites[favoriteSheet.index].name}} ›</view>
    </picker>
    <view class="favorite-summary">
      {{favorites[favoriteSheet.index].type_cn}} · {{favorites[favoriteSheet.index].site_count}}站 · {{favorites[favoriteSheet.index].vehicle_day_count}}天用车
    </view>
    <view class="favorite-field-label">新周期开始日期</view>
    <picker mode="date" value="{{favoriteSheet.periodStart}}" bindchange="onFavoriteDate">
      <view class="favorite-picker">{{favoriteSheet.periodStart || '请选择日期'}} ›</view>
    </picker>
    <text class="favorite-hint">将按原计划的相对日期复用站点、车辆和备件；一次性工单、审批和执行记录不会复制。</text>
    <button class="btn-primary submit-btn" loading="{{favoriteSheet.submitting}}" disabled="{{favoriteSheet.submitting}}" bindtap="onCreateFavoriteDraft">生成并编辑草稿</button>
    <view class="favorite-delete" bindtap="onDeleteFavorite">删除此收藏</view>
  </view>

</view>
