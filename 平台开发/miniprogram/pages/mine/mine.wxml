<view class="page">
  <view class="card profile">
    <view class="avatar">{{realName[0]}}</view>
    <view class="profile-info">
      <text class="profile-name">{{realName}}</text>
      <text class="profile-role">{{roleCn}} · {{phone}}</text>
    </view>
  </view>

  <view class="card menu">
    <view class="menu-item" bindtap="goMessage">
      <text class="menu-tx">消息通知</text>
      <view class="menu-right"><text wx:if="{{unread > 0}}" class="badge">{{unread}}</text><text class="arrow">›</text></view>
    </view>
    <view class="hairline"></view>
    <view class="menu-item" bindtap="onOpenParts">
      <text class="menu-tx">我的备件申请</text>
      <view class="menu-right"><text class="menu-sub">{{partsRequests.length}} 条</text><text class="arrow">›</text></view>
    </view>
    <view class="hairline"></view>
    <view class="menu-item" bindtap="goReview">
      <text class="menu-tx">待我审核</text>
      <view class="menu-right"><text class="arrow">›</text></view>
    </view>
    <view class="hairline"></view>
    <view class="menu-item">
      <text class="menu-tx">负责站点</text>
      <text class="menu-right menu-sub">{{sitesCount}} 个</text>
    </view>
  </view>

  <view class="sheet-mask" wx:if="{{partsSheet.open}}" bindtap="onCloseParts"></view>
  <view class="sheet" wx:if="{{partsSheet.open}}"><view class="sheet-head"><text class="sheet-title">现场领用</text><text class="sheet-close" bindtap="onCloseParts">×</text></view><picker mode="selector" range="{{issuablePartsRequests}}" range-key="request_no" value="{{partsSheet.index}}" bindchange="onPartsPick"><view class="parts-picker">{{issuablePartsRequests[partsSheet.index].request_no}} · {{issuablePartsRequests[partsSheet.index].site_name}} ›</view></picker><input class="parts-input" type="number" value="{{partsSheet.quantity}}" bindinput="onIssueQty" placeholder="填写实际领用数量"/><text class="parts-hint">仅可领用已批准且已预留的备件</text><button class="btn-primary" loading="{{partsSheet.submitting}}" bindtap="onIssueParts">确认领用并扣库</button></view>

  <button class="btn-ghost logout" bindtap="onLogout">退出登录</button>
  <view class="ver">水质智慧运维 · 移动端</view>
</view>
