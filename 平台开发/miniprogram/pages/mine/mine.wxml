<view class="page">
  <!-- 自定义导航栏：空白（仅占位） -->
  <custom-navbar showBorder="{{false}}"></custom-navbar>

  <!-- 用户信息区 -->
  <view class="user-section">
    <view class="user-info-row">
      <view class="user-avatar">
        <text class="avatar-initials">{{realName[0] || '运'}}</text>
      </view>
      <view class="user-info-text">
        <text class="user-name">{{realName}}</text>
        <text class="user-title">{{roleCn}} · {{phone}} · {{sitesCount}}个负责站点</text>
      </view>
    </view>
  </view>

  <!-- 功能组1：日常工作 -->
  <view class="list-group">
    <view class="list-row" bindtap="goVehicle" hover-class="list-row-active" wx:if="{{canUseVehicle}}">
      <view class="list-row-left">
        <view class="row-icon icon-orange">
          <image class="row-icon-img" src="/images/mine/icon-vehicle.svg" mode="aspectFit"/>
        </view>
        <text class="list-row-text">我的用车</text>
      </view>
      <view class="list-row-right">
        <text class="list-row-hint">安排、行程与还车</text>
        <text class="row-chevron">›</text>
      </view>
    </view>

    <view class="list-row" bindtap="goReview" hover-class="list-row-active" wx:if="{{canReview}}">
      <view class="list-row-left">
        <view class="row-icon icon-blue">
          <image class="row-icon-img" src="/images/mine/icon-review.svg" mode="aspectFit"/>
        </view>
        <text class="list-row-text">审核待办</text>
      </view>
      <view class="list-row-right">
        <view class="badge-red" wx:if="{{reviewTodo > 0}}">{{reviewTodo}}</view>
        <text class="row-chevron">›</text>
      </view>
    </view>

    <view class="list-row" bindtap="goReports" hover-class="list-row-active">
      <view class="list-row-left">
        <view class="row-icon icon-blue">
          <image class="row-icon-img" src="/images/mine/icon-reports.svg" mode="aspectFit"/>
        </view>
        <text class="list-row-text">我的异常上报</text>
      </view>
      <view class="list-row-right">
        <text class="row-chevron">›</text>
      </view>
    </view>

    <view class="list-row" bindtap="goMessage" hover-class="list-row-active">
      <view class="list-row-left">
        <view class="row-icon icon-blue">
          <image class="row-icon-img" src="/images/mine/icon-bell.svg" mode="aspectFit"/>
        </view>
        <text class="list-row-text">消息通知</text>
      </view>
      <view class="list-row-right">
        <view class="badge-red" wx:if="{{unread > 0}}">{{unread > 99 ? '99+' : unread}}</view>
        <text class="row-chevron">›</text>
      </view>
    </view>
  </view>

  <!-- 功能组2：退出 -->
  <view class="list-group">
    <view class="list-row" bindtap="togglePhotoQuality" hover-class="list-row-active">
      <text class="list-row-text">个人月度回顾 · 照片质量</text>
      <text class="row-chevron">{{qualityOpen ? '⌃' : '›'}}</text>
    </view>
    <view wx:if="{{qualityOpen}}">
      <picker mode="date" fields="month" value="{{qualityMonth}}" bindchange="changeQualityMonth">
        <view class="list-row"><text>检查月份</text><text>{{qualityMonth}} ›</text></view>
      </picker>
      <view class="list-row" wx:if="{{qualityLoading}}"><text>正在加载…</text></view>
      <view class="list-row" wx:elif="{{qualityError}}" bindtap="loadPhotoQuality"><text>{{qualityError}} · 点击重试</text></view>
      <block wx:else>
        <view class="list-row"><text>本月照片质量扣分：{{qualityDeduction}}</text></view>
        <view wx:for="{{qualityPhotos}}" wx:key="attachment_id">
          <view class="list-row">
            <image src="{{item.display_url}}" mode="aspectFit" data-url="{{item.display_url}}" bindtap="previewQualityPhoto" style="width:160rpx;height:160rpx" />
            <text>{{item.item_name}} · 扣{{item.deduction}}分\n{{item.reason}}</text>
          </view>
          <view class="list-row" data-id="{{item.attachment_id}}" bindtap="openQualityInspection"><text>查看原巡检</text><text class="row-chevron">›</text></view>
        </view>
      </block>
    </view>
  </view>
  <view class="list-group">
    <view class="list-row" bindtap="onLogout" hover-class="list-row-active">
      <view class="list-row-left">
        <view class="row-icon icon-red">
          <image class="row-icon-img" src="/images/mine/icon-logout.svg" mode="aspectFit"/>
        </view>
        <text class="list-row-text text-destructive">退出登录</text>
      </view>
      <view class="list-row-right">
        <text class="row-chevron">›</text>
      </view>
    </view>
  </view>

</view>
