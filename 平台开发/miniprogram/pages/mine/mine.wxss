.profile { margin: 24rpx; display: flex; align-items: center; }
.avatar { width: 96rpx; height: 96rpx; border-radius: 50%; background: var(--brand); color: var(--card); font-size: 40rpx; text-align: center; line-height: 96rpx; }
.profile-info { margin-left: 24rpx; display: flex; flex-direction: column; }
.profile-name { font-size: 32rpx; font-weight: 500; color: var(--text); }
.profile-role { font-size: 24rpx; color: var(--text-3); margin-top: 8rpx; }

.menu { margin: 24rpx; padding: 8rpx 28rpx; }
.menu-item { display: flex; align-items: center; justify-content: space-between; padding: 28rpx 0; }
.menu-tx { font-size: 28rpx; color: var(--text); }
.menu-right { display: flex; align-items: center; }
.menu-sub { font-size: 26rpx; color: var(--text-3); margin-right: 12rpx; }
.arrow { font-size: 36rpx; color: var(--text-3); }
.badge { min-width: 32rpx; height: 32rpx; line-height: 32rpx; padding: 0 8rpx; background: var(--red); color: var(--card); font-size: 22rpx; border-radius: 999rpx; text-align: center; margin-right: 12rpx; }

.logout { margin: 48rpx 24rpx 0; }
.ver { text-align: center; color: var(--text-3); font-size: 22rpx; margin-top: 60rpx; }
.parts-picker, .parts-input { margin: 18rpx 0; padding: 18rpx; background: var(--fill-2); border-radius: 12rpx; font-size: 26rpx; color: var(--text); }
.parts-input { width: auto; }
.parts-hint { display: block; margin-bottom: 20rpx; color: var(--text-3); font-size: 22rpx; }
.parts-empty { padding: 48rpx 0; text-align: center; color: var(--text-3); font-size: 25rpx; }
.parts-request-row { padding: 22rpx 0; border-bottom: 1rpx solid var(--line); }
.parts-request-row:last-child { border-bottom: none; }
.parts-request-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.parts-request-name { flex: 1; min-width: 0; color: var(--text); font-size: 28rpx; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.parts-request-sub { display: block; margin-top: 8rpx; color: var(--text-3); font-size: 23rpx; }
.parts-request-actions { display: flex; margin-top: 16rpx; }
.parts-action { width: auto; margin: 0; padding: 0 24rpx; font-size: 24rpx; }
.parts-upload { margin: 18rpx 0; font-size: 24rpx; }
.parts-radio { display: block; margin: 16rpx 0; color: var(--text-2); font-size: 25rpx; }
.return-hint { display: block; color: var(--text-3); font-size: 23rpx; margin-bottom: 16rpx; }
.return-label { display: block; color: var(--text-2); font-size: 25rpx; margin: 20rpx 0 10rpx; }
.return-textarea { width: auto; min-height: 140rpx; padding: 18rpx; border-radius: 12rpx; background: var(--fill-2); font-size: 26rpx; }
.return-check { display: block; margin: 20rpx 0; color: var(--red); font-size: 25rpx; }
.return-check checkbox .wx-checkbox-input.wx-checkbox-input-checked { background-color: var(--red); border-color: var(--red); }
.vehicle-history-row { display: flex; align-items: flex-start; gap: 16rpx; padding: 20rpx 0; border-bottom: 1rpx solid var(--line); }
.vehicle-history-row:last-child { border-bottom: none; }
.vehicle-history-main { flex: 1; min-width: 0; }
.vehicle-history-title { display: block; color: var(--text); font-size: 27rpx; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.vehicle-history-sub { display: block; margin-top: 6rpx; color: var(--text-3); font-size: 22rpx; }
