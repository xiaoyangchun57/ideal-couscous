/* pages/mine/mine.wxss */

/* 用户信息区 */
.user-section {
  background: var(--card);
  padding: 24rpx 32rpx 28rpx;
}

.user-info-row {
  display: flex;
  align-items: center;
}

.user-info-text {
  margin-left: 24rpx;
  flex: 1;
  min-width: 0;
}

.user-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary), #5ac8fa);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(0, 122, 255, 0.2);
  flex-shrink: 0;
}

.avatar-initials {
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
}

.user-name {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  letter-spacing: -0.5rpx;
}

.user-title {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-top: 6rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* iOS 列表组 */
.list-group {
  background: var(--card);
  border-radius: 24rpx;
  margin: 24rpx 32rpx;
  overflow: hidden;
  box-shadow: var(--shadow-card);
}

.list-row {
  padding: 28rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid var(--border);
  min-height: 88rpx;
  transition: background 0.15s ease;
}

.list-row:last-child {
  border-bottom: none;
}

.list-row-active {
  background: rgba(0, 0, 0, 0.04);
}

.list-row-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.row-icon {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.row-icon-img {
  width: 36rpx;
  height: 36rpx;
  display: block;
}

.icon-blue.row-icon,
.icon-orange.row-icon,
.icon-gray.row-icon,
.icon-red.row-icon {
  background: none;
}

.list-row-text {
  font-size: 30rpx;
  color: var(--text-primary);
  margin-left: 20rpx;
  font-weight: 400;
}

.text-destructive {
  color: var(--destructive) !important;
}

.list-row-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.list-row-hint {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.hint-orange {
  color: var(--warning);
}

.row-chevron {
  font-size: 36rpx;
  color: var(--text-quaternary);
  font-weight: 300;
}

.badge-red {
  min-width: 40rpx;
  height: 40rpx;
  background: var(--destructive);
  border-radius: 9999rpx;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 10rpx;
  line-height: 1;
  border: 3rpx solid var(--card);
  box-sizing: border-box;
}

/* 备件弹层中的列表项 */
.parts-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.parts-item:last-child {
  border-bottom: none;
}

.parts-head {
  display: flex;
  gap: 12rpx;
}

.parts-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-top: 12rpx;
  display: block;
}

.parts-sub {
  font-size: 24rpx;
  color: var(--warning);
  margin-top: 6rpx;
  display: block;
}

.parts-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 12rpx;
}

/* 弹层表单 */
.form-body {
  padding-bottom: 8rpx;
}

.form-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.form-row:last-of-type {
  border-bottom: none;
}

.form-value {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.form-value-blue {
  color: var(--primary);
}

.sheet-submit-btn {
  margin-top: 32rpx;
  height: 96rpx;
  border-radius: 24rpx;
  font-weight: 500;
}

/* 弹层空态 */
.sheet .empty-sub {
  color: var(--text-secondary);
  font-size: 28rpx;
}

/* 弹层头部右侧 */
.sheet-head-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

/* 选择器字段 */
.picker-field {
  background: var(--muted);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  min-height: 40rpx;
}

/* 分段控件 */
.segmented {
  display: flex;
  background: var(--muted);
  border-radius: 20rpx;
  padding: 6rpx;
  gap: 6rpx;
}

.segmented-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: var(--text-secondary);
  border-radius: 16rpx;
  transition: all 0.2s ease;
}

.segmented-item.active {
  background: var(--card);
  color: var(--primary);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}
