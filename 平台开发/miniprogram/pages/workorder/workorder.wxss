  background: var(--color-card);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
}
.workorder-detail-scroll {
  overflow-y: hidden;
}
.workorder-detail-sheet .wos-header {
  padding-right: 120rpx;
}
.workorder-detail-close .ico-close::before,
.workorder-detail-close .ico-close::after {
  background: var(--color-text-tertiary);
}

