/* ===== 工单页 ===== */

.workorder-page {
  min-height: 100vh;
  background: var(--color-background);
  padding-bottom: calc(env(safe-area-inset-bottom) + 120rpx);
}

/* ===== 同步提示条（复用告警页样式） ===== */
.sync-bar {
  margin: 16rpx 32rpx 0;
  background: var(--color-info-surface);
  color: var(--color-info);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-weight: 500;
}

.sync-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  position: relative;
}

.sync-icon::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid var(--color-info);
  border-top-color: transparent;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.sync-text {
  flex: 1;
  color: var(--color-info);
}

.sync-action {
  font-weight: 600;
  color: var(--color-info);
  flex-shrink: 0;
}

/* ===== 分段筛选（对齐设计系统 segmented-control 规范） ===== */
.seg-scroll {
  white-space: nowrap;
  padding: 24rpx 32rpx 16rpx;
  box-sizing: border-box;
}

.seg-strip {
  display: flex;
  min-width: 100%;
  height: 64rpx;
  padding: 4rpx;
  background: var(--color-type-bg);
  border-radius: var(--radius-sm);
  box-sizing: border-box;
}

.seg-item {
  flex: 1 0 0;
  min-width: 120rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  padding: 0 20rpx;
  color: var(--color-text-secondary);
  border-radius: calc(var(--radius-sm) - 2rpx);
  transition: all 0.2s ease;
  font-weight: 500;
  white-space: nowrap;
  height: 100%;
  box-sizing: border-box;
}

.seg-item.seg-on {
  background: var(--color-card);
  color: var(--color-text-primary);
  font-weight: 600;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
}

/* ===== 工单卡片列表 ===== */
.wo-list {
  padding: 8rpx 32rpx 0;
}

.wo-card {
  background: var(--color-card);
  border-radius: var(--radius-xl);
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

/* 第一行：站点名（主锚点） + 状态 chip */
.wo-card-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.wo-site {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.3;
  flex: 1;
  min-width: 0;
  word-break: break-all;
}

/* 状态标签（surface 样式，对齐设计系统 status-chip 规范） */
.wo-status-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 500;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-xs);
  line-height: 1.4;
  flex-shrink: 0;
}

.wschip-pending { background: var(--color-warning-surface); color: var(--color-warning); }
.wschip-accepted { background: var(--color-info-surface); color: var(--color-info); }
.wschip-dispatched { background: var(--color-info-surface); color: var(--color-info); }
.wschip-in_progress { background: var(--color-info-surface); color: var(--color-info); }
.wschip-reviewing { background: var(--color-warning-surface); color: var(--color-warning); }
.wschip-closed { background: var(--color-success-surface); color: var(--color-success); }
.wschip-resolved { background: var(--color-success-surface); color: var(--color-success); }
.wschip-default { background: var(--color-type-bg); color: var(--color-type-text); }

/* 第二行：工单标题（次级信息） */
.wo-title {
  font-size: 26rpx;
  font-weight: 400;
  color: var(--color-text-secondary);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 第三行：底部元信息 */
.wo-card-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 8rpx;
  gap: 12rpx;
}

.wo-foot-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.wo-foot-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  min-width: 0;
}

/* 紧急级别：独立标签，红色突出 */
.wo-level {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--color-text-tertiary);
  line-height: 1.4;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
  background: var(--color-type-bg);
}

.wo-level-urgent {
  color: var(--color-error);
  background: var(--color-error-surface);
  font-weight: 600;
}

/* 工单等级稳定后缀：red/orange/gray（由 level_cls 映射，非中文文案判断）
   red = 严重（最高） / orange = 紧急 / gray = 普通（最低）
   开发接线到 level_cls 前，wo-level-urgent 继续用于当前 WXML */
.wo-level-red {
  color: var(--color-error);
  background: var(--color-error-surface);
  font-weight: 600;
}
.wo-level-orange {
  color: var(--color-warning);
  background: var(--color-warning-surface);
  font-weight: 500;
}
.wo-level-gray {
  color: var(--color-text-tertiary);
  background: var(--color-type-bg);
  font-weight: 400;
}

.wo-sla {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  line-height: 1.4;
}

.wo-source {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  line-height: 1.4;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wo-arrow {
  border-right-color: var(--color-icon-tertiary);
  border-bottom-color: var(--color-icon-tertiary);
  width: 12rpx;
  height: 12rpx;
  flex-shrink: 0;
}

/* ===== 空态（对齐 empty-state 组件规范） ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx;
}

.empty-icon {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--color-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  position: relative;
}

/* 文档图标 */
.empty-doc {
  width: 52rpx;
  height: 64rpx;
  background: var(--color-icon-tertiary);
  border-radius: 4rpx;
  position: relative;
  margin-top: -4rpx;
}

.empty-doc::before {
  content: '';
  position: absolute;
  top: 14rpx;
  left: 10rpx;
  right: 10rpx;
  height: 4rpx;
  background: var(--color-muted);
  box-shadow: 0 10rpx 0 var(--color-muted), 0 20rpx 0 var(--color-muted), 0 30rpx 0 var(--color-muted);
  border-radius: 2rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  text-align: center;
  line-height: 1.5;
}

/* ===== 骨架屏 ===== */
.skeleton-list .skeleton-card {
  background: var(--color-card);
}

.skeleton-line {
  height: 24rpx;
  background: var(--color-muted);
  border-radius: var(--radius-sm);
}

.skeleton-line-sm {
  width: 30%;
  margin-bottom: 16rpx;
}

.skeleton-line-md {
  width: 70%;
  margin-bottom: 12rpx;
}

.skeleton-card {
  animation: skeletonPulse 1.5s ease-in-out infinite;
}

@keyframes skeletonPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.6; }
}

.bottom-spacer {
  height: 32rpx;
}

/* ===== Sheet 弹层 ===== */
.sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--color-card);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  z-index: 101;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  background: var(--color-divider);
  border-radius: 4rpx;
  margin: 16rpx auto;
  flex-shrink: 0;
}

.sheet-scroll {
  flex: 0 1 auto;
  height: 0;
  overflow-y: auto;
  max-height: calc(85vh - 300rpx);
}

.sheet-content-spacer {
  height: 32rpx;
}

/* ===== Sheet 头部 ===== */
.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 40rpx 20rpx;
  flex-shrink: 0;
}

.sheet-header-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.sheet-header-close {
  min-width: 88rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: -20rpx;
  flex-shrink: 0;
}

/* ===== 工单详情头部 ===== */
.wo-detail-header {
  padding: 8rpx 40rpx 28rpx;
}

.wo-detail-status-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.wo-detail-level {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
}

.wo-detail-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.25;
  display: block;
  margin-bottom: 10rpx;
}

.wo-detail-site {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  display: block;
  line-height: 1.4;
}

/* ===== 详情卡片分组 ===== */
.wo-detail-card {
  padding: 0 40rpx 28rpx;
}

.wo-detail-card + .wo-detail-card {
  padding-top: 12rpx;
}

.wo-detail-card-title {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  padding: 28rpx 0 16rpx;
  font-weight: 500;
}

.wo-detail-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 20rpx 0;
  border-top: 0.5rpx solid var(--color-divider);
  gap: 24rpx;
}

.wo-detail-row-clickable {
  cursor: pointer;
}

.wo-detail-label {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  flex-shrink: 0;
}

.wo-detail-value {
  font-size: 28rpx;
  color: var(--color-text-primary);
  text-align: right;
  flex: 1;
  min-width: 0;
  line-height: 1.5;
}

.wo-detail-value-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 1;
  justify-content: flex-end;
}

/* ===== 状态行分组 ===== */
.wo-desc-text {
  font-size: 28rpx;
  color: var(--color-text-primary);
  line-height: 1.6;
  padding: 20rpx 0 0;
  border-top: 0.5rpx solid var(--color-divider);
  white-space: pre-wrap;
  word-break: break-all;
}

/* 空态文字 */
.wo-detail-empty {
  display: block;
  padding: 20rpx 0 0;
  border-top: 0.5rpx solid var(--color-divider);
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  line-height: 1.5;
}

/* ===== 流转时间线 ===== */
.wo-timeline {
  padding: 0 0 0 8rpx;
  border-top: 0.5rpx solid var(--color-divider);
}

.wo-timeline-item {
  position: relative;
  display: flex;
  padding: 16rpx 0 16rpx 36rpx;
}

.wo-timeline-item--last {
  padding-bottom: 8rpx;
}

.wo-timeline-dot {
  position: absolute;
  left: 4rpx;
  top: 22rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--color-primary);
  flex-shrink: 0;
  z-index: 1;
}

.wo-timeline-item--last .wo-timeline-dot {
  background: var(--color-success);
}

.wo-timeline-line {
  position: absolute;
  left: 11rpx;
  top: 38rpx;
  bottom: -16rpx;
  width: 2rpx;
  background: var(--color-divider);
}

.wo-timeline-content {
  flex: 1;
  min-width: 0;
}

.wo-timeline-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 6rpx;
}

.wo-timeline-phase {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.3;
}

.wo-timeline-time {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  flex-shrink: 0;
  line-height: 1.4;
}

.wo-timeline-operator {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.4;
  margin-bottom: 4rpx;
}

.wo-timeline-remark {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
  word-break: break-all;
}

/* 影像网格 */
.wo-img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 20rpx 0 0;
  border-top: 0.5rpx solid var(--color-divider);
}

.wo-img-wrap {
  width: calc((100% - 32rpx) / 3);
  aspect-ratio: 1;
  border-radius: var(--radius-md);
  overflow: hidden;
  position: relative;
}

.wo-img-cell {
  width: 100%;
  height: 100%;
  display: block;
}

/* ===== Sheet 标题 ===== */
.wo-sheet-header {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  padding: 0 40rpx 16rpx;
}

/* ===== 开关行 ===== */
.wo-toggle-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 0 40rpx 24rpx;
  padding: 24rpx;
  background: var(--color-muted);
  border-radius: var(--radius-lg);
  gap: 24rpx;
}

.wo-toggle-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.wo-toggle-title {
  font-size: 28rpx;
  color: var(--color-text-primary);
  font-weight: 500;
}

.wo-toggle-hint {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  line-height: 1.4;
}

/* ===== 履约方式提示 ===== */
.wo-fulfillment-note {
  margin: 0 40rpx 24rpx;
  padding: 16rpx 20rpx;
  background: var(--color-info-surface);
  color: var(--color-info);
  border-radius: var(--radius-md);
  font-size: 24rpx;
  line-height: 1.5;
}

/* ===== 表单字段 ===== */
.wo-detail-field {
  margin: 0 40rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.wo-detail-field-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
}

.wo-detail-input {
  height: 80rpx;
  line-height: 80rpx;
  background: var(--color-background);
  border-radius: var(--radius-md);
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.wo-detail-textarea {
  min-height: 160rpx;
  background: var(--color-background);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--color-text-primary);
  line-height: 1.5;
  width: 100%;
  box-sizing: border-box;
}

.wo-detail-picker-value {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 80rpx;
  background: var(--color-background);
  border-radius: var(--radius-md);
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--color-text-primary);
}

/* ===== 底部操作区 ===== */
.wo-detail-actions {
  padding: 20rpx 40rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 0.5rpx solid var(--color-divider);
  background: var(--color-card);
  flex-shrink: 0;
}

.wo-detail-btn-gap {
  margin-top: 16rpx;
}

.wo-detail-sub-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.wo-detail-sub-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
}

.wo-detail-waiting {
  text-align: center;
  padding: 16rpx 0;
}

.wo-detail-waiting-text {
  font-size: 28rpx;
  color: var(--color-text-tertiary);
}

/* ===== 按钮（复用主按钮样式） ===== */
.btn-primary-main {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: var(--color-primary);
  color: #fff;
  border-radius: var(--radius-lg);
  font-size: 30rpx;
  font-weight: 500;
  border: none;
}

.btn-primary-main::after {
  border: none;
}

.btn-secondary-outline {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: var(--color-card);
  color: var(--color-primary);
  border: 1.5rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  font-size: 30rpx;
  font-weight: 500;
}

.btn-secondary-outline::after {
  border: none;
}

.btn-ghost {
  background: var(--color-background);
  color: var(--color-primary);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}

.btn-ghost::after {
  border: none;
}


/* ============================================================
   工单详情 Sheet 新样式（wos-* 前缀）
   ============================================================ */

/* Sheet 基础（覆盖/补充） */
.sheet {
  max-height: 75vh;
}

.sheet-scroll {
  flex: 1 1 0;
  height: 0;
  min-height: 0;
}

/* ===== 底部操作栏 ===== */
.sheet-bottom-bar {
  padding: 20rpx 40rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 0.5rpx solid var(--color-divider);
  background: var(--color-card);
  flex-shrink: 0;
}

/* 备件申请 Sheet 底栏：横向双按钮 */
.parts-apply-sheet .sheet-bottom-bar {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
}

.parts-apply-sheet .btn-lg {
  flex: 1;
  width: auto;
  min-height: 88rpx;
  line-height: 88rpx;
  height: auto;
}

.parts-apply-sheet .btn-primary.btn-lg {
  flex: 2;
}

/* 按钮 lg */
.btn-lg {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: var(--radius-lg);
  font-size: 30rpx;
  font-weight: 500;
  border: none;
}

.btn-lg::after {
  border: none;
}

.wos-btn-gap {
  margin-top: 20rpx;
}

/* 次动作行 */
.wos-sub-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.wos-sub-btn {
  flex: 1;
  min-height: 88rpx;
  line-height: 88rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.wos-sub-btn::after {
  border: none;
}

/* ===== 状态标签 ===== */
.wos-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-xs);
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.4;
  white-space: nowrap;
}

.wos-chip-pending { background: var(--color-warning-surface); color: var(--color-warning); }
.wos-chip-accepted { background: var(--color-info-surface); color: var(--color-info); }
.wos-chip-dispatched { background: var(--color-info-surface); color: var(--color-info); }
.wos-chip-in_progress { background: var(--color-info-surface); color: var(--color-info); }
.wos-chip-reviewing { background: var(--color-warning-surface); color: var(--color-warning); }
.wos-chip-closed { background: var(--color-success-surface); color: var(--color-success); }
.wos-chip-resolved { background: var(--color-success-surface); color: var(--color-success); }
.wos-chip-rejected { background: var(--color-error-surface); color: var(--color-error); }

/* ===== 任务头部 ===== */
.wos-header {
  padding: 8rpx 40rpx 24rpx;
}

.wos-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.3;
  word-break: break-all;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
