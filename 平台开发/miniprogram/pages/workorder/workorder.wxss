/* ============================================================
 *  Sheet 布局修复 + 工单详情视觉收口
 *  说明：清理历史残留，统一 flex 滚动布局，确保正文非零高度
 * ============================================================ */

/* --- Sheet 容器：统一 flex 列布局，高度由内容撑开至 max-height --- */
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--color-card);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  z-index: 101;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* handle 条：保持在 padding-bottom 之外，使用负 margin 抵消 */
.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  background: var(--color-divider);
  border-radius: 4rpx;
  margin: 16rpx auto;
  flex-shrink: 0;
}

/* 头部 */
.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 40rpx 12rpx;
  flex-shrink: 0;
  min-height: 68rpx;
  box-sizing: border-box;
}

.sheet-header-close {
  min-width: 88rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: -24rpx;
  flex-shrink: 0;
}

.sheet-header-close .ico-close::before,
.sheet-header-close .ico-close::after {
  background: var(--color-text-tertiary);
}

/* --- 核心：scroll-view 正文区域 ---
   flex: 0 1 auto + min-height: 0：
   - 内容少时：高度由内容决定，Sheet 紧凑收束，无多余空白
   - 内容多时：Sheet 被 max-height 限制，flex-shrink 压缩 scroll-view，内容溢出滚动
   替代旧的 height:0 + min-height:320rpx 方案（导致小滚动窗 + 底栏比例失衡） */
.sheet-scroll {
  flex: 0 1 auto;
  min-height: 0;
  overflow-y: auto;
}

.sheet-content-spacer {
  height: 32rpx;
  flex-shrink: 0;
}

/* 底部操作栏 */
.sheet-bottom-bar {
  padding: 12rpx 40rpx;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  border-top: 0.5rpx solid var(--color-divider);
  background: var(--color-card);
  flex-shrink: 0;
}

/* PM-15 work-order detail: the root no longer inherits legacy .sheet rules. */
