/* 计划详情页 — 对齐 plan-detail.html 母版，使用设计系统 --color-* 标准 Token */

.plan-detail-page {
  background: var(--color-background);
  min-height: 100vh;
  padding-bottom: 32rpx;
}

/* ===== 状态头部区 ===== */
.status-header {
  background: var(--color-card);
  padding: 32rpx;
}

.status-main-row {
  display: flex;
  align-items: center;
}

.status-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  padding: 10rpx 24rpx;
  border-radius: 100rpx;
  color: #fff;
  line-height: 1.4;
}

.chip-green { background: var(--color-success); }
.chip-blue { background: var(--color-primary); }
.chip-orange { background: var(--color-warning); }
.chip-red { background: var(--color-error); }
.chip-gray { background: var(--color-text-tertiary); }

.status-tag-sub {
  display: inline-flex;
  align-items: center;
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-xs);
  margin-left: 16rpx;
  font-weight: 500;
  line-height: 1.4;
}

.tag-green {
  background: var(--color-success-surface);
  color: var(--color-success);
}
.tag-blue {
  background: var(--color-info-surface);
  color: var(--color-info);
}
.tag-orange {
  background: var(--color-warning-surface);
  color: var(--color-warning);
}
.tag-red {
  background: var(--color-error-surface);
  color: var(--color-error);
}
.tag-gray {
  background: var(--color-type-bg);
  color: var(--color-type-text);
}

.plan-meta {
  margin-top: 24rpx;
}

.plan-type-period {
  font-size: 30rpx;
  color: var(--color-text-secondary);
}

.plan-name {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  margin-top: 8rpx;
  letter-spacing: -0.6rpx;
  line-height: 1.25;
}

.progress-wrap {
  margin-top: 24rpx;
}

.progress-summary {
  display: flex;
  gap: 32rpx;
  align-items: center;
}

.progress-stat {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.progress-num {
  font-weight: 700;
  color: var(--color-primary);
}

.progress-bar-wrap {
  margin-top: 16rpx;
  height: 12rpx;
  background: var(--color-muted);
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: var(--color-primary);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

/* 加载骨架屏 */
.status-header-loading .loading-skeleton {
  background: var(--color-muted);
  border-radius: var(--radius-sm);
  color: transparent;
}

.status-header-loading .status-chip {
  width: 140rpx;
  height: 48rpx;
  background: var(--color-muted);
}

.status-header-loading .plan-type-period {
  width: 60%;
  height: 30rpx;
  background: var(--color-muted);
  border-radius: var(--radius-sm);
}

.status-header-loading .plan-name {
  width: 80%;
  height: 48rpx;
  margin-top: 12rpx;
  background: var(--color-muted);
  border-radius: var(--radius-sm);
}

.status-header-loading .progress-stat {
  width: 140rpx;
  height: 28rpx;
  background: var(--color-muted);
  border-radius: var(--radius-sm);
}

.status-header-loading .progress-bar-wrap {
  background: var(--color-muted);
}

/* ===== 驳回提示 ===== */
.reject-banner {
  margin: 24rpx 32rpx 0;
  padding: 24rpx;
  background: var(--color-warning-surface);
  border-radius: var(--radius-md);
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.reject-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--color-warning);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  line-height: 1;
}

.reject-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.reject-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-warning);
}

.reject-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

/* ===== 信息分组卡片 ===== */
.info-card {
  background: var(--color-card);
  border-radius: var(--radius-xl);
  margin: 24rpx 32rpx;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.card-header {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  padding: 24rpx 32rpx 16rpx;
  letter-spacing: 1rpx;
  font-weight: 500;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 20rpx 32rpx;
  border-top: 1rpx solid var(--color-divider);
  gap: 24rpx;
}

.info-label {
  font-size: 30rpx;
  color: var(--color-text-primary);
  flex-shrink: 0;
}

.info-value {
  font-size: 30rpx;
  color: var(--color-text-primary);
  text-align: right;
  line-height: 1.4;
  flex: 1;
  min-width: 0;
}

.info-value-secondary {
  color: var(--color-text-secondary);
}

.info-value-multiline {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.info-value-right {
  text-align: right;
}

.prep-line {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

/* ===== 作业路线列表 ===== */
.site-list {
  padding: 0;
}

.site-list-row {
  padding: 24rpx 32rpx;
  border-top: 1rpx solid var(--color-divider);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
}

.site-list-row:first-child {
  border-top: none;
}

.site-list-left {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.site-list-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.3;
}

.site-list-date {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  line-height: 1.4;
}

.site-list-right {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}

.site-list-status {
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.4;
}

.sstat-green { color: var(--color-success); }
.sstat-blue { color: var(--color-primary); }
.sstat-orange { color: var(--color-warning); }
.sstat-red { color: var(--color-error); }
.sstat-gray { color: var(--color-text-tertiary); }

.site-list-items {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  line-height: 1.4;
}

/* ===== 底部固定操作栏 ===== */
.bottom-spacer {
  height: 180rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--color-card);
  border-top: 1rpx solid var(--color-divider);
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 20rpx;
  z-index: 100;
}

.btn-primary-main {
  flex: 1 1 0;
  min-width: 0;
  height: 96rpx;
  background: var(--color-primary);
  border: none;
  border-radius: var(--radius-lg);
  color: var(--color-primary-foreground);
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  margin: 0;
  padding: 0;
  white-space: nowrap;
}

.btn-primary-main::after {
  border: none;
}

.btn-primary-main[disabled] {
  opacity: 0.4;
}

.btn-destructive-fill {
  background: var(--color-error);
  color: #fff;
}

.btn-secondary-outline {
  width: 180rpx;
  min-width: 0;
  height: 96rpx;
  background: var(--color-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  color: var(--color-text-primary);
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 1 180rpx;
  line-height: 1;
  padding: 0;
  margin: 0;
  white-space: nowrap;
}

.btn-secondary-outline::after {
  border: none;
}

.btn-destructive-outline {
  color: var(--color-error);
  border-color: var(--color-error);
}

/* ===== 弹层 ===== */
.sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 10000;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--color-card);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  z-index: 10001;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.sheet-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.sheet-close::before,
.sheet-close::after {
  content: '';
  position: absolute;
  width: 28rpx;
  height: 3rpx;
  background: var(--color-icon-tertiary);
  border-radius: 2rpx;
}

.sheet-close::before {
  transform: rotate(45deg);
}

.sheet-close::after {
  transform: rotate(-45deg);
}

.form-textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 24rpx;
  background: var(--color-background);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  color: var(--color-text-primary);
  line-height: 1.5;
}

.form-error {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--color-error);
}

.sheet-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.sheet-primary-btn {
  margin-top: 32rpx;
  width: 100%;
}

.field-label {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}

.input-field {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: var(--color-background);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  color: var(--color-text-primary);
  display: flex;
  align-items: center;
}
