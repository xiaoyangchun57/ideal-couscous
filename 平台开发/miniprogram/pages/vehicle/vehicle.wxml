<view class="page">
  <view class="vehicle-hero" wx:if="{{activeUse}}">
    <text class="hero-kicker">当前行程</text><text class="hero-plate">{{activeUse.vehicle_label}}</text>
    <text class="hero-meta">出车 {{activeUse.checked_out_at || '已登记'}} · {{activeUse.start_mileage || 0}} km<text wx:if="{{activeUse.is_plan_trip}}"> · {{activeUse.can_return ? '计划末日，可还车' : ('计划行程至 ' + activeUse.trip_end_date)}}</text></text>
    <view class="hero-actions"><view class="hero-action" bindtap="onOpenRefuel">{{activeUse.fuel_type === 'electric' ? '充电' : '加油'}}</view><view class="hero-action" bindtap="onOpenFault">故障上报</view><view class="hero-action hero-action-main {{activeUse.can_return ? '' : 'hero-action-muted'}}" bindtap="onVehiclePrimaryAction">{{activeUse.can_return ? '还车' : '变更计划'}}</view></view>
  </view>
  <view class="card no-active" wx:elif="{{loaded}}"><text class="no-active-title">当前没有进行中的车辆行程</text><text class="no-active-copy">从获批安排完成出车检查，或提交新的用车申请。</text><button class="btn-primary no-active-btn" bindtap="onOpenApply">申请用车</button></view>

  <view class="section"><view class="section-title">我的用车安排<text class="section-more" bindtap="onOpenApply">申请用车 ›</text></view></view>
  <view class="list-card" wx:if="{{applications.length}}">
    <view class="application-row" wx:for="{{applications}}" wx:key="id">
      <view class="application-main"><view class="application-head"><text class="application-title">{{item.vehicle_label}}</text><text class="tag tag-{{item.status_cls}}">{{item.status_cn}}</text></view><text class="application-sub">{{item.start_at || '时间待定'}}<text wx:if="{{item.end_at}}"> ~ {{item.end_at}}</text></text><text class="application-sub">{{item.purpose_label}}</text><text class="application-reject" wx:if="{{item.status === 'rejected' && item.reject_reason}}">驳回原因：{{item.reject_reason}}</text></view>
      <button wx:if="{{item.can_checkout && !activeUse}}" class="btn-sm btn-primary application-action" bindtap="onOpenCheckout" data-id="{{item.id}}">出车登记</button>
    </view>
  </view>
  <view class="empty compact-empty" wx:elif="{{loaded}}"><text class="empty-tx">暂无用车安排</text></view>

  <view class="section" wx:if="{{history.length}}"><view class="section-title">近期已归档行程</view></view>
  <view class="list-card" wx:if="{{history.length}}"><view class="history-row" wx:for="{{history}}" wx:key="id"><view class="history-main"><text class="history-title">{{item.vehicle_label}}</text><text class="history-sub">{{item.checked_out_at || '—'}} 至 {{item.returned_at || '—'}}</text><text class="history-sub">{{item.start_mileage || 0}} km → {{item.end_mileage || 0}} km</text></view><text class="tag tag-green">已归档</text></view></view>

  <view class="sheet-mask" wx:if="{{checkoutSheet.open}}" bindtap="onCloseCheckout"></view><view class="sheet" wx:if="{{checkoutSheet.open}}"><view class="sheet-head"><text class="sheet-title">出车前检查</text><text class="sheet-close" bindtap="onCloseCheckout">×</text></view><text class="sheet-hint">{{checkoutSheet.application.vehicle_label}} · 完成检查和里程登记后方可出车。</text><block wx:for="{{checkoutSheet.items}}" wx:key="key"><view class="check-row"><text class="check-label">{{item.label || item.key}}</text><view class="check-options"><text class="check-option {{item.status === 'normal' ? 'check-ok' : ''}}" data-index="{{index}}" data-status="normal" bindtap="onCheckoutItem">正常</text><text class="check-option {{item.status === 'attention' ? 'check-attention' : ''}}" data-index="{{index}}" data-status="attention" bindtap="onCheckoutItem">关注</text><text class="check-option {{item.status === 'blocked' ? 'check-blocked' : ''}}" data-index="{{index}}" data-status="blocked" bindtap="onCheckoutItem">禁用</text></view></view></block><text class="field-label">出车时里程</text><input class="field-input" type="digit" value="{{checkoutSheet.mileage}}" bindinput="onCheckoutMileage" placeholder="填写仪表盘公里数"/><text class="field-label">异常说明（异常必填）</text><textarea class="field-input textarea" value="{{checkoutSheet.remarks}}" bindinput="onCheckoutRemarks" placeholder="说明发现的问题及处置"/><button class="btn-primary" loading="{{checkoutSheet.submitting}}" disabled="{{checkoutSheet.submitting}}" bindtap="onSubmitCheckout">确认检查并出车</button></view>

  <view class="sheet-mask" wx:if="{{returnSheet.open}}" bindtap="onCloseReturn"></view><view class="sheet" wx:if="{{returnSheet.open}}"><view class="sheet-head"><text class="sheet-title">还车检查</text><text class="sheet-close" bindtap="onCloseReturn">×</text></view><text class="sheet-hint">发现禁用项将限制车辆后续调度。</text><block wx:for="{{returnSheet.items}}" wx:key="key"><view class="check-row"><text class="check-label">{{item.label || item.key}}</text><view class="check-options"><text class="check-option {{item.status === 'normal' ? 'check-ok' : ''}}" data-index="{{index}}" data-status="normal" bindtap="onReturnItem">正常</text><text class="check-option {{item.status === 'attention' ? 'check-attention' : ''}}" data-index="{{index}}" data-status="attention" bindtap="onReturnItem">关注</text><text class="check-option {{item.status === 'blocked' ? 'check-blocked' : ''}}" data-index="{{index}}" data-status="blocked" bindtap="onReturnItem">禁用</text></view></view></block><text class="field-label">还车时里程</text><input class="field-input" type="digit" value="{{returnSheet.mileage}}" bindinput="onReturnMileage" placeholder="填写仪表盘公里数"/><text class="field-label">异常说明（异常必填）</text><textarea class="field-input textarea" value="{{returnSheet.remarks}}" bindinput="onReturnRemarks" placeholder="说明发现的问题及处置"/><button class="btn-primary" loading="{{returnSheet.submitting}}" disabled="{{returnSheet.submitting}}" bindtap="onSubmitReturn">确认检查并还车</button></view>

  <view class="sheet-mask" wx:if="{{refuelSheet.open}}" bindtap="onCloseRefuel"></view><view class="sheet" wx:if="{{refuelSheet.open}}"><view class="sheet-head"><text class="sheet-title">途中{{refuelSheet.label}}</text><text class="sheet-close" bindtap="onCloseRefuel">×</text></view><text class="field-label">{{refuelSheet.label}}量（{{refuelSheet.unit}}）</text><input class="field-input" type="digit" data-field="quantity" value="{{refuelSheet.quantity}}" bindinput="onRefuelField"/><text class="field-label">金额（元，可选）</text><input class="field-input" type="digit" data-field="amount" value="{{refuelSheet.amount}}" bindinput="onRefuelField"/><text class="field-label">当前里程</text><input class="field-input" type="digit" data-field="mileage" value="{{refuelSheet.mileage}}" bindinput="onRefuelField"/><text class="field-label">备注（可选）</text><textarea class="field-input textarea" data-field="remark" value="{{refuelSheet.remark}}" bindinput="onRefuelField"/><button class="btn-primary" loading="{{refuelSheet.submitting}}" disabled="{{refuelSheet.submitting}}" bindtap="onSubmitRefuel">保存{{refuelSheet.label}}记录</button></view>

  <view class="sheet-mask" wx:if="{{faultSheet.open}}" bindtap="onCloseFault"></view><view class="sheet" wx:if="{{faultSheet.open}}"><view class="sheet-head"><text class="sheet-title">车辆故障上报</text><text class="sheet-close" bindtap="onCloseFault">×</text></view><text class="field-label">故障类型</text><input class="field-input" data-field="faultType" value="{{faultSheet.faultType}}" bindinput="onFaultField"/><text class="field-label">故障时里程（可选）</text><input class="field-input" type="digit" data-field="mileage" value="{{faultSheet.mileage}}" bindinput="onFaultField"/><text class="field-label">故障现象</text><textarea class="field-input textarea" data-field="description" value="{{faultSheet.description}}" bindinput="onFaultField" placeholder="描述故障及是否影响安全行驶"/><text class="field-label">补充说明（可选）</text><textarea class="field-input textarea" data-field="remark" value="{{faultSheet.remark}}" bindinput="onFaultField"/><button class="btn-danger" loading="{{faultSheet.submitting}}" disabled="{{faultSheet.submitting}}" bindtap="onSubmitFault">上报并限制使用</button></view>

  <view class="sheet-mask" wx:if="{{applySheet.open}}" bindtap="onCloseApply"></view><view class="sheet" wx:if="{{applySheet.open}}"><view class="sheet-head"><text class="sheet-title">申请用车</text><text class="sheet-close" bindtap="onCloseApply">×</text></view><picker mode="selector" range="{{vehicles}}" range-key="plate_no" value="{{applySheet.vehicleIndex}}" bindchange="onApplyPick"><view class="picker-row">{{vehicles[applySheet.vehicleIndex].plate_no}}<text wx:if="{{vehicles[applySheet.vehicleIndex].model}}"> · {{vehicles[applySheet.vehicleIndex].model}}</text> ›</view></picker><text class="field-label">使用日期</text><picker mode="date" value="{{applySheet.date}}" bindchange="onApplyField" data-field="date"><view class="picker-row">{{applySheet.date}} ›</view></picker><view class="time-row"><view><text class="field-label">开始时间</text><picker mode="time" value="{{applySheet.startTime}}" bindchange="onApplyField" data-field="startTime"><view class="picker-row">{{applySheet.startTime}} ›</view></picker></view><view><text class="field-label">结束时间</text><picker mode="time" value="{{applySheet.endTime}}" bindchange="onApplyField" data-field="endTime"><view class="picker-row">{{applySheet.endTime}} ›</view></picker></view></view><text class="field-label">目的地</text><input class="field-input" data-field="destination" value="{{applySheet.destination}}" bindinput="onApplyField" placeholder="如：城区水站"/><text class="field-label">用车事由</text><textarea class="field-input textarea" data-field="reason" value="{{applySheet.reason}}" bindinput="onApplyField" placeholder="说明本次外出任务"/><button class="btn-primary" loading="{{applySheet.submitting}}" disabled="{{applySheet.submitting}}" bindtap="onSubmitApply">提交审批</button></view>
</view>
