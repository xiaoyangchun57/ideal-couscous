<view class="vh-page">
  <view class="vh-card vh-card--empty" wx:if="{{loadState === 'initial_loading'}}">
    <text class="vh-empty-title">正在加载我的用车</text>
    <text class="vh-empty-copy">正在读取最新安排和行程状态。</text>
  </view>

  <view class="vh-card vh-card--empty" wx:if="{{loadState === 'initial_error'}}">
    <text class="vh-empty-title">用车信息加载失败</text>
    <text class="vh-empty-copy">{{loadError}}</text>
    <view class="vh-btn-primary vh-btn-full" bindtap="onRetryLoad">重新加载</view>
  </view>

  <view class="vh-alert vh-alert--warn" wx:if="{{loadState === 'refresh_error'}}">
    <text class="vh-alert-text">{{loadError}}；已保留上次内容，刷新成功前不可操作。</text>
    <view class="vh-btn-primary" bindtap="onRetryLoad">重试</view>
  </view>

  <view class="vh-alert" wx:if="{{activeUseConflict}}">
    <text class="vh-alert-text">检测到多条未归还行程，已暂停途中记录、故障、还车和出车操作；请刷新或联系管理员核对。</text>
  </view>

  <!-- 超期提示条 -->
  <view class="vh-alert" wx:if="{{hasVehicleExpiry}}">
    <text class="vh-alert-text">车辆安排已超期，关联巡检计划尚未完成，请延续用车时间；车辆归还前不会重新进入可申请列表。</text>
  </view>

  <!-- 当前行程卡（有活动行程） -->
  <view class="vh-hero" wx:if="{{activeUse}}">
    <view class="vh-hero-top">
      <text class="vh-hero-kicker">当前行程</text>
      <view class="vh-status-pill vh-status-pill--active">使用中</view>
    </view>
    <text class="vh-hero-plate">{{activeUse.vehicle_label}}</text>
    <text class="vh-hero-meta">出车 {{activeUse.checked_out_at || '已登记'}} · {{activeUse.start_mileage || 0}} km<text wx:if="{{activeUse.is_plan_trip}}"> · {{activeUse.can_return ? '计划末日，可还车' : ('计划行程至 ' + activeUse.trip_end_date)}}</text></text>

    <!-- 主动作 -->
    <view class="vh-hero-primary">
      <view class="vh-btn-primary" bindtap="onVehiclePrimaryAction">{{activeUse.needs_extension ? '延续用车' : (activeUse.can_return ? '还车' : '查看计划')}}</view>
    </view>

    <!-- 途中快捷操作 -->
    <view class="vh-quick-actions">
      <view class="vh-quick-action" bindtap="onOpenRefuel">
        <view class="vh-quick-icon">
          <view class="ico ico-fuel"></view>
        </view>
        <text class="vh-quick-label">{{activeUse.fuel_type === 'electric' ? '充电' : '加油'}}</text>
      </view>
      <view class="vh-quick-action" bindtap="onOpenFault">
        <view class="vh-quick-icon">
          <view class="ico ico-warning">
            <view class="ico-warning-bar"></view>
            <view class="ico-warning-dot"></view>
          </view>
        </view>
        <text class="vh-quick-label">故障上报</text>
      </view>
    </view>
  </view>

  <!-- 车辆占用中（无活动行程但有安排） -->
  <view class="vh-card vh-card--occupied" wx:elif="{{activeArrangement}}">
    <view class="vh-occupied-icon">!</view>
    <text class="vh-occupied-title">{{activeArrangement.vehicle_label}}仍由巡检计划占用</text>
    <text class="vh-occupied-copy">{{activeArrangement.needs_extension ? ('原安排已于 ' + activeArrangement.trip_end_date + ' 到期，结转任务完成前需延续用车时间。') : '计划仍有未完成任务，车辆暂不释放给其他人员。'}}</text>
    <view class="vh-btn-primary vh-btn-full" wx:if="{{activeArrangement.needs_extension}}" bindtap="onOpenExtension" data-id="{{activeArrangement.id}}">延续用车时间</view>
  </view>

  <!-- 无活动行程空态 -->
  <view class="vh-card vh-card--empty" wx:elif="{{loaded && !activeUseConflict}}">
    <text class="vh-empty-title">当前没有进行中的车辆行程</text>
    <text class="vh-empty-copy">从获批安排完成出车检查，或提交新的用车申请。</text>
    <view class="vh-btn-primary vh-btn-full" bindtap="onOpenApply">申请用车</view>
  </view>

  <!-- 我的用车安排 -->
  <view class="vh-section">
    <view class="vh-section-header">
      <text class="vh-section-title">我的用车安排</text>
      <text class="vh-section-more" bindtap="onOpenApply" wx:if="{{(activeUse || activeArrangement) && !activeUseConflict}}">申请用车 ›</text>
    </view>

    <view class="vh-list" wx:if="{{applications.length}}">
      <view class="vh-list-item" wx:for="{{applications}}" wx:key="id">
        <view class="vh-list-main">
          <text class="vh-list-title">{{item.vehicle_label}}</text>
          <text class="vh-list-sub">{{item.start_at || '时间待定'}}<text wx:if="{{item.end_at}}"> ~ {{item.end_at}}</text></text>
          <text class="vh-list-sub">{{item.purpose_label}}</text>
          <text class="vh-list-reject" wx:if="{{item.status === 'rejected' && item.reject_reason}}">驳回原因：{{item.reject_reason}}</text>
        </view>
        <view class="vh-list-right">
          <view class="vh-chip vh-chip-{{item.status_cls}}">{{item.status_cn}}</view>
          <button wx:if="{{item.can_checkout && !activeUse && !activeUseConflict}}" class="vh-btn-sm vh-btn-sm-primary" bindtap="onOpenCheckout" data-id="{{item.id}}">出车登记</button>
          <button wx:if="{{item.needs_extension}}" class="vh-btn-sm vh-btn-sm-primary" bindtap="onOpenExtension" data-id="{{item.id}}">延续用车</button>
        </view>
      </view>
    </view>

    <view class="vh-empty-list" wx:elif="{{loaded}}">
      <text class="vh-empty-tx">暂无用车安排</text>
    </view>
  </view>

  <!-- 已归档行程 -->
  <view class="vh-section" wx:if="{{history.length || historyLoading}}">
    <view class="vh-section-header">
      <text class="vh-section-title">已归档行程</text>
      <text class="vh-section-count" wx:if="{{historyTotal}}">{{history.length}} / {{historyTotal}}</text>
    </view>

    <view class="vh-list" wx:if="{{history.length}}">
      <view class="vh-list-item vh-list-item--history" wx:for="{{history}}" wx:key="id">
        <view class="vh-list-main">
          <text class="vh-list-title">{{item.vehicle_label}}</text>
          <text class="vh-list-sub">{{item.checked_out_at || '—'}} 至 {{item.returned_at || '—'}}</text>
          <text class="vh-list-sub">{{item.start_mileage || 0}} km → {{item.end_mileage || 0}} km</text>
        </view>
        <view class="vh-chip vh-chip--success">已归档</view>
      </view>
    </view>

    <view class="vh-list-foot" wx:if="{{historyLoading}}">正在加载更多行程</view>
    <view class="vh-list-foot" wx:elif="{{historyHasMore}}">上拉加载更多行程</view>
  </view>

  <!-- ===== Sheet：出车前检查 ===== -->
  <view class="vh-sheet-mask" wx:if="{{checkoutSheet.open}}" bindtap="onCloseCheckout"></view>
  <view class="vh-sheet" wx:if="{{checkoutSheet.open}}">
    <view class="vh-sheet-handle"></view>
    <view class="vh-sheet-header">
      <view class="vh-sheet-title">出车前检查</view>
      <view class="vh-sheet-close" catchtap="onCloseCheckout">
        <view class="ico ico-close"></view>
      </view>
    </view>
    <scroll-view class="vh-sheet-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="vh-sheet-hint">{{checkoutSheet.application.vehicle_label}} · 完成检查和里程登记后方可出车。</view>
      <view class="vh-check-list">
        <block wx:for="{{checkoutSheet.items}}" wx:key="key">
          <view class="vh-check-row">
            <text class="vh-check-label">{{item.label || item.key}}</text>
            <view class="vh-check-options">
              <view class="vh-check-opt {{item.status === 'normal' ? 'vh-check-opt--ok' : ''}}" data-index="{{index}}" data-status="normal" bindtap="onCheckoutItem">正常</view>
              <view class="vh-check-opt {{item.status === 'attention' ? 'vh-check-opt--warn' : ''}}" data-index="{{index}}" data-status="attention" bindtap="onCheckoutItem">关注</view>
              <view class="vh-check-opt {{item.status === 'blocked' ? 'vh-check-opt--error' : ''}}" data-index="{{index}}" data-status="blocked" bindtap="onCheckoutItem">禁用</view>
            </view>
          </view>
        </block>
      </view>
      <view class="vh-form-group">
        <text class="vh-form-label">出车时里程</text>
        <input class="vh-form-input" type="digit" value="{{checkoutSheet.mileage}}" bindinput="onCheckoutMileage" placeholder="填写仪表盘公里数"/>
      </view>
      <view class="vh-form-group">
        <text class="vh-form-label">异常说明（异常必填）</text>
        <textarea class="vh-form-textarea" value="{{checkoutSheet.remarks}}" bindinput="onCheckoutRemarks" placeholder="说明发现的问题及处置"/>
      </view>
      <view class="vh-sheet-spacer"></view>
    </scroll-view>
    <view class="vh-sheet-bottom-bar">
      <button class="btn-primary btn-lg" loading="{{checkoutSheet.submitting}}" disabled="{{checkoutSheet.submitting}}" bindtap="onSubmitCheckout">确认检查并出车</button>
    </view>
  </view>

  <!-- ===== Sheet：还车检查 ===== -->
  <view class="vh-sheet-mask" wx:if="{{returnSheet.open}}" bindtap="onCloseReturn"></view>
  <view class="vh-sheet" wx:if="{{returnSheet.open}}">
    <view class="vh-sheet-handle"></view>
    <view class="vh-sheet-header">
      <view class="vh-sheet-title">还车检查</view>
      <view class="vh-sheet-close" catchtap="onCloseReturn">
        <view class="ico ico-close"></view>
      </view>
    </view>
    <scroll-view class="vh-sheet-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="vh-sheet-hint">发现禁用项将限制车辆后续调度。</view>
      <view class="vh-check-list">
        <block wx:for="{{returnSheet.items}}" wx:key="key">
          <view class="vh-check-row">
            <text class="vh-check-label">{{item.label || item.key}}</text>
            <view class="vh-check-options">
              <view class="vh-check-opt {{item.status === 'normal' ? 'vh-check-opt--ok' : ''}}" data-index="{{index}}" data-status="normal" bindtap="onReturnItem">正常</view>
              <view class="vh-check-opt {{item.status === 'attention' ? 'vh-check-opt--warn' : ''}}" data-index="{{index}}" data-status="attention" bindtap="onReturnItem">关注</view>
              <view class="vh-check-opt {{item.status === 'blocked' ? 'vh-check-opt--error' : ''}}" data-index="{{index}}" data-status="blocked" bindtap="onReturnItem">禁用</view>
            </view>
          </view>
        </block>
      </view>
      <view class="vh-form-group">
        <text class="vh-form-label">还车时里程</text>
        <input class="vh-form-input" type="digit" value="{{returnSheet.mileage}}" bindinput="onReturnMileage" placeholder="填写仪表盘公里数"/>
      </view>
      <view class="vh-form-group">
        <text class="vh-form-label">异常说明（异常必填）</text>
        <textarea class="vh-form-textarea" value="{{returnSheet.remarks}}" bindinput="onReturnRemarks" placeholder="说明发现的问题及处置"/>
      </view>
      <view class="vh-sheet-spacer"></view>
    </scroll-view>
    <view class="vh-sheet-bottom-bar">
      <button class="btn-primary btn-lg" loading="{{returnSheet.submitting}}" disabled="{{returnSheet.submitting}}" bindtap="onSubmitReturn">确认检查并还车</button>
    </view>
  </view>

  <!-- ===== Sheet：延续用车时间 ===== -->
  <view class="vh-sheet-mask" wx:if="{{extensionSheet.open}}" bindtap="onCloseExtension"></view>
  <view class="vh-sheet" wx:if="{{extensionSheet.open}}">
    <view class="vh-sheet-handle"></view>
    <view class="vh-sheet-header">
      <view class="vh-sheet-title">延续用车时间</view>
      <view class="vh-sheet-close" catchtap="onCloseExtension">
        <view class="ico ico-close"></view>
      </view>
    </view>
    <scroll-view class="vh-sheet-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="vh-sheet-hint">关联巡检闭环前车辆保持占用。延续时会检查该车辆和申请人的其他安排冲突。</view>
      <view class="vh-form-group">
        <text class="vh-form-label">新的截止日期</text>
        <picker mode="date" start="{{extensionSheet.endDate}}" value="{{extensionSheet.endDate}}" bindchange="onExtensionDate">
          <view class="vh-picker-row">{{extensionSheet.endDate}} 18:00 ›</view>
        </picker>
      </view>
      <view class="vh-sheet-spacer"></view>
    </scroll-view>
    <view class="vh-sheet-bottom-bar">
      <button class="btn-primary btn-lg" loading="{{extensionSheet.submitting}}" disabled="{{extensionSheet.submitting}}" bindtap="onSubmitExtension">确认延续</button>
    </view>
  </view>

  <!-- ===== Sheet：加油/充电 ===== -->
  <view class="vh-sheet-mask" wx:if="{{refuelSheet.open}}" bindtap="onCloseRefuel"></view>
  <view class="vh-sheet" wx:if="{{refuelSheet.open}}">
    <view class="vh-sheet-handle"></view>
    <view class="vh-sheet-header">
      <view class="vh-sheet-title">途中补给</view>
      <view class="vh-sheet-close" catchtap="onCloseRefuel">
        <view class="ico ico-close"></view>
      </view>
    </view>
    <scroll-view class="vh-sheet-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="vh-supply-type">
        <text class="vh-supply-type-text">当前车辆：{{activeUse.vehicle_label}} · {{refuelSheet.label}}量（{{refuelSheet.unit}}）</text>
      </view>
      <view class="vh-form-group">
        <text class="vh-form-label vh-form-label--required">{{refuelSheet.label}}量（{{refuelSheet.unit}}）</text>
        <input class="vh-form-input" type="digit" data-field="quantity" value="{{refuelSheet.quantity}}" bindinput="onRefuelField" placeholder="请输入补给数量"/>
      </view>
      <view class="vh-form-group">
        <text class="vh-form-label vh-form-label--required">金额（元）</text>
        <input class="vh-form-input" type="digit" data-field="amount" value="{{refuelSheet.amount}}" bindinput="onRefuelField" placeholder="请输入金额"/>
      </view>
      <view class="vh-form-group">
        <text class="vh-form-label vh-form-label--required">当前里程（km）</text>
        <input class="vh-form-input" type="digit" data-field="mileage" value="{{refuelSheet.mileage}}" bindinput="onRefuelField" placeholder="请输入当前里程"/>
      </view>
      <view class="vh-form-group">
        <text class="vh-form-label">备注（可选）</text>
        <textarea class="vh-form-textarea" data-field="remark" value="{{refuelSheet.remark}}" bindinput="onRefuelField"/>
      </view>
      <view class="vh-sheet-spacer"></view>
    </scroll-view>
    <view class="vh-sheet-bottom-bar">
      <button class="btn-primary btn-lg" loading="{{refuelSheet.submitting}}" disabled="{{refuelSheet.submitting}}" bindtap="onSubmitRefuel">保存补给记录</button>
    </view>
  </view>

  <!-- ===== Sheet：故障上报 ===== -->
  <view class="vh-sheet-mask" wx:if="{{faultSheet.open}}" bindtap="onCloseFault"></view>
  <view class="vh-sheet" wx:if="{{faultSheet.open}}">
    <view class="vh-sheet-handle"></view>
    <view class="vh-sheet-header">
      <view class="vh-sheet-title">车辆故障上报</view>
      <view class="vh-sheet-close" catchtap="onCloseFault">
        <view class="ico ico-close"></view>
      </view>
    </view>
    <scroll-view class="vh-sheet-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="vh-form-group">
        <text class="vh-form-label vh-form-label--required">故障类型</text>
        <input class="vh-form-input" data-field="faultType" value="{{faultSheet.faultType}}" bindinput="onFaultField" placeholder="如发动机异响、刹车失灵等"/>
      </view>
      <view class="vh-form-group">
        <text class="vh-form-label vh-form-label--required">故障时里程（km）</text>
        <input class="vh-form-input" type="digit" data-field="mileage" value="{{faultSheet.mileage}}" bindinput="onFaultField" placeholder="请输入故障时里程"/>
      </view>
      <view class="vh-form-group">
        <text class="vh-form-label vh-form-label--required">是否影响安全行驶</text>
        <view class="vh-seg">
          <view class="vh-seg-item {{faultSheet.affectsSafeOperation === false ? 'vh-seg-active' : ''}}" data-index="0" catchtap="onFaultSafetyPick">不影响</view>
          <view class="vh-seg-item vh-seg-item--danger {{faultSheet.affectsSafeOperation === true ? 'vh-seg-active' : ''}}" data-index="1" catchtap="onFaultSafetyPick">影响安全行驶</view>
        </view>
        <view class="vh-alert vh-alert--error vh-fault-safety-warn" wx:if="{{faultSheet.affectsSafeOperation === true}}">
          <text class="vh-alert-text">上报后车辆将被限制使用，需维修闭环后解除</text>
        </view>
      </view>
      <view class="vh-form-group">
        <text class="vh-form-label vh-form-label--required">故障现象</text>
        <textarea class="vh-form-textarea" data-field="description" value="{{faultSheet.description}}" bindinput="onFaultField" placeholder="描述故障现象"/>
      </view>
      <view class="vh-form-group">
        <text class="vh-form-label">补充说明（可选）</text>
        <textarea class="vh-form-textarea" data-field="remark" value="{{faultSheet.remark}}" bindinput="onFaultField"/>
      </view>
      <view class="vh-sheet-spacer"></view>
    </scroll-view>
    <view class="vh-sheet-bottom-bar">
      <button class="{{faultSheet.affectsSafeOperation ? 'btn-danger' : 'btn-primary'}} btn-lg" loading="{{faultSheet.submitting}}" disabled="{{faultSheet.submitting || faultSheet.affectsSafeOperation === null}}" bindtap="onSubmitFault">{{faultSheet.affectsSafeOperation === null ? '请选择是否影响安全行驶' : (faultSheet.affectsSafeOperation ? '上报并限制使用' : '提交故障上报')}}</button>
    </view>
  </view>

  <!-- ===== Sheet：申请用车 ===== -->
  <view class="vh-sheet-mask" wx:if="{{applySheet.open}}" bindtap="onCloseApply"></view>
  <view class="vh-sheet" wx:if="{{applySheet.open}}">
    <view class="vh-sheet-handle"></view>
    <view class="vh-sheet-header">
      <view class="vh-sheet-title">申请用车</view>
      <view class="vh-sheet-close" catchtap="onCloseApply">
        <view class="ico ico-close"></view>
      </view>
    </view>
    <scroll-view class="vh-sheet-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="vh-form-group">
        <text class="vh-form-label">选择车辆</text>
        <picker mode="selector" range="{{vehicles}}" range-key="plate_no" value="{{applySheet.vehicleIndex}}" bindchange="onApplyPick">
          <view class="vh-picker-row">{{vehicles[applySheet.vehicleIndex].plate_no}}<text wx:if="{{vehicles[applySheet.vehicleIndex].model}}">（车型：{{vehicles[applySheet.vehicleIndex].model}}）</text> ›</view>
        </picker>
      </view>
      <!-- 起止时间：两个复合项，每项日期+时间并排 -->
      <view class="vh-form-group">
        <text class="vh-form-label">开始时间</text>
        <view class="vh-datetime-row">
          <picker mode="date" value="{{applySheet.startDate}}" bindchange="onApplyField" data-field="startDate">
            <view class="vh-picker-row vh-picker-row--date">{{applySheet.startDate}} ›</view>
          </picker>
          <picker mode="time" value="{{applySheet.startTime}}" bindchange="onApplyField" data-field="startTime">
            <view class="vh-picker-row vh-picker-row--time">{{applySheet.startTime}} ›</view>
          </picker>
        </view>
      </view>
      <view class="vh-form-group">
        <text class="vh-form-label">结束时间</text>
        <view class="vh-datetime-row">
          <picker mode="date" value="{{applySheet.endDate}}" bindchange="onApplyField" data-field="endDate">
            <view class="vh-picker-row vh-picker-row--date">{{applySheet.endDate}} ›</view>
          </picker>
          <picker mode="time" value="{{applySheet.endTime}}" bindchange="onApplyField" data-field="endTime">
            <view class="vh-picker-row vh-picker-row--time">{{applySheet.endTime}} ›</view>
          </picker>
        </view>
      </view>

      <!-- 目的地：segmented 切换 + 条件内容 -->
      <view class="vh-form-group">
        <text class="vh-form-label vh-form-label--required">目的地</text>
        <view class="vh-seg">
          <view class="vh-seg-item {{applySheet.destinationModeIndex === 0 ? 'vh-seg-active' : ''}}" data-index="0" catchtap="onApplyDestinationMode">授权站点</view>
          <view class="vh-seg-item {{applySheet.destinationModeIndex === 1 ? 'vh-seg-active' : ''}}" data-index="1" catchtap="onApplyDestinationMode">其他地点</view>
        </view>
      </view>
      <view class="vh-form-group" wx:if="{{applySheet.destinationMode === 'site'}}">
        <text class="vh-form-label vh-form-label--required">授权站点</text>
        <picker mode="selector" range="{{sites}}" range-key="name" value="{{applySheet.siteIndex}}" bindchange="onApplySitePick">
          <view class="vh-picker-row">{{sites[applySheet.siteIndex].name || '请选择授权站点'}} ›</view>
        </picker>
      </view>
      <view class="vh-form-group" wx:else>
        <text class="vh-form-label vh-form-label--required">其他地点</text>
        <input class="vh-form-input" data-field="otherDestination" value="{{applySheet.otherDestination}}" bindinput="onApplyField" maxlength="100" placeholder="填写仓库、维修点等具体地点"/>
      </view>
      <view class="vh-form-group">
        <text class="vh-form-label">用车事由</text>
        <textarea class="vh-form-textarea" data-field="reason" value="{{applySheet.reason}}" bindinput="onApplyField" placeholder="说明本次外出任务"/>
      </view>
      <view class="vh-sheet-spacer"></view>
    </scroll-view>
    <view class="vh-sheet-bottom-bar">
      <button class="btn-primary btn-lg" loading="{{applySheet.submitting}}" disabled="{{applySheet.submitting}}" bindtap="onSubmitApply">提交审批</button>
    </view>
  </view>
</view>
