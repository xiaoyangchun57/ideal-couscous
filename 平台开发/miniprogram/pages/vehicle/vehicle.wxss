/* ============================================================
   车辆管理页（vehicle）
   ============================================================ */

.vh-page {
  min-height: 100vh;
  background: var(--color-background);
  padding-bottom: 40rpx;
}

/* ===== 提示条 ===== */
.vh-alert {
  margin: 24rpx 32rpx 0;
  padding: 20rpx 24rpx;
  background: var(--color-error-surface);
  border-radius: var(--radius-md);
}

.vh-alert-text {
  font-size: 24rpx;
  color: var(--color-error);
  line-height: 1.6;
}

/* 刷新失败：warning 级（内容仍可读，非阻断） */
.vh-alert--warn {
  background: var(--color-warning-surface);
}

.vh-alert--warn .vh-alert-text {
  color: var(--color-warning);
}

/* ===== 当前行程卡 ===== */
.vh-hero {
  margin: 24rpx 32rpx;
  padding: 36rpx 32rpx 28rpx;
  background: var(--color-card);
  border-radius: var(--radius-xl);
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.vh-hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.vh-hero-kicker {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
}

.vh-status-pill {
  padding: 6rpx 16rpx;
  border-radius: 100rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.vh-status-pill--active {
  background: var(--color-info-surface);
  color: var(--color-info);
}

.vh-hero-plate {
  display: block;
  font-size: 44rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.2;
  margin-bottom: 8rpx;
}

.vh-hero-meta {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

/* 主动作按钮 */
.vh-hero-primary {
  margin-top: 28rpx;
}

.vh-btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  background: var(--color-primary);
  color: var(--color-primary-foreground);
  border-radius: var(--radius-lg);
  font-size: 30rpx;
  font-weight: 500;
}

.vh-btn-full {
  margin-top: 24rpx;
}

/* 快捷操作 */
.vh-quick-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 0.5rpx solid var(--color-divider);
}

.vh-quick-action {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 120rpx;
  background: var(--color-background);
  border-radius: var(--radius-md);
  gap: 8rpx;
}

.vh-quick-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* --- 图标：内联 SVG，设计系统风格（2px stroke, round caps, 24x24 viewport）--- */

.ico {
  width: 100%;
  height: 100%;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}

.ico-fuel {
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M3 22V7a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v15' stroke='%23007aff' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/%3E%3Cpath d='M3 22h12' stroke='%23007aff' stroke-width='2' stroke-linecap='round'/%3E%3Cpath d='M15 10h3a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-1' stroke='%23007aff' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/%3E%3Cpath d='M6 11h6' stroke='%23007aff' stroke-width='2' stroke-linecap='round'/%3E%3C/svg%3E");
}

.ico-warning {
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z' stroke='%23ff9500' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/%3E%3Cline x1='12' y1='9' x2='12' y2='13' stroke='%23ff9500' stroke-width='2' stroke-linecap='round'/%3E%3Ccircle cx='12' cy='17' r='1' fill='%23ff9500'/%3E%3C/svg%3E");
}

.ico-close {
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M18 6 6 18M6 6l12 12' stroke='%238e8e93' stroke-width='2' stroke-linecap='round'/%3E%3C/svg%3E");
}

/* 旧的 warning 图标子元素结构（兼容 WXML） */
.ico-warning-bar,
.ico-warning-dot {
  display: none;
}

.vh-quick-label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
}

/* ===== 占用卡 / 空态卡 ===== */
.vh-card {
  margin: 24rpx 32rpx;
  padding: 32rpx;
  background: var(--color-card);
  border-radius: var(--radius-xl);
}

.vh-card--occupied {
  background: var(--color-card);
}

.vh-occupied-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--color-warning);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.vh-occupied-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 8rpx;
}

.vh-occupied-copy {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.vh-card--empty {
  text-align: center;
  padding: 48rpx 32rpx;
}

.vh-empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 8rpx;
}

.vh-empty-copy {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  line-height: 1.5;
}

/* ===== 分组 ===== */
.vh-section {
  margin-top: 12rpx;
  padding: 0 32rpx;
}

.vh-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0 16rpx;
}

.vh-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.vh-section-more {
  font-size: 26rpx;
  color: var(--color-primary);
  font-weight: 500;
}

.vh-section-count {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

/* ===== 列表 ===== */
.vh-list {
  background: var(--color-card);
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.vh-list-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border-bottom: 0.5rpx solid var(--color-divider);
  gap: 20rpx;
}

.vh-list-item:last-child {
  border-bottom: none;
}

.vh-list-item--history {
  opacity: 1;
}

.vh-list-item--history .vh-list-title {
  color: var(--color-text-secondary);
  font-weight: 400;
}

.vh-list-item--history .vh-chip--success {
  background: var(--color-type-bg);
  color: var(--color-text-tertiary);
}

.vh-list-main {
  flex: 1;
  min-width: 0;
}

.vh-list-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 6rpx;
}

.vh-list-sub {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-top: 4rpx;
}

.vh-list-reject {
  display: block;
  font-size: 22rpx;
  color: var(--color-error);
  margin-top: 8rpx;
  line-height: 1.4;
}

.vh-list-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
  flex-shrink: 0;
}

/* 状态标签 */
.vh-chip {
  padding: 4rpx 14rpx;
  border-radius: var(--radius-xs);
  font-size: 22rpx;
  font-weight: 500;
  white-space: nowrap;
}

.vh-chip-pending { background: var(--color-warning-surface); color: var(--color-warning); }
.vh-chip-approved { background: var(--color-info-surface); color: var(--color-info); }
.vh-chip-rejected { background: var(--color-error-surface); color: var(--color-error); }
.vh-chip-cancelled { background: var(--color-muted); color: var(--color-text-tertiary); }
.vh-chip-expired { background: var(--color-muted); color: var(--color-text-tertiary); }
.vh-chip--success { background: var(--color-success-surface); color: var(--color-success); }

/* 小按钮 */
.vh-btn-sm {
  min-height: 88rpx;
  line-height: 88rpx;
  padding: 0 28rpx;
  border-radius: var(--radius-sm);
  font-size: 26rpx;
  font-weight: 500;
  margin: 0;
}

.vh-btn-sm::after {
  border: none;
}

.vh-btn-sm-primary {
  background: var(--color-primary);
  color: var(--color-primary-foreground);
}

/* 列表空态 */
.vh-empty-list {
  padding: 48rpx 0;
  text-align: center;
  background: var(--color-card);
  border-radius: var(--radius-lg);
}

.vh-empty-tx {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
}

/* 列表底部 */
.vh-list-foot {
  text-align: center;
  padding: 24rpx 0;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

/* ============================================================
   Sheet 弹层（车辆页）
   ============================================================ */

/* ============================================================
   Sheet 弹层（车辆页专属命名空间）
   - 彻底脱离全局 .sheet 样式污染
   - height: auto + max-height: 85vh，短内容收束，长内容单滚动
   - 安全区只在 bottom-bar 加一次
   ============================================================ */

.vh-sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
}

.vh-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 101;
  background: var(--color-card);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  height: 85vh;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

/* 无真实拖拽能力，隐藏装饰把手 */
.vh-sheet-handle {
  display: none;
}

/* Sheet 头部 */
.vh-sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 40rpx 16rpx;
  flex-shrink: 0;
}

.vh-sheet-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.vh-sheet-close {
  min-width: 88rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: -20rpx;
}

/* 正文滚动区：flex 分配确定高度，scroll-view 单纵向滚动 */
.vh-sheet-scroll {
  flex: 1 1 0;
  height: 0;
  min-height: 0;
  overflow: hidden;
  width: 100%;
}

.vh-sheet-spacer {
  height: 40rpx;
}

/* 底部操作栏：安全区只加一次 */
.vh-sheet-bottom-bar {
  padding: 16rpx 40rpx 20rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-divider);
  background: var(--color-card);
  flex-shrink: 0;
}

/* Sheet 内按钮 */
.vh-sheet-bottom-bar .btn-lg {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: var(--radius-lg);
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  margin: 0;
}

.vh-sheet-bottom-bar .btn-lg::after {
  border: none;
}

.vh-sheet-bottom-bar .btn-primary {
  background: var(--color-primary);
  color: var(--color-primary-foreground);
}

.vh-sheet-bottom-bar .btn-primary[disabled] {
  opacity: 0.4;
}

.vh-sheet-bottom-bar .btn-danger {
  background: var(--color-error);
  color: #fff;
}

.vh-sheet-bottom-bar .btn-danger[disabled] {
  opacity: 0.4;
}

/* Sheet 提示文字 */
.vh-sheet-hint {
  display: block;
  padding: 0 40rpx 20rpx;
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  line-height: 1.6;
}

/* ===== 检查项列表 ===== */
.vh-check-list {
  padding: 0 40rpx;
}

.vh-check-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 24rpx 0;
  border-bottom: 0.5rpx solid var(--color-divider);
}

.vh-check-label {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--color-text-primary);
  font-weight: 500;
}

.vh-check-options {
  display: flex;
  flex-shrink: 0;
  gap: 10rpx;
}

.vh-check-opt {
  min-width: 88rpx;
  min-height: 88rpx;
  padding: 0 16rpx;
  border: 1.5rpx solid var(--color-divider);
  border-radius: var(--radius-sm);
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  font-weight: 500;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s ease;
  box-sizing: border-box;
}

.vh-check-opt--ok {
  color: var(--color-success);
  border-color: var(--color-success);
  background: var(--color-success-surface);
  font-weight: 600;
  border-width: 2rpx;
}

.vh-check-opt--warn {
  color: var(--color-warning);
  border-color: var(--color-warning);
  background: var(--color-warning-surface);
  font-weight: 600;
  border-width: 2rpx;
}

.vh-check-opt--error {
  color: var(--color-error);
  border-color: var(--color-error);
  background: var(--color-error-surface);
  font-weight: 600;
  border-width: 2rpx;
}

/* ===== 表单 ===== */
.vh-form-group {
  padding: 16rpx 40rpx;
}

.vh-form-label {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}

.vh-form-label--required::before {
  content: '*';
  color: var(--color-error);
  margin-right: 6rpx;
  font-weight: 500;
}

.vh-form-input {
  width: 100%;
  min-height: 88rpx;
  padding: 0 24rpx;
  background: var(--color-background);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  color: var(--color-text-primary);
  box-sizing: border-box;
}

.vh-form-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx 24rpx;
  background: var(--color-background);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  color: var(--color-text-primary);
  line-height: 1.6;
  box-sizing: border-box;
}

.vh-picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  padding: 0 24rpx;
  background: var(--color-background);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  color: var(--color-text-primary);
}

/* 时间选择两列 */
.vh-time-row {
  display: flex;
  gap: 20rpx;
  padding: 0 40rpx;
}

.vh-time-col {
  flex: 1;
  min-width: 0;
}

.vh-time-col .vh-form-label {
  margin-bottom: 12rpx;
}

.vh-time-col .vh-picker-row {
  width: 100%;
  box-sizing: border-box;
}

/* ===== 起止时间复合行 ===== */
.vh-datetime-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.vh-datetime-row picker {
  flex: 1;
  min-width: 0;
}

.vh-datetime-row picker:first-child {
  flex: 1.6;
}

.vh-picker-row--date,
.vh-picker-row--time {
  width: 100%;
  box-sizing: border-box;
}

/* ===== segmented 二选一 ===== */
.vh-seg {
  display: flex;
  background: var(--color-background);
  border-radius: var(--radius-md);
  padding: 6rpx;
  margin-bottom: 20rpx;
  gap: 6rpx;
}

.vh-seg-item {
  flex: 1;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
  border-radius: calc(var(--radius-md) - 4rpx);
  transition: all 0.15s ease;
  padding: 0 12rpx;
  text-align: center;
  box-sizing: border-box;
}

.vh-seg-active {
  background: var(--color-card);
  color: var(--color-text-primary);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

/* 安全影响：危险选项选中态 */
.vh-seg-item--danger.vh-seg-active {
  background: var(--color-error-surface);
  color: var(--color-error);
  font-weight: 600;
  box-shadow: none;
}

/* ===== 补给类型提示（纯文本，无卡片） ===== */
.vh-supply-type {
  margin: 0 32rpx 16rpx;
}

.vh-supply-type-text {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  line-height: 1.5;
}

/* ===== 故障安全影响警告 ===== */
.vh-fault-safety-warn {
  margin-top: 16rpx;
  margin-left: 0;
  margin-right: 0;
}
